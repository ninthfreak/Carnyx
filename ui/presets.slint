// Preset tiles, the preset band, and the prev/next peek cards (ANDROID
// §4.3/§4.5/§5).
//
// A tile shows EITHER a real logo on a borderless transparent plate, OR a wide
// colored box with the 4 core call letters inside it and the frequency beneath.
// Both use the same landscape plate, so a logo tile and a no-logo tile occupy
// identical space. The peek cards use the exact same treatment as the tiles.

import { Pal, Metrics, Font } from "tokens.slint";
import { Preset } from "types.slint";
import { MagnifierTower, LogoSearchIcon } from "icons.slint";

// The colored call-letter box that stands in for a logo. The letters are fitted
// to the landscape box — bounded by its height AND by width/letter-count, so four
// letters don't overflow a narrow box.
component CallSignBox inherits Rectangle {
    in property <string> label;
    in property <color> brand;
    in property <length> radius: 12px;

    border-radius: root.radius;
    clip: true;
    background: Pal.flat(root.brand);

    Text {
        text: root.label == "" ? "·" : root.label;
        color: #FFFFFF;
        font-family: Font.face;
        font-weight: Font.bold;
        letter-spacing: 0.5px;
        font-size: Math.max(11px, Math.round(Math.min(
            root.height / 1px * 0.52,
            (root.width / 1px * 0.82) / Math.max(root.label.character-count, 1) * 1.55)) * 1px);
    }
}

// The plate itself — a real logo, or the colored call-letter box. Separated from
// the size so the two geometry modes below can share it without either one
// binding its own height (which is a loop).
component PlateBox inherits Rectangle {
    in property <Preset> preset;
    in property <length> radius: 12px;

    border-radius: root.radius;
    clip: true;
    // Real logo → borderless and transparent; the image carries the identity.
    background: root.preset.has-logo ? transparent : Pal.flat(root.preset.brand);

    if root.preset.has-logo: Image {
        source: root.preset.logo;
        // Containment invariant (§4.5): fully visible, never cropped, never
        // overflowing, centred. The plate owns the geometry; the image scales to
        // the largest size that fits inside it.
        //
        // LIMIT OF THE §4.7 DEAD FACE: CarFM desaturates with a filter over the
        // rendered subtree, so a logo greys out with everything else. Here the
        // desaturation is done in the palette, which cannot reach an image — once
        // real logo assets exist, a released-audio face will show them in full
        // colour. Fix it by desaturating the asset at load and keeping both
        // variants, not by reaching for a filter Slint does not have.
        image-fit: contain;
        width: parent.width;
        height: parent.height;
    }
    if !root.preset.has-logo: CallSignBox {
        width: parent.width;
        height: parent.height;
        label: root.preset.call;
        brand: root.preset.brand;
        radius: root.radius;
    }
}

/// The identity block shared by peek cards and preset tiles: a real logo when one
/// exists, otherwise the colored call-sign box, with ONE text row beneath — the
/// call sign for a logo, the frequency for the box.
export component PresetPlate inherits VerticalLayout {
    in property <Preset> preset;
    in property <length> plate-w;
    in property <length> plate-h;
    in property <length> radius: 12px;
    in property <length> freq-size: 16px;
    /// `fill` mode (preset chips): the plate is the chip's flex-grow child and
    /// takes all the height left after padding, gap and the text row. Never a
    /// fixed dp height — the size falls out of the chip's own layout, which is
    /// what makes the tuned chip's bigger box follow automatically.
    in property <bool> fill: false;

    spacing: root.fill ? 4px : Math.max(3px, Math.round(root.freq-size / 1px * 0.34) * 1px);
    alignment: root.fill ? LayoutAlignment.stretch : LayoutAlignment.center;

    if root.fill: PlateBox {
        vertical-stretch: 1;
        preset: root.preset;
        radius: root.radius;
    }
    if !root.fill: PlateBox {
        width: root.plate-w;
        height: root.plate-h;
        vertical-stretch: 0;
        preset: root.preset;
        radius: root.radius;
    }

    Text {
        text: root.preset.has-logo ? root.preset.call : root.preset.freq-label;
        horizontal-alignment: center;
        color: Pal.text;
        font-family: Font.face;
        font-weight: Font.bold;
        font-size: root.freq-size;
        letter-spacing: 0.3px;
    }
}

/// One preset chip in the band.
export component PresetTile inherits Rectangle {
    in property <Preset> preset;
    in property <bool> active: false;
    in property <length> pad-top;
    in property <length> pad-bottom;
    in property <length> pad-h;
    in property <length> logo-radius;
    in property <length> name-font;
    in property <bool> reordering: false;
    /// Laid out but not painted. The tile being dragged is drawn a SECOND time
    /// by the band, above everything, because Slint has no z-order — elements
    /// paint in declaration order and a repeated tile cannot lift itself over
    /// its own siblings. The original stays where it is, because it is what the
    /// gap opens around; it just does not show.
    in property <bool> hidden: false;

    callback selected();
    /// The reorder-mode badge — §6.4's entry point. A callback of its own, not
    /// `selected()`, because it opens the logo window instead of tuning.
    callback logo-badge();
    /// The gesture, in TILE-LOCAL coordinates.
    ///
    /// The tile owns neither the hold timer nor the drag state: a `Timer` inside
    /// a repeated element is a shape nothing in this tree has compiled, and
    /// `nearby.slint` already keeps one at its list root for the same reason. A
    /// gesture belongs to the band, not to the tile it landed on, and there is
    /// only ever one finger. The band adds this tile's own slot offset to turn
    /// these into viewport coordinates.
    ///
    /// `ended` and `cancelled` are SEPARATE, and that is not tidiness. A release
    /// commits the reorder; a cancel is the system taking the gesture away —
    /// a phone call, a parent view claiming the pointer — and must put the list
    /// back exactly as it was. Routing both through one callback committed
    /// whatever the finger happened to be over when the window went away.
    callback press-began(length, length);
    callback press-moved(length, length);
    callback press-ended();
    callback press-cancelled();

    border-radius: 16px;
    background: Pal.panel;
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Pal.blue : Pal.border;
    opacity: root.hidden ? 0 : (touch.pressed && !root.reordering ? 0.6 : 1.0);

    touch := TouchArea {
        // `clicked`, not a pointer-up: once pressed, a TouchArea grabs the
        // pointer and still gets the up event after the finger has slid off the
        // tile. `clicked` fires only when the release lands inside — and it
        // fires BEFORE pointer-event(up), which is why the strip resets its
        // hold flag on DOWN rather than on the way out.
        //
        // That same grab is what makes a drag possible at all: the finger leaves
        // this tile almost immediately and every `moved` still arrives here,
        // which is what CarFM gets by capturing its PanResponder at the start of
        // the gesture.
        clicked => { root.selected(); }
        moved => { root.press-moved(self.mouse-x, self.mouse-y); }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.press-began(self.mouse-x, self.mouse-y);
            } else if (ev.kind == PointerEventKind.up) {
                root.press-ended();
            } else if (ev.kind == PointerEventKind.cancel) {
                root.press-cancelled();
            }
        }
    }

    VerticalLayout {
        padding-top: root.pad-top;
        padding-bottom: root.pad-bottom;
        padding-left: root.pad-h;
        padding-right: root.pad-h;
        PresetPlate {
            preset: root.preset;
            fill: true;
            radius: root.logo-radius;
            freq-size: root.name-font;
        }
    }

    // The tuned tile's amber-blue underline.
    if root.active: Rectangle {
        y: root.height - 6px - 3px;
        width: 26px; height: 3px;
        border-radius: 2px;
        background: Pal.blue;
    }

    // Reorder mode only: the logo-search badge (PresetsBand.tsx:145-155,
    // `styles.logoEdit`:624 — 42dp disc, top 8 / left 8, a 2dp Pal.panel ring,
    // a 26dp white glyph). The ✕ remove badge that used to sit beside it was
    // dropped in the reference; a preset is removed from the hero ★ instead.
    //
    // Declared LAST so it is above the tile's own TouchArea and takes the tap.
    if root.reordering: Rectangle {
        x: 8px;
        y: 8px;
        width: 42px;
        height: 42px;
        border-radius: 21px;
        border-width: 2px;
        border-color: Pal.panel;
        background: Pal.blue;
        opacity: badge.pressed ? 0.6 : 1.0;

        badge := TouchArea { clicked => { root.logo-badge(); } }

        LogoSearchIcon { size: 26px; }
    }
}

/// Prev/next peek card. Same treatment as a bottom preset tile, at ~0.88 scale
/// and 60% opacity, with its inner edge softened so it reads as tucked behind
/// the hero.
///
/// CarFM applies the 0.88 with a transform; here every dimension is simply
/// authored at 0.88, which lands in the same place and keeps the type crisp
/// instead of resampling a scaled layer.
export component PeekCard inherits Rectangle {
    in property <Preset> preset;
    /// Unscaled card width — the 20%-of-surface figure from LOGO-SIZING §4.
    in property <length> card-w;
    in property <string> side: "left";

    callback selected();

    /// A GHOST during the hero morph: drawn, but it must not eat the tap that
    /// the real card underneath it is there to receive.
    in property <bool> inert: false;

    /// The card's uniform scale, and the reason the hero morph can shrink one of
    /// these at all.
    ///
    /// Slint 1.17 exposes no scale transform to user code — `Transform` is
    /// compiled but carries `//-is_internal` (i-slint-compiler-1.17.1
    /// builtins.slint:500-507) — so a peek is scaled by ARITHMETIC instead: every
    /// dimension below multiplies through this one number, including the border,
    /// the corner radius, the padding, the plate and the frequency type. That is
    /// what makes it animatable as a unit, where animating a width would re-lay
    /// the card out each frame and read as jitter.
    ///
    /// 0.88 at rest, matching CarFM's `scale(0.88)` on the peek slots. The morph
    /// starts it at `card-w(hero) / card-w(peek)` and lets it settle back here.
    in property <float> scale: 0.88;
    // Peek plate geometry: 92% of the card, capped at 184, aspect-locked 16/10 —
    // the SAME landscape box as a real logo and as the call-sign form.
    property <length> plate-w: Math.min(Math.round(root.card-w / 1px * 0.92) * 1px, Metrics.s(184));
    property <length> plate-h: Math.round(root.plate-w / 1px * 10 / 16) * 1px;
    // A flat 16dp card padding and the 92% box are geometrically incompatible on
    // the narrow tracks, so the inset is derived from the plate instead — floor,
    // not round, or a 184dp plate clips by 1dp against 183dp of content.
    property <length> pad: Math.max(Metrics.s(4), Math.floor((root.card-w - root.plate-w) / 2 / 1px) * 1px);
    property <length> inner-gap: Math.min(Metrics.s(12), Math.round(root.plate-h / 1px * 0.16) * 1px);

    width: root.card-w * root.scale;
    height: root.card-w * root.scale;
    /// The card's weight at rest. 0.6 is §8's peek opacity; the hero row lowers
    /// it to 0.28 on a dead face and drives it during the morph.
    ///
    /// SEPARATE FROM `opacity` ON PURPOSE. This used to be
    /// `opacity: touch.pressed ? 0.35 : 0.6`, and every call site binds `opacity`
    /// from outside — so Slint's inlining kept the outer expression and threw
    /// this one away, leaving a peek card that gave no acknowledgement at all
    /// when pressed while every other control in the file dims. Splitting the
    /// two lets the row set the weight and the card keep its own press feedback.
    in property <float> weight: 0.6;
    opacity: touch.pressed && !root.inert ? root.weight * 0.58 : root.weight;
    // CarFM scales the whole card with a transform, so its 1dp border comes out at
    // 0.88 too. Authoring the size directly means the border has to be scaled by
    // hand or the peek reads a touch heavier than the real one.
    border-width: 1px * root.scale;
    border-color: Pal.border;
    border-radius: Metrics.s(24) * root.scale;
    background: Pal.panel;

    /// How much of this card's INNER edge is covered by something drawn on top,
    /// and therefore must not be tappable.
    ///
    /// THE HERO CARD SITS OVER THIS ONE AND DOES NOT STOP THE TAP. Both peeks are
    /// tucked under the hero by `Metrics.peek-overlap`, `HeroCard` has no
    /// card-wide `TouchArea`, and adding one does NOT help — measured rather than
    /// assumed: with a full-size `TouchArea` on the hero, `examples/tapprobe.rs`
    /// reported the defect completely unchanged, while making these two peeks
    /// `inert` cleared it at once. The peek wins the hit test over a plain
    /// sibling declared after it, so this is the only place it can be fixed.
    ///
    /// Left at 0 for every other use: the strip's own tiles have nothing over
    /// them and want their whole face live.
    in property <length> blocked: 0px;

    touch := TouchArea {
        // Anchored away from the hero: the LEFT peek is covered on its right,
        // the RIGHT peek on its left.
        x: root.side == "left" ? 0px : root.blocked;
        y: 0px;
        width: Math.max(0px, root.width - root.blocked);
        height: root.height;
        enabled: !root.inert;
        clicked => { root.selected(); }
    }

    VerticalLayout {
        padding: root.pad * root.scale;
        alignment: center;
        PresetPlate {
            preset: root.preset;
            plate-w: root.plate-w * root.scale;
            plate-h: root.plate-h * root.scale;
            radius: Metrics.s(12) * root.scale;
            freq-size: Math.max(13px, Metrics.s(16)) * root.scale;
        }
    }

    // Inner-edge fade: PREV fades on its RIGHT edge, NEXT on its LEFT, so the
    // card dissolves into the page where the hero overlaps it.
    Rectangle {
        background: root.side == "left"
            ? @linear-gradient(90deg, transparent 50%, Pal.bg.with-alpha(0.92) 100%)
            : @linear-gradient(270deg, transparent 50%, Pal.bg.with-alpha(0.92) 100%);
        border-radius: parent.border-radius;
    }
}

// Dashed placeholder for the empty band. Slint has no dashed border, so the
// dashes are drawn as a run of small rectangles along each edge.
component DashedBox inherits Rectangle {
    property <length> dash: 9px;
    property <length> step: 15px;
    property <int> h-count: Math.max(1, Math.floor(root.width / root.step));
    property <int> v-count: Math.max(1, Math.floor(root.height / root.step));
    property <length> h-step: root.width / root.h-count;
    property <length> v-step: root.height / root.v-count;

    for i in root.h-count: Rectangle {
        x: i * root.h-step; y: 0; width: root.dash; height: 1.5px; background: Pal.border;
    }
    for i in root.h-count: Rectangle {
        x: i * root.h-step; y: root.height - 1.5px; width: root.dash; height: 1.5px; background: Pal.border;
    }
    for i in root.v-count: Rectangle {
        x: 0; y: i * root.v-step; width: 1.5px; height: root.dash; background: Pal.border;
    }
    for i in root.v-count: Rectangle {
        x: root.width - 1.5px; y: i * root.v-step; width: 1.5px; height: root.dash; background: Pal.border;
    }
}

// The band's ‹ / › page buttons and the NEARBY disc, wide tracks only.
component NavButton inherits Rectangle {
    in property <string> glyph;
    callback clicked();
    width: Math.max(48px, Metrics.s(56));
    border-radius: 14px;
    border-width: 1px;
    border-color: Pal.border;
    background: Pal.raised;
    opacity: touch.pressed ? 0.55 : 1.0;
    touch := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.glyph;
        font-family: Font.face;
        font-weight: 700;
        font-size: Metrics.s(30);
        color: Pal.text;
    }
}

export component PresetsBand inherits Rectangle {
    in property <[Preset]> presets;
    in property <int> active-index: -1;
    in property <bool> reordering: false;
    in property <length> band-height;
    /// Nav buttons and the in-band nearby disc are hidden on the tall track,
    /// where nearby lives in the status bar instead.
    in property <bool> show-nav: true;
    in property <bool> show-nearby: true;

    callback select(int);
    callback open-nearby();
    callback done-reordering();
    /// The reorder-mode logo badge on tile `i` (§6.4).
    callback open-logo-search(int);
    /// Long-press on any tile. THE ONLY DOOR to reorder mode, and through it the
    /// only door to the logo window — the badge that opens §6.4 is drawn by
    /// `PresetTile` under `if root.reordering`, so without this the whole logo
    /// pipeline is unreachable on the device no matter how much of it works.
    callback enter-reordering();
    /// A drag let go: move the preset at the first index to the second. Rust owns
    /// the list; this only ever reports where the finger landed.
    callback reorder(int, int);
    /// One line into the diagnostics log, for a gesture that cannot be watched.
    ///
    /// THE DRAG WORKS HEADLESSLY AND NOT IN THE CAR, and the difference is not
    /// visible from here. The screenshot harness dispatches MOUSE events; the
    /// head unit delivers touch, and a `Flickable` treats the two differently —
    /// it withholds a press from its children for 100ms and CAPTURES the gesture
    /// outright once the pointer has moved 8 logical px in an axis it can
    /// scroll. This strip scrolls horizontally with six presets, so a finger
    /// that drifts sideways during the 550ms hold is exactly the case the
    /// harness cannot produce.
    ///
    /// So the gesture reports itself. Settings → DIAGNOSTICS shows where it
    /// stops, which beats another round of guessing at it from here.
    callback drag-note(string);

    height: root.band-height;

    // ── Long press ──
    //
    // 550ms, matching `nearby.slint`'s hold and CarFM's own HOLD_MS
    // (PresetsBand.tsx:43). ONE timer for the whole band, at the root, for the
    // reason spelt out on `PresetTile::press-began`.
    //
    // The felt hold is longer than 550ms here: a press inside a Flickable is
    // withheld from the inner TouchArea for FORWARD_DELAY (100ms) before it is
    // forwarded, so the tiles answer at ~650ms. That is Slint's scroll
    // disambiguation, not a mistake, and shortening the interval to compensate
    // would break the moment that constant changes.
    property <int> hold-index: -1;
    property <bool> hold-fired: false;

    hold := Timer {
        interval: 550ms;
        running: false;
        triggered => {
            self.running = false;
            // Already reordering: a second hold has nothing to open, and firing
            // again would re-enter a mode the driver is already in.
            if (root.hold-index >= 0 && !root.reordering) {
                root.hold-fired = true;
                root.enter-reordering();
                root.drag-note(root.reordering
                    ? "hold fired, mode opened"
                    : "hold fired, mode REFUSED");
                // ARMED ONLY IF THE MODE ACTUALLY OPENED. Rust refuses reorder
                // mode while the car is moving, and it answers by simply not
                // setting `reordering` — so arming unconditionally handed the
                // driver a working drag in exactly the situation the refusal
                // exists to prevent, tiles displacing and a reorder committing
                // on a face that never entered the mode.
                //
                // THE FINGER IS STILL DOWN when this does arm. CarFM's rule is
                // that the long-press flows straight into a drag with the same
                // finger — no lift and re-press — so there is nothing else to
                // wait for.
                if (root.reordering) {
                    root.drag-index = root.hold-index;
                    root.drop-index = root.hold-index;
                }
            }
        }
    }

    // ── Drag to reorder ──
    //
    // CarFM does this with a PanResponder over `measureInWindow` rects. Here the
    // slots are pure arithmetic — the same arithmetic the three tracks already
    // used to place their tiles — so there is nothing to measure and nothing to
    // go stale when the rail scrolls.
    //
    // THE LIST IS NOT REORDERED MID-DRAG, which is CarFM's rule too. What moves
    // is where each tile is DRAWN: the held one follows the finger, and the rest
    // slide to the slots they would take if the drop happened now. Rust hears
    // about it once, on release.

    /// Which tile the finger holds, or -1. Armed by the hold, or immediately on a
    /// press once the mode is already open.
    property <int> drag-index: -1;
    /// Where it would land. Equal to `drag-index` until the finger moves.
    property <int> drop-index: -1;
    /// Past the slop — an actual drag, not a press that wobbled.
    property <bool> dragging: false;
    /// The finger let go and the held tile is sliding into its slot.
    property <bool> dropping: false;
    property <length> press-x;
    property <length> press-y;
    property <length> drag-dx;
    property <length> drag-dy;

    /// 4dp, CarFM's own threshold (`PresetsBand.tsx:98`). Below it the gesture is
    /// still a tap, which matters because a fingertip on a dashboard is never
    /// perfectly still.
    property <length> drag-slop: 4px;

    settle := Timer {
        interval: 200ms;
        running: false;
        triggered => { root.finish-drop(); }
    }

    /// Commit the move the finger decided on, and forget the gesture.
    ///
    /// COMMITTED HERE, not at the release. The 200ms is the held tile sliding
    /// into the gap the others already opened for it; committing on release
    /// instead closes that gap and swaps every tile's contents on the same
    /// frame, which reads as a flicker rather than a move. CarFM gets the same
    /// effect from a FLIP snapshot.
    ///
    /// A FUNCTION rather than the timer's body, because the timer is not the
    /// only thing that can end a drop: a second press inside the 200ms window
    /// used to overwrite `drag-index` and `drop-index` while this was still
    /// pending, so the settle then either committed nothing at all or committed
    /// a move the driver never made. Both callers below finish the old drop
    /// first.
    function finish-drop() {
        settle.running = false;
        if (root.drag-index >= 0 && root.drop-index >= 0
            && root.drag-index != root.drop-index) {
            root.reorder(root.drag-index, root.drop-index);
        }
        root.clear-drag();
    }

    function clear-drag() {
        root.dragging = false;
        root.dropping = false;
        root.drag-index = -1;
        root.drop-index = -1;
        root.drag-dx = 0px;
        root.drag-dy = 0px;
    }

    /// Reorder mode closed under the gesture — DONE was tapped, or the car
    /// pulled away and Rust shut the mode down.
    ///
    /// A drop that has already been decided still commits: the driver let go
    /// before this happened, and 200ms of settle animation is not a reason to
    /// throw their move away. A drag with the finger still on the glass is
    /// abandoned, because no decision was made. Without this the tiles stayed
    /// displaced on a face that was no longer in reorder mode.
    changed reordering => {
        if (!root.reordering) {
            if (root.dropping) {
                root.finish-drop();
            } else {
                root.hold-cancel();
            }
        }
    }

    function hold-begin(i: int, mx: length, my: length) {
        // Finish any drop still settling. It owns `drag-index`/`drop-index`, and
        // the writes below would otherwise erase the answer it is about to give.
        if (root.dropping) {
            root.finish-drop();
        }
        root.hold-index = i;
        root.hold-fired = false;
        root.press-x = mx;
        root.press-y = my;
        root.drag-dx = 0px;
        root.drag-dy = 0px;
        if (root.reordering) {
            // The mode is already open, so there is nothing to wait for: a press
            // is a potential drag from the first pixel.
            root.drag-index = i;
            root.drop-index = i;
            root.drag-note("press on " + i + ", armed (mode already open)");
        } else {
            hold.running = true;
            root.drag-note("press on " + i + ", holding");
        }
    }

    function hold-move(i: int, mx: length, my: length) {
        if (root.drag-index != i || root.dropping) {
            return;
        }
        root.drag-dx = mx - root.press-x;
        root.drag-dy = my - root.press-y;
        if (!root.dragging
            && Math.abs(root.drag-dx / 1px) <= root.drag-slop / 1px
            && Math.abs(root.drag-dy / 1px) <= root.drag-slop / 1px) {
            return;
        }
        if (!root.dragging) {
            root.drag-note("slop crossed on " + i + ", dragging");
        }
        root.dragging = true;
        // Viewport coordinates: the tile reports where the finger is inside
        // ITSELF, and only the band knows where that tile rests.
        root.drop-index = root.slot-at(root.slot-x(i) + mx, root.slot-y(i) + my);
    }

    function hold-stop() {
        root.drag-note("released: dragging=" + (root.dragging ? "yes" : "no")
            + " from=" + root.drag-index + " to=" + root.drop-index);
        hold.running = false;
        if (root.dragging && !root.dropping) {
            // Let the held tile settle before the model changes under it.
            root.dropping = true;
            settle.running = true;
            return;
        }
        root.clear-drag();
    }

    /// The system took the gesture away. Everything goes back, and NOTHING is
    /// committed — a cancel is not a decision the driver made.
    function hold-cancel() {
        // THE MOST INTERESTING LINE IN THE LOG. A cancel here means something
        // above took the gesture away, and the Flickable claiming it as a scroll
        // is the prime suspect.
        root.drag-note("CANCELLED: dragging=" + (root.dragging ? "yes" : "no")
            + " index=" + root.drag-index);
        hold.running = false;
        settle.running = false;
        root.clear-drag();
    }

    /// A tap that has to decide whether it was really a hold, or a drag.
    ///
    /// A hold that already fired CONSUMES the release, the way RN's Pressable
    /// swallows `onPress` after `onLongPress` — otherwise entering reorder mode
    /// would also retune the radio to whichever tile the driver happened to
    /// hold. A completed drag consumes it for the same reason.
    ///
    /// A plain tap in reorder mode still tunes, which is CarFM's behaviour: only
    /// a real drag suppresses the press.
    function tile-tapped(i: int) {
        hold.running = false;
        if (root.hold-fired || root.dragging) {
            root.hold-fired = false;
            return;
        }
        root.select(i);
    }

    // ── Slots ──
    //
    // Where tile `i` RESTS, in the rail's viewport coordinates. These exist so
    // the gesture can ask about a slot no tile is currently in.
    //
    // THEY ARE NOT USED BY THE TILES' OWN GEOMETRY, and that is the important
    // part. A Slint binding tracks the properties it reads DIRECTLY; properties
    // read inside a user `function` it calls are not registered as dependencies.
    // Bound as `x: root.slot-x(root.shifted(i))` the whole feature silently
    // half-worked — some tiles never re-evaluated at all. So the tiles below
    // compute their own slot inline, from direct reads, and these functions are
    // called only from callback bodies, where nothing is being tracked anyway.

    function slot-x(i: int) -> length {
        if (Metrics.tall) {
            return Math.mod(i, 3) * (root.tall-tile-w + root.grid-gap) + 4px;
        }
        if (Metrics.two-rows) {
            return Math.floor(i / 2) * (Metrics.s(150) + root.gap);
        }
        return i * (root.strip-w-off + root.gap)
            + ((root.strip-grow && i > root.active-index) ? root.strip-delta : 0px);
    }

    function slot-y(i: int) -> length {
        if (Metrics.tall) {
            return Math.floor(i / 3) * (root.tall-tile-h + root.grid-gap) + 3px;
        }
        if (Metrics.two-rows) {
            return Math.mod(i, 2) * (root.two-row-h + root.gap) + 2px;
        }
        return 2px;
    }

    function slot-w(i: int) -> length {
        if (Metrics.tall) { return root.tall-tile-w; }
        if (Metrics.two-rows) { return Metrics.s(150); }
        return (root.strip-grow && i == root.active-index)
            ? root.strip-w-on : root.strip-w-off;
    }

    function slot-h(i: int) -> length {
        if (Metrics.tall) { return root.tall-tile-h; }
        if (Metrics.two-rows) { return root.two-row-h; }
        return Math.round(rail.height / 1px
            * ((root.strip-grow && i == root.active-index) ? 1.0 : 0.8)) * 1px;
    }

    /// The slot under a point, in viewport coordinates.
    ///
    /// Closed form rather than CarFM's nearest-centre scan, because Slint
    /// expressions have no loops — and on a uniform pitch the two agree except
    /// inside the gaps, where the containing cell is the steadier answer: a
    /// finger resting on a boundary does not flicker between two slots.
    ///
    /// `strip-grow` is false whenever this is reachable (it reads `!reordering`),
    /// so the pitch really is uniform.
    function slot-at(fx: length, fy: length) -> int {
        if (root.n <= 0) { return -1; }
        if (Metrics.tall) {
            return Math.min(root.n - 1, Math.max(0,
                Math.floor(fy / (root.tall-tile-h + root.grid-gap)) * 3
                + Math.min(2, Math.max(0,
                    Math.floor(fx / (root.tall-tile-w + root.grid-gap))))));
        }
        if (Metrics.two-rows) {
            return Math.min(root.n - 1, Math.max(0,
                Math.floor(fx / (Metrics.s(150) + root.gap)) * 2
                + (fy > root.two-row-h ? 1 : 0)));
        }
        return Math.min(root.n - 1, Math.max(0,
            Math.floor(fx / (root.strip-w-off + root.gap))));
    }

    // Per-track tile geometry (CarFM's `tileSizeFor`). The active tile grows only
    // in the strip tracks; grid and two-row tiles are uniform. The plate itself
    // has no size here — it is the chip's flex-grow child, so its height falls
    // out of the chip minus padding, gap and the text row.
    property <length> gap: 10px;
    property <length> grid-gap: Metrics.s(12);
    property <int> n: root.presets.length;

    property <length> strip-w-off: Metrics.s(Metrics.landscape ? 106 : 118);
    property <length> strip-w-on: Metrics.s(Metrics.landscape ? 134 : 150);
    property <bool> strip-grow: root.active-index >= 0 && !root.reordering;
    property <length> strip-delta: root.strip-grow ? (root.strip-w-on - root.strip-w-off) : 0px;

    // Content extent, computed from the tile arithmetic rather than read back off
    // the Flickable: the rail's HEIGHT depends on this, so reading rail.width here
    // would close a layout loop.
    property <length> content-w: Metrics.two-rows
        ? Math.ceil(root.n / 2) * (Metrics.s(150) + root.gap) - root.gap
        : root.n * (root.strip-w-off + root.gap) - root.gap + root.strip-delta;
    property <bool> overflowing: root.n > 0 && root.content-w > root.width - root.side-chrome;
    // Nav buttons plus the nearby disc plus the layout's four gaps, so `overflowing`
    // can be decided before the rail has been given a width.
    property <length> side-chrome:
        (root.show-nav ? 2 * (Math.max(48px, Metrics.s(56)) + 10px) : 0px)
        + (root.show-nearby ? Metrics.s(92) + 10px : 0px);

    property <length> tall-tile-w: (rail.width - 2 * root.grid-gap - 8px) / 3;
    property <length> tall-tile-h: Metrics.s(128);
    // Two rows plus the row gap inside the rail's own 2px padding.
    property <length> two-row-h: Math.max(Metrics.s(90),
        Math.round((rail.height - root.gap - 4px) / 2 / 1px) * 1px);

    HorizontalLayout {
        spacing: 10px;

        if root.show-nav: NavButton {
            glyph: "‹";
            clicked => { rail.viewport-x = Math.min(0px, rail.viewport-x + rail.width * 0.8); }
        }

        // The scroll surface. Deliberately ONE Flickable with absolutely-placed
        // tiles rather than a layout per track: tile positions are pure arithmetic
        // in every track (only the strip's active tile changes width, and that is
        // a single offset), and it keeps the rail reachable from the scrollbar and
        // the nav buttons, which a conditional layout would hide in its own scope.
        Rectangle {
            horizontal-stretch: 1;

            rail := Flickable {
                x: 0; y: 0;
                width: parent.width;
                // The scrollbar's 6px track + 6px margin. The STRIP always reserves
                // it — CarFM draws an empty track there even with nothing to scroll
                // — but the two-row grid renders no track at all when it fits, and
                // its rows are 6dp taller as a result.
                height: Metrics.tall ? parent.height
                    : (Metrics.two-rows && !root.overflowing) ? parent.height
                    : parent.height - 12px;
                interactive: !root.reordering;

                viewport-width: Metrics.tall ? self.width : root.content-w;
                viewport-height: Metrics.tall
                    ? Math.ceil(root.n / 3) * (root.tall-tile-h + root.grid-gap) - root.grid-gap + 6px
                    : self.height;

                // Wide strip: one row, the tuned tile emphasised and enlarged.
                if !Metrics.tall && !Metrics.two-rows: Rectangle {
                    for p[i] in root.presets: PresetTile {
                        // The slot this tile is DRAWN in: `splice(from, 1)`
                        // then `splice(to, 0)`, written without an array
                        // because Slint has none. Every tile between the two
                        // indices shifts one place towards the one it passes.
                        //
                        // Inline, and every read direct — see "Slots" above for
                        // why a function here silently half-works.
                        property <int> slot:
                            (root.drag-index < 0 || root.drop-index < 0) ? i
                            // THE HELD TILE DOES NOT MOVE, and that is the fix
                            // for a drag that started and then froze. It is
                            // hidden, so its position is invisible — but its
                            // TouchArea is the one holding the gesture, and
                            // `mouse-x` is measured RELATIVE TO THAT TOUCHAREA.
                            // Sending it to `drop-index` moved the coordinate
                            // origin by a whole tile the instant the drop index
                            // changed, so the very next move reported a finger
                            // that had apparently jumped 128px backwards, which
                            // put the drop index back, which moved the origin
                            // back. A drag that fights itself to a standstill
                            // within a few pixels.
                            //
                            // Leaving it at `i` costs nothing: the gap is opened
                            // by the OTHER tiles stepping aside, and the lifted
                            // copy is what the driver actually sees move.
                            : (i == root.drag-index) ? i
                            : (root.drag-index < root.drop-index)
                                ? ((i > root.drag-index && i <= root.drop-index) ? i - 1 : i)
                                : ((i >= root.drop-index && i < root.drag-index) ? i + 1 : i);
                        property <bool> big: i == root.active-index && !root.reordering;
                        x: self.slot * (root.strip-w-off + root.gap)
                            + ((root.strip-grow && self.slot > root.active-index)
                                ? root.strip-delta : 0px);
                        y: 2px;
                        width: self.big ? root.strip-w-on : root.strip-w-off;
                        height: Math.round(rail.height / 1px * (self.big ? 1.0 : 0.8)) * 1px;
                        // 160ms out-quad, CarFM's gap-opening timing. Zero
                        // when nothing is being dragged, so a retune still
                        // snaps — sliding the strip on every tune would change
                        // a face that is already right.
                        animate x, y { duration: root.dragging ? 160ms : 0ms; easing: ease-out; }
                        hidden: root.dragging && i == root.drag-index;
                        preset: p;
                        active: i == root.active-index;
                        pad-top: Metrics.s(self.big ? 12 : 8);
                        pad-bottom: Metrics.s(self.big ? 16 : 12);
                        pad-h: Metrics.s(self.big ? 8 : 6);
                        logo-radius: self.big ? 15px : 12px;
                        name-font: Math.max(12px, Metrics.s(self.big
                            ? (Metrics.landscape ? 16 : 18)
                            : (Metrics.landscape ? 13 : 15)));
                        reordering: root.reordering;
                        selected => { root.tile-tapped(i); }
                        press-began(mx, my) => { root.hold-begin(i, mx, my); }
                        press-moved(mx, my) => { root.hold-move(i, mx, my); }
                        press-ended => { root.hold-stop(); }
                        press-cancelled => { root.hold-cancel(); }
                        logo-badge => { root.open-logo-search(i); }
                    }
                }

                // Two-thirds slice: a 2-row horizontal grid, columns of two.
                if !Metrics.tall && Metrics.two-rows: Rectangle {
                    for p[i] in root.presets: PresetTile {
                        // The slot this tile is DRAWN in: `splice(from, 1)`
                        // then `splice(to, 0)`, written without an array
                        // because Slint has none. Every tile between the two
                        // indices shifts one place towards the one it passes.
                        //
                        // Inline, and every read direct — see "Slots" above for
                        // why a function here silently half-works.
                        property <int> slot:
                            (root.drag-index < 0 || root.drop-index < 0) ? i
                            // THE HELD TILE DOES NOT MOVE, and that is the fix
                            // for a drag that started and then froze. It is
                            // hidden, so its position is invisible — but its
                            // TouchArea is the one holding the gesture, and
                            // `mouse-x` is measured RELATIVE TO THAT TOUCHAREA.
                            // Sending it to `drop-index` moved the coordinate
                            // origin by a whole tile the instant the drop index
                            // changed, so the very next move reported a finger
                            // that had apparently jumped 128px backwards, which
                            // put the drop index back, which moved the origin
                            // back. A drag that fights itself to a standstill
                            // within a few pixels.
                            //
                            // Leaving it at `i` costs nothing: the gap is opened
                            // by the OTHER tiles stepping aside, and the lifted
                            // copy is what the driver actually sees move.
                            : (i == root.drag-index) ? i
                            : (root.drag-index < root.drop-index)
                                ? ((i > root.drag-index && i <= root.drop-index) ? i - 1 : i)
                                : ((i >= root.drop-index && i < root.drag-index) ? i + 1 : i);
                        x: Math.floor(self.slot / 2) * (Metrics.s(150) + root.gap);
                        y: Math.mod(self.slot, 2) * (root.two-row-h + root.gap) + 2px;
                        width: Metrics.s(150);
                        height: root.two-row-h;
                        // 160ms out-quad, CarFM's gap-opening timing. Zero
                        // when nothing is being dragged, so a retune still
                        // snaps — sliding the strip on every tune would change
                        // a face that is already right.
                        animate x, y { duration: root.dragging ? 160ms : 0ms; easing: ease-out; }
                        hidden: root.dragging && i == root.drag-index;
                        preset: p;
                        active: i == root.active-index;
                        pad-top: Metrics.s(8);
                        pad-bottom: Metrics.s(12);
                        pad-h: Metrics.s(6);
                        logo-radius: i == root.active-index ? 15px : 12px;
                        name-font: Math.max(12px, Metrics.s(15));
                        reordering: root.reordering;
                        selected => { root.tile-tapped(i); }
                        press-began(mx, my) => { root.hold-begin(i, mx, my); }
                        press-moved(mx, my) => { root.hold-move(i, mx, my); }
                        press-ended => { root.hold-stop(); }
                        press-cancelled => { root.hold-cancel(); }
                        logo-badge => { root.open-logo-search(i); }
                    }
                }

                // Tall: a 3-column vertical grid, pinned as a bottom shelf and
                // scrolling downward.
                if Metrics.tall: Rectangle {
                    for p[i] in root.presets: PresetTile {
                        // The slot this tile is DRAWN in: `splice(from, 1)`
                        // then `splice(to, 0)`, written without an array
                        // because Slint has none. Every tile between the two
                        // indices shifts one place towards the one it passes.
                        //
                        // Inline, and every read direct — see "Slots" above for
                        // why a function here silently half-works.
                        property <int> slot:
                            (root.drag-index < 0 || root.drop-index < 0) ? i
                            // THE HELD TILE DOES NOT MOVE, and that is the fix
                            // for a drag that started and then froze. It is
                            // hidden, so its position is invisible — but its
                            // TouchArea is the one holding the gesture, and
                            // `mouse-x` is measured RELATIVE TO THAT TOUCHAREA.
                            // Sending it to `drop-index` moved the coordinate
                            // origin by a whole tile the instant the drop index
                            // changed, so the very next move reported a finger
                            // that had apparently jumped 128px backwards, which
                            // put the drop index back, which moved the origin
                            // back. A drag that fights itself to a standstill
                            // within a few pixels.
                            //
                            // Leaving it at `i` costs nothing: the gap is opened
                            // by the OTHER tiles stepping aside, and the lifted
                            // copy is what the driver actually sees move.
                            : (i == root.drag-index) ? i
                            : (root.drag-index < root.drop-index)
                                ? ((i > root.drag-index && i <= root.drop-index) ? i - 1 : i)
                                : ((i >= root.drop-index && i < root.drag-index) ? i + 1 : i);
                        x: Math.mod(self.slot, 3) * (root.tall-tile-w + root.grid-gap) + 4px;
                        y: Math.floor(self.slot / 3) * (root.tall-tile-h + root.grid-gap) + 3px;
                        width: root.tall-tile-w;
                        height: root.tall-tile-h;
                        // 160ms out-quad, CarFM's gap-opening timing. Zero
                        // when nothing is being dragged, so a retune still
                        // snaps — sliding the strip on every tune would change
                        // a face that is already right.
                        animate x, y { duration: root.dragging ? 160ms : 0ms; easing: ease-out; }
                        hidden: root.dragging && i == root.drag-index;
                        preset: p;
                        active: i == root.active-index;
                        pad-top: Metrics.s(8);
                        pad-bottom: Metrics.s(12);
                        pad-h: Metrics.s(6);
                        logo-radius: i == root.active-index ? 15px : 12px;
                        name-font: Math.max(12px, Metrics.s(15));
                        reordering: root.reordering;
                        selected => { root.tile-tapped(i); }
                        press-began(mx, my) => { root.hold-begin(i, mx, my); }
                        press-moved(mx, my) => { root.hold-move(i, mx, my); }
                        press-ended => { root.hold-stop(); }
                        press-cancelled => { root.hold-cancel(); }
                        logo-badge => { root.open-logo-search(i); }
                    }
                }

                // ── The lifted tile ──
                //
                // The held tile drawn a SECOND time and LAST, so it is above
                // every other tile. Slint has no z-order, so a repeated tile
                // cannot raise itself above its own siblings; the original is
                // hidden instead. CarFM's drag clone exists for the same reason.
                //
                // Inside the Flickable, so it shares the tiles' coordinate space
                // and a rail that scrolls carries it along.
                //
                // NO 1.06 LIFT SCALE. CarFM scales the picked-up tile; Slint
                // 1.17 exposes no scale transform to user code — `Transform` is
                // compiled but internal, "the type exists as an internal type,
                // but cannot be accessed in this scope". The shadow is the whole
                // of the lift here.
                if root.dragging && root.drag-index >= 0 && root.drag-index < root.n:
                PresetTile {
                    x: root.dropping
                        ? root.slot-x(root.drop-index)
                        : root.slot-x(root.drag-index) + root.drag-dx;
                    y: root.dropping
                        ? root.slot-y(root.drop-index)
                        : root.slot-y(root.drag-index) + root.drag-dy;
                    // Only the settle animates. While the finger is down the
                    // tile must track it exactly — easing the follow feels like
                    // lag, and lag on a touchscreen reads as a dropped touch.
                    animate x, y { duration: root.dropping ? 200ms : 0ms; easing: ease-out; }
                    width: root.slot-w(root.drag-index);
                    height: root.slot-h(root.drag-index);
                    preset: root.presets[root.drag-index];
                    pad-top: Metrics.s(8);
                    pad-bottom: Metrics.s(12);
                    pad-h: Metrics.s(6);
                    logo-radius: 12px;
                    name-font: Math.max(12px, Metrics.s(15));
                    reordering: root.reordering;
                    drop-shadow-blur: 18px;
                    drop-shadow-offset-y: 8px;
                    drop-shadow-color: #00000059;
                }
            }

            // The thin drag scrollbar beneath both horizontal layouts.
            if !Metrics.tall: Rectangle {
                x: 0;
                y: parent.height - 6px;
                width: parent.width;
                height: 6px;
                border-radius: 999px;
                clip: true;
                background: rail.viewport-width > rail.width ? Pal.meter-empty : transparent;
                if rail.viewport-width > rail.width: Rectangle {
                    property <length> thumb-w: Math.max(24px,
                        rail.width / rail.viewport-width * parent.width);
                    x: (0px - rail.viewport-x) / (rail.viewport-width - rail.width)
                        * (parent.width - self.thumb-w);
                    y: 0;
                    width: self.thumb-w;
                    height: 6px;
                    border-radius: 999px;
                    background: Pal.scroll-thumb;
                }
            }

            // Empty state: a dashed placeholder with the exact copy.
            if root.n == 0: DashedBox {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                border-radius: 16px;
                Text {
                    text: "No presets yet — tune a station and tap the ★";
                    horizontal-alignment: center;
                    font-family: Font.face;
                    font-size: 17px;
                    color: Pal.dim;
                }
            }
        }

        if root.show-nav: NavButton {
            glyph: "›";
            clicked => {
                rail.viewport-x = Math.max(rail.width - rail.viewport-width,
                    rail.viewport-x - rail.width * 0.8);
            }
        }

        // NEARBY disc — DONE while reordering.
        if root.show-nearby: VerticalLayout {
            alignment: center;
            Rectangle {
                width: Metrics.s(92); height: Metrics.s(92);
                border-radius: self.width / 2;
                background: root.reordering ? Pal.blue : Pal.nearby-disc;
                border-width: root.reordering ? 0px : 1px;
                border-color: Pal.border;
                opacity: nearby-touch.pressed ? 0.7 : 1.0;
                nearby-touch := TouchArea {
                    clicked => {
                        if (root.reordering) { root.done-reordering(); } else { root.open-nearby(); }
                    }
                }
                if !root.reordering: MagnifierTower {
                    size: Metrics.s(64);
                    line: Pal.nearby-line;
                    glass: Pal.nearby-glass;
                }
                if root.reordering: VerticalLayout {
                    alignment: center;
                    Text {
                        text: "✓"; horizontal-alignment: center;
                        color: #FFFFFF; font-size: 26px; font-weight: 700;
                    }
                    Text {
                        text: "DONE"; horizontal-alignment: center;
                        color: #FFFFFF; font-family: Font.face; font-weight: Font.bold;
                        font-size: 13px; letter-spacing: 1.5px;
                    }
                }
            }
        }
    }
}
