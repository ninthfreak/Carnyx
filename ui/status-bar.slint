// Status bar (ANDROID §4.1) — three zones: signal, stereo + tells + genre, and
// the controls. The ARRANGEMENT is track-specific: wide keeps everything inline
// in a left cluster, tall centres the stereo column between two flexed sides so
// it is truly centred regardless of the side widths.

import { Pal, Metrics, Font } from "tokens.slint";
import { EggTheme, BandGear } from "types.slint";
import { SignalWaves, StereoCone, GearIcon, WarningTriangle, GpsSatellite, MotionCar,
         ZeppelinRunes, DrumIcon, SmileyIcon, AirshipIcon, BoltIcon, OsmAndMark } from "icons.slint";
import { NearbyDisc } from "nearby-disc.slint";

// One of the little status letters. Lit = full weight with a soft dark drop; off
// = 32% with a faint 1px light emboss (an engraved look). §4.7 removes all of it
// when audio priority is released — the flat, dead state.
//
// Slint has no text-shadow, so the emboss is a second Text drawn 1px below.
component Tell inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    in property <bool> pulse: false;
    in property <bool> dead: false;

    // The TA pulse (~1.1s). Always running; only read when `pulse` is set.
    property <float> beat: 1.0;
    init => { self.beat = 0.35; }
    animate beat {
        duration: 550ms; easing: ease-in-out;
        iteration-count: -1; direction: alternate;
    }
    property <float> lit: root.pulse ? root.beat : (root.on ? 1.0 : 0.32);

    width: txt.preferred-width;
    height: Metrics.tell-font * 12 / 11;

    Text {
        x: 0; y: 1px;
        text: root.label;
        font-family: Font.face; font-weight: Font.bold;
        font-size: Metrics.tell-font;
        letter-spacing: 1px;
        visible: !root.dead;
        color: (root.pulse || root.on)
            ? #000000.with-alpha(0.30)
            : (Pal.dark ? #FFFFFF.with-alpha(0.10) : #FFFFFF.with-alpha(0.9));
        opacity: root.lit;
    }
    txt := Text {
        x: 0; y: 0;
        text: root.label;
        font-family: Font.face; font-weight: Font.bold;
        font-size: Metrics.tell-font;
        letter-spacing: 1px;
        color: root.pulse ? Pal.amber : Pal.text;
        opacity: root.lit;
    }
}

// The broadcast glyph with its level printed INSIDE it, in the ink-free column
// below the centre dot. The number is absolutely placed and centred, so 2 digits,
// 3 digits or an em-dash leaves the cluster exactly the glyph's width — nothing
// to the right of it can ever be pushed.
export component SignalCluster inherits Rectangle {
    in property <int> full-pairs: 0;
    in property <bool> half: false;
    in property <float> dot-opacity: 1.0;
    in property <int> dotted-arcs: 0;
    /// Already formatted by Rust: the bare NWD level, the SDR figure with its
    /// unit, or an em-dash. No unit is invented for the NWD scale — it is the
    /// vendor's and unidentified.
    in property <string> level-text: "—";

    property <length> glyph-h: Metrics.signal-icon * 32 / 58;

    width: Metrics.signal-icon;
    height: Metrics.tall ? root.glyph-h : Math.max(root.glyph-h, Metrics.stereo-h);

    SignalWaves {
        x: 0; y: (root.height - root.glyph-h) / 2;
        size: Metrics.signal-icon;
        full-pairs: root.full-pairs;
        half: root.half;
        dot-opacity: root.dot-opacity;
        dotted-arcs: root.dotted-arcs;
        // ALWAYS amber. Grey used to mean "this is an estimate, not a reading",
        // and there is no such path any more — every number here is measured.
        on: Pal.amber;
        off: Pal.meter-empty;
    }
    Text {
        x: 0; width: root.width;
        y: Metrics.signal-num-top;
        height: Metrics.signal-num;
        text: root.level-text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-family: Font.face; font-weight: Font.bold;
        font-size: Metrics.signal-num;
        color: Pal.dim;
        // A background-coloured ring separating the digits from any arc ink
        // behind them. The PAGE's ground, themed and all — `egg?.pageBg || pal.bg`.
        stroke: Pal.page;
        stroke-width: 2px;
        stroke-style: outside;
    }
}

// STEREO / MONO pill with the RDS/HD/TP/AF tell strip beneath it.
export component StereoCluster inherits VerticalLayout {
    /// Nothing has reported yet → the pill is EMPTY (outline, no cones, no
    /// label). Asserting MONO before the tuner speaks would be a guess, and on
    /// this firmware it was a wrong one.
    in property <bool> known: false;
    in property <bool> stereo: false;
    in property <bool> rds: false;
    in property <bool> tp: false;
    in property <bool> ta: false;
    in property <bool> af: false;
    in property <bool> dead: false;
    /// The band theme. AC/DC puts its bolts where the cones go.
    in property <EggTheme> egg;

    property <bool> locked: root.stereo && root.known && !root.dead;
    property <bool> blank: root.dead || !root.known;

    spacing: 5px;
    alignment: start;

    HorizontalLayout {
        alignment: center;
        Rectangle {
            // A MINIMUM, as CarFmFace.tsx:1219 writes it (`minHeight: L.stereoH`)
            // and as the token itself is documented in tokens.slint — a large system
            // font scale has to grow the pill rather than clip the label. It was a
            // fixed `height`, which is the one shape that cannot honour either.
            // Inert at every current metric: the tallest thing inside is the 28dp
            // cone against a 36dp pill (20/34 on the tall track, and the same
            // ordering at every k), so the pill resolves to stereo-h exactly as
            // before and the sibling bands that align to that token still line up.
            min-height: Metrics.stereo-h;
            min-width: Metrics.stereo-min-w;
            border-radius: Metrics.stereo-radius;
            border-width: 1.5px;
            border-color: root.locked ? Pal.blue : Pal.border;
            background: root.locked ? Pal.blue-fill : transparent;

            HorizontalLayout {
                padding-left: Metrics.stereo-pad-h;
                padding-right: Metrics.stereo-pad-h;
                spacing: 9px;
                alignment: center;
                // THE PILL'S CONTENTS SAT HIGH, AND THIS IS WHY.
                //
                // `alignItems: 'center'` on CarFmFace's `stereoRow` (:1776) centres
                // all three children on the cross axis. Slint's box layouts default
                // to cross-axis STRETCH, which sizes a child to the layout's full
                // height CLAMPED to its own min/max and then places it at the START
                // of the box. The two cone slots state an explicit 20 × 28, so they
                // were clamped to 28 and pinned to the TOP of a 36dp pill — 4dp
                // high on the wide track, 2dp on the tall one. Measured off
                // shots/head-unit-light.png: pill 18..53, cone ink 23..40, i.e. a
                // centre of 31.5 against the pill's 35.5.
                //
                // The label did NOT move with them, which is what made it read as a
                // misalignment rather than a shift: its box states no height, so it
                // stretched to the full 36 and the compiler's own
                // `maybe_center_in_parent` centred the two Texts inside it. Cones
                // top-aligned, label centred, one pill.
                //
                // Centring the cross axis here fixes the cones and leaves the label
                // exactly where it already was.
                cross-axis-alignment: center;

                // BOTH cones on mono, not one and not none. Mono only changes
                // their appearance: stroke 1.8 → 1.1, the right cone in the dim
                // label colour and the left in the pill's own border colour, so
                // it reads as a ghost. Blue is reserved for a stereo lock. The
                // blank state keeps the slot so nothing reflows.
                // ── THE CONES, OR AC/DC'S BOLTS IN THEIR PLACE ──
                //
                // The supplied art from the reference's own `stereoArtL`/`R`
                // (`assets/fan-l2.png`, `fan-r2.png`) — a fan of three bolts each
                // way, carried across as the PNGs they already are rather than
                // re-traced.
                //
                // They stand IN PLACE OF the cones. The reference renders them
                // OUTSIDE the pill, but only because the pill still held waves
                // there; that arrangement was never a stated requirement, and the
                // cones are what the bolts are the themed form of. The slot keeps
                // the cones' exact width and height either way, so the label
                // beside it cannot shift when a theme arrives or leaves — the
                // whole reason these slots are stated in the first place.
                //
                // Blank still wins: nothing has reported, so there is nothing to
                // say about the pilot, and a themed pill must not assert one.
                Rectangle {
                    width: Metrics.stereo-wave-w;
                    height: Metrics.stereo-wave-h;
                    if !root.blank && root.egg.stereo-bolts: Image {
                        source: @image-url("art/acdc-bolts-left.png");
                        image-fit: contain;
                        width: parent.width;
                        height: parent.height;
                        // TINTED LIVE, not baked. The supplied art is flat
                        // `#2E86FF` — the accent itself — so the colour in the
                        // file carries nothing the palette does not already have,
                        // and the masters are alpha-only. Taking the same colours
                        // the cones took means these track the pill's state AND
                        // follow the accent to silver under "Back in Black",
                        // which is what `stereoArtFilter` was doing by hand.
                        colorize: root.locked ? Pal.blue : Pal.border;
                    }
                    if !root.blank && !root.egg.stereo-bolts: StereoCone {
                        flip: true;
                        color: root.locked ? Pal.blue : Pal.border;
                        stroke-w: root.locked ? 1.8 : 1.1;
                        w: Metrics.stereo-wave-w;
                        h: Metrics.stereo-wave-h;
                    }
                }
                // THE CONES MUST NOT MOVE between states. "MONO" is narrower
                // than "STEREO" and the row centres its contents, so a naive
                // label pulls both cones inward on mono. The label sits in a box
                // the width of the widest string, with the live label centred
                // over it.
                //
                // The HEIGHT is stated for the same reason the width is. With the
                // cross axis centred, every child is sized to its preferred size
                // and centred; saying this one outright keeps that from depending
                // on which children the compiler folds into a bare Rectangle's
                // implicit size — the live label is excluded from that fold
                // because it sets `x`, leaving only the invisible reserve.
                Rectangle {
                    width: reserve.preferred-width;
                    height: reserve.preferred-height;
                    reserve := Text {
                        opacity: 0;
                        text: "STEREO";
                        font-family: Font.face; font-weight: Font.bold;
                        font-size: Metrics.stereo-font;
                        letter-spacing: 1px;
                    }
                    Text {
                        x: 0; width: parent.width;
                        horizontal-alignment: center;
                        text: root.blank ? "" : (root.stereo ? "STEREO" : "MONO");
                        font-family: Font.face; font-weight: Font.bold;
                        font-size: Metrics.stereo-font;
                        letter-spacing: 1px;
                        color: root.locked ? Pal.blue : Pal.dim;
                    }
                }
                Rectangle {
                    width: Metrics.stereo-wave-w;
                    height: Metrics.stereo-wave-h;
                    if !root.blank && root.egg.stereo-bolts: Image {
                        source: @image-url("art/acdc-bolts-right.png");
                        image-fit: contain;
                        width: parent.width;
                        height: parent.height;
                        colorize: root.locked ? Pal.blue : Pal.dim;
                    }
                    if !root.blank && !root.egg.stereo-bolts: StereoCone {
                        color: root.locked ? Pal.blue : Pal.dim;
                        stroke-w: root.locked ? 1.8 : 1.1;
                        w: Metrics.stereo-wave-w;
                        h: Metrics.stereo-wave-h;
                    }
                }
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        Tell { label: "RDS"; on: !root.dead && root.rds; dead: root.dead; }
        // HD is never lit — nothing in this pipeline decodes IBOC — but the slot
        // stays so the strip reads like a factory head unit's.
        Tell { label: "HD"; on: false; dead: root.dead; }
        // TA REPLACES TP while an announcement is running, and pulses. One slot,
        // two states: TP says the station carries traffic at all, TA says one is
        // happening now, and the second implies the first.
        // `!root.dead` GUARDS THE `on` TOO, and it is the only one of the four
        // tells that ever missed it. `root.ta ? true : …` lit the slot at full
        // opacity on a released face while RDS, HD and AF all sat at 0.32 — and
        // `dead` does not cover it, because `Tell` uses that only to drop the
        // emboss layer. §4.7 wants every tell dim there, which face.slint states
        // as the rule it enforces for the whole cluster.
        Tell {
            label: (root.ta && !root.dead) ? "TA" : "TP";
            on: !root.dead && (root.ta || root.tp);
            pulse: root.ta && !root.dead;
            dead: root.dead;
        }
        Tell { label: "AF"; on: !root.dead && root.af; dead: root.dead; }
    }
}

// PTY / genre. The design gives it a 1px emboss; Slint has no text shadow, so
// the shadow is a second Text one pixel down, the same trick the tells use.
component GenreText inherits Rectangle {
    in property <string> text;
    in property <bool> centered: false;
    /// The band theme, which recolours this line and makes it pulse.
    in property <EggTheme> egg;

    // THE PULSE (CarFM `genrePulse`, `genrePulseOn: true` for AC/DC): the gold
    // breathes toward a brighter gold and back. Same shape as the TA tell above —
    // an always-running animation whose value is only READ while a theme is
    // showing, so a face with no theme never depends on it and never redraws for
    // it. On this unit that distinction is the difference between an idle face
    // and one repainting every frame forever.
    property <float> beat: 0.0;
    init => { self.beat = 1.0; self.turn = 1.0; }
    animate beat {
        duration: 900ms; easing: ease-in-out;
        iteration-count: -1; direction: alternate;
    }
    // ── WHAT COLOUR THIS LINE IS, AND WHAT AN UNSTATED COLOUR MEANS ──
    //
    // ZERO IS THE ORDINARY TOKEN, NOT TRANSPARENT. `app.rs` has always said so
    // where it maps the registry — "a zero here has to fall through to `Pal.dim`
    // and not paint the line black" — and it maps an unstated colour to a fully
    // transparent one, expecting THIS to test the alpha. It did not. Nirvana and
    // Nine Inch Nails both name a genre and neither names a colour, so the live
    // layer was drawn in nothing and the only thing on screen was the backing
    // copy below — white at 95% on a light face. The reference render
    // (`docs/design/screenshots/egg-nirvana.png`) shows that line DIM.
    //
    // A ZERO PULSE IS NO PULSE. `genrePulseOn` is AC/DC's alone; The Beatles
    // names an ink and no pulse, and mixing toward an unstated colour walked its
    // line to transparent and back once a second.
    //
    // A BASIC THEME IS WHY BOTH MATTER NOW. A row that states a genre and no
    // palette is the ordinary case for the tier, not the exception, so
    // "unstated" has to be a working answer rather than an untrodden path.
    property <color> base: root.egg.genre-ink.alpha > 0 ? root.egg.genre-ink : Pal.dim;
    property <color> ink: !root.egg.on
        ? Pal.dim
        : (root.egg.genre-pulse.alpha > 0
            ? root.base.mix(root.egg.genre-pulse, 1.0 - root.beat)
            : root.base);
    /// Vertical band to centre within. The wide track sits the genre on the
    /// STEREO pill's own band; the tall track lets it be its own line.
    in property <length> band-h: 0px;

    // ── SIZE AND WEIGHT (v1.16.0) ──
    //
    // A themed genre line is bigger and heavier than a PTY string: 33/47 against
    // 26/33, weight 800 against 700. Both pairs are stated in `Metrics`; which
    // one applies is the only decision here.
    //
    // 800 IS ASKED FOR AND 700 IS WHAT ARRIVES. Atkinson Hyperlegible ships two
    // cuts and this build bundles both — 400 and 700 — so there is no 800 face
    // for the engine to find and it resolves to the nearest, which is the bold
    // already in use. Written as the spec states it rather than silently reduced
    // to 700: the day an ExtraBold cut is bundled, this line is already right.
    // ── SIZE AND WEIGHT BELONG TO THE ADVANCED TIER, NOT TO "A THEME" ──
    //
    // These read `advanced` rather than `on`, which is the owner's rule: an
    // advanced theme may state its own sizes, and a BASIC one takes the ordinary
    // ones until told otherwise. A basic row replaces the words on this line and
    // nothing else, so the line stays the size the broadcaster's PTY was.
    //
    // `advanced` implies `on` — it is mapped from the registry row and is false
    // whenever no theme is showing — so this is not a second gate.
    //
    // WHAT THIS DOES NOT CHANGE is the WIDTH allowance below, which still keys
    // off `on`. `Metrics.genre-cap` exists to stop a broadcaster's PTY crowding
    // the bar; a theme's line is the app's own string and keeps the room. Only
    // the starting size moved.
    property <length> full-size: root.egg.advanced ? Metrics.pty-egg-font : Metrics.pty-font;
    property <int> weight: root.egg.advanced ? Font.heavy : Font.bold;
    /// The genre line's own face. NO FALLBACK to the theme's body face —
    /// `eggGenreFont` reads `genreFont` alone — which is why AC/DC's gold line is
    /// Atkinson while its hero is Squealer, and why The Beatles sets Madie Roger
    /// here and YellowSubmarine everywhere else.
    property <string> face: root.egg.genre-face != "" ? root.egg.genre-face : Font.face;

    // ── `genreCycle` — TWO STRINGS ON A LONG LOOP ──
    //
    // Nine Inch Nails alone: "Broken Machines" and "Things Falling Apart", each
    // held ~20s and cross-faded on a 40s cycle. One animated float drives both
    // the swap and the fade, so there is no timer and no second state — and it
    // is only READ while a cycling theme is showing, so an ordinary face never
    // depends on it and never redraws for it.
    property <bool> cycling: root.egg.genre-cycle != "";
    property <float> turn: 0.0;
    animate turn {
        duration: 40s; easing: linear; iteration-count: -1;
    }
    /// The second half of the loop shows the other string.
    property <bool> on-second-half: root.cycling && root.turn > 0.5;
    property <string> shown: root.on-second-half ? root.egg.genre-cycle : root.text;
    /// A short dip to black at each hand-over, so the swap reads as a cross-fade
    /// rather than as a jump. 1.5s of the 40, at each end of each half.
    property <float> fade: !root.cycling ? 1.0
        : (root.turn < 0.02 || (root.turn > 0.48 && root.turn < 0.52) || root.turn > 0.98)
            ? 0.15 : 1.0;

    // ── SHRINK TO FIT BEFORE ELIDING ──
    //
    // An over-long genre gives up POINTS before it gives up WORDS. Eliding is
    // the last resort, not the first: "Foreign Lang…" tells a driver less at a
    // glance than the whole phrase a size smaller, and this line exists to be
    // read at a glance.
    //
    // MEASURED BY A HIDDEN TWIN, and that is the only way to do it without a
    // cycle. A `Text`'s `preferred-width` depends on its `font-size`, so sizing
    // the visible line from its own measurement would be circular. `gauge` is
    // pinned at `full-size` — a value that depends on nothing here — so its
    // measurement is a fixed input. It is `visible: false` rather than
    // `opacity: 0`: an invisible element still lays out and still reports a
    // preferred size (verified against Slint 1.17.1 — both report the same
    // width), and unlike a zero-opacity one it costs no layer and no draw.
    //
    // THE BUDGET IS THE CAP WHERE THERE IS ONE. The design gives the inline
    // wide-track line 200dp (240 here — see `Metrics.genre-cap`) and gives the
    // centred line and a themed line no cap at all. "No cap" cannot mean "may
    // run off the display", so those two are bounded by what is physically
    // there instead. Reaching that bound is what "exceptionally long" means.
    //
    // AND WHAT IS THERE IS NOT THE WHOLE PAGE. The tall track builds the status
    // bar as three zones — signal, this column, controls — with the two sides
    // flexed and this one at its own preferred width, so the room for a centred
    // genre is the page LESS BOTH SIDES. Budgeting the whole page instead put a
    // 336dp line on a 360dp phone and pushed it off the right edge: it fitted
    // the page and not the gap. The signal glyph is the wider of the two sides
    // on every tall metric (`signal-icon` is s(74.75) against the gear's 44), and
    // the sides are symmetric, so it stands for both.
    //
    // All three terms are `Metrics` globals, which is what keeps this out of a
    // cycle: a budget read from the parent's actual width would be a width that
    // depends on the child that depends on it.
    ///
    /// WHAT TO ASK THE LAYOUT FOR. The cap where the design states one, and where
    /// it states none — the centred line, a themed line — the page less both side
    /// zones, floored at the pill's own width so the subtraction cannot go
    /// negative before a `Face` has measured itself.
    property <length> ask: (root.centered || root.egg.on)
        ? Math.max(Metrics.stereo-min-w,
                   Metrics.avail-w - Metrics.pad-h * 2 - Metrics.signal-icon * 2)
        : Metrics.genre-cap;

    /// AND WHAT THE LAYOUT ACTUALLY GAVE, which is what the shrink measures
    /// against. Predicting the gap from `Metrics` was wrong by 49dp on the tall
    /// track — the right-hand zone carries the nearby disc as well as the gear
    /// and is the wider of the two sides, and there is layout spacing on top —
    /// so a line shrunk to fit a gap it had guessed still elided in the gap it
    /// got. The allocation is not a guess.
    ///
    /// NOT A CYCLE, and the split above is what keeps it out of one: `ask` is
    /// what feeds `preferred-width`, and it depends on globals alone. `width`
    /// comes back from the layout afterwards and feeds only the font size, whose
    /// only onward effect is on `height`.
    property <length> budget: root.width;
    property <length> natural: gauge.preferred-width;
    // Guarded on the numerator, not just the ratio: an empty string measures 0
    // and must not divide.
    ///
    /// MEASURED TWICE, because a glyph's advance is NOT proportional to its point
    /// size. Scaling by `budget / natural` and trusting the arithmetic leaves the
    /// line 3–4% over the target it was scaled to hit — measured on this string
    /// and this face, 475dp at 35px against 246 at 17.6 where proportion predicts
    /// 239 — so the first pass shrank a line to fit and it elided anyway, which is
    /// the worst of both. The second gauge measures what the first pass actually
    /// produced and corrects from that, which converges to within a pixel; the
    /// last 1% is margin, because a pixel is what the ellipsis costs.
    property <float> first: (root.natural > root.budget && root.natural > 0px)
        ? root.budget / root.natural
        : 1.0;
    property <length> second: gauge2.preferred-width;
    property <float> fit: (root.second > root.budget && root.second > 0px)
        ? root.first * root.budget * 0.99 / root.second
        : root.first;
    // The floor is a SIZE, not a ratio, so a small track cannot shrink through
    // it: `Metrics.pty-font-min` is already scaled and already floored at 12dp.
    // Past it the line elides, which is the old behaviour and the right one —
    // there is a point below which a smaller word is not a legible word.
    property <length> size: Math.max(Metrics.pty-font-min, root.full-size * root.fit);

    // ── THE FOUR MARKS, IN PLACE OF THE LINE (Led Zeppelin) ──
    //
    // Not beside it and not behind it: the marks ARE the genre for that theme,
    // which is why the text below is suppressed rather than overdrawn. Sized at
    // 1.45x the line they replace, as `bandArt.tsx` sizes them.
    if root.egg.genre-runes: ZeppelinRunes {
        x: root.centered ? (root.width - self.width) / 2 : 0px;
        y: (root.height - self.height) / 2;
        size: root.full-size * 1.45;
        ink: Pal.dim;
    }

    gauge := Text {
        // EXPLICIT GEOMETRY KEEPS A GAUGE OUT OF THE FOLD. A plain element sums
        // its children into its own layout info, so a gauge whose font size is
        // derived from the element's width closes a loop through it — Slint says
        // so outright: "layoutinfo-h -> layout-cache -> width -> root.budget ->
        // gauge2.font-size -> root.layoutinfo-h". Stating x and y takes the
        // child out of that sum, which is the same rule the STEREO pill's
        // invisible reserve relies on, and `preferred-width` is unaffected by an
        // assigned size.
        x: 0px; y: 0px; width: 0px; height: 0px;
        visible: false;
        text: root.shown;
        font-family: root.face;
        font-weight: root.weight;
        font-size: root.full-size;
        letter-spacing: 0.5px;
    }
    /// The second measurement: the same string at the size the FIRST pass chose.
    /// Its font-size depends on `first`, which depends on `gauge` alone, so this
    /// is still a straight line and not a cycle.
    gauge2 := Text {
        x: 0px; y: 0px; width: 0px; height: 0px;
        visible: false;
        text: root.shown;
        font-family: root.face;
        font-weight: root.weight;
        font-size: root.full-size * root.first;
        letter-spacing: 0.5px;
    }

    // Both Texts bind their width to root.width, so this Rectangle has no
    // intrinsic width of its own — it has to be told one, or a HorizontalLayout
    // hands it zero and the genre silently disappears. (A VerticalLayout stretches
    // its children instead, which is how the wide track lost the line while the
    // tall track kept it.) No `width` binding, so the centred variant can still be
    // stretched by its parent; 200 is the design's cap on the wide track.
    //
    // THE CAP DOES NOT APPLY TO A THEMED LINE. `maxWidth: eggGenre ? 'none' :
    // (tall ? 'none' : 200)` — a band theme's line is its own statement and is
    // allowed to run past the PTY's budget rather than elide to "High Voltage
    // Rock 'n…". The overflow rule goes with it: `overflow: eggGenre ? 'visible'
    // : 'hidden'`.
    // ASKED FOR AT MOST THE BUDGET, not at the natural width. The centre column
    // on the tall track states `horizontal-stretch: 0`, so it sizes to what its
    // children ask for, and a child asking for the full width of an over-long
    // genre made the column wider than the screen.
    //
    // `max-width` IS NOT ENOUGH ON ITS OWN, and that cost a build to learn:
    // Slint honours it when a LAYOUT is doing the sizing and ignores it when the
    // parent is a plain element, so the same component obeyed the cap in one
    // place and drew 360dp wide in another. Measured in isolation — budget 226,
    // `max-width: 226`, element width 360. So the TEXT BOX is bound below rather
    // than the element, and the cap holds wherever this is placed.
    // ASKED FOR OFF THE GAUGE, NOT OFF THE LIVE LINE, because the live line's
    // width depends on the size the shrink chose and the shrink depends on the
    // allocation — reading it here would close the loop.
    preferred-width: Math.min(root.natural, root.ask);
    max-width: root.ask;
    // AND A MIN-WIDTH, WHICH IS WHAT ACTUALLY MAKES THE CAP HOLD. A Rectangle
    // derives its minimum width from its children, a Text's minimum is the width
    // of its own string, and a minimum beats a maximum — so this element sized
    // itself to 513dp inside a layout that had been told 226dp was the limit,
    // and `max-width` looked like it was being ignored. Saying the minimum
    // outright is what releases it. Measured: 513dp before this line, 226 after,
    // with nothing else changed.
    min-width: 0px;
    /// The Texts fill the element, which the layout has already sized to the
    /// allocation the shrink was computed against.
    property <length> text-w: root.width;

    // A MINIMUM, NOT A FIXED HEIGHT, and this is the v1.16.0 fix that had to come
    // with the larger type: the inline row was `height: 36` outright, so a line
    // that grew past 36dp was clipped by the box meant to reserve space for it.
    // `height:'auto', minHeight:36` — unchanged where the text fits, and it grows
    // where it does not.
    height: Math.max(root.band-h, live.preferred-height);

    Text {
        x: 0; width: root.text-w;
        y: (root.height - self.preferred-height) / 2 + 1px;
        text: root.egg.genre-runes ? "" : root.shown;
        overflow: elide;
        horizontal-alignment: root.centered ? center : left;
        font-family: root.face; font-weight: root.weight;
        font-size: root.size;
        letter-spacing: 0.5px;
        color: Pal.dark ? #000000.with-alpha(0.5) : #FFFFFF.with-alpha(0.95);
    }
    // ── SYNTHETIC BOLD, FOR A FACE THAT HAS NO BOLD CUT ──────────────────────
    //
    // A display face usually ships one weight, and Slint hands that cut back
    // unchanged when asked for 700 — it does not thicken a glyph the way a
    // browser does. So a theme that says "in bold" over a single-weight face
    // gets nothing unless the thickening is drawn.
    //
    // BY DILATION, NOT BY A STROKE, for the reason `ui/glitch.slint` records
    // against the hero lettering: `stroke-width` is inert in this version's
    // software renderer, so a stroked bold would be invisible in every shot and
    // unverifiable off the device.
    //
    // FIVE COPIES OF AN OPAQUE INK COMPOSITE TO THAT INK however they overlap,
    // which is why this is safe here: `ink` resolves to `Pal.dim` or a theme's
    // stated colour, both opaque. It would NOT be safe over a faded one.
    //
    // ZERO IS ONE COPY. Every other theme, and every unthemed face, pays nothing.
    property <length> bold-r: root.egg.face-bold * root.size;
    property <[{dx: float, dy: float}]> offsets: root.bold-r > 0px
        ? [{dx: 0, dy: 0}, {dx: -1, dy: -1}, {dx: 1, dy: -1}, {dx: -1, dy: 1}, {dx: 1, dy: 1}]
        : [{dx: 0, dy: 0}];

    for o[i] in root.offsets: Text {
        x: o.dx * root.bold-r; width: root.text-w;
        y: (root.height - self.preferred-height) / 2 + o.dy * root.bold-r;
        text: root.egg.genre-runes ? "" : root.shown;
        overflow: elide;
        horizontal-alignment: root.centered ? center : left;
        font-family: root.face; font-weight: root.weight;
        font-size: root.size;
        letter-spacing: 0.5px;
        color: root.ink;
        opacity: root.fade;
        // The outline belongs to the TRUE copy alone; drawn on all five it would
        // be five outlines a radius apart rather than one edge.
        stroke: i == 0 ? root.egg.genre-outline-ink : Colors.transparent;
        stroke-width: i == 0 ? root.egg.genre-outline-w : 0px;
        stroke-style: center;
    }

    // The GAUGE the box measures itself from — the true copy's geometry, with no
    // offset and nothing drawn. `visible: false` keeps its preferred size and
    // costs no layer, which is the pattern the hero's own gauges use.
    live := Text {
        visible: false;
        x: 0; width: root.text-w;
        y: (root.height - self.preferred-height) / 2;
        text: root.egg.genre-runes ? "" : root.shown;
        overflow: elide;
        horizontal-alignment: root.centered ? center : left;
        font-family: root.face; font-weight: root.weight;
        font-size: root.size;
        letter-spacing: 0.5px;
        color: root.ink;
        opacity: root.fade;
        // NO STROKE HERE. `genreOutline` is drawn on the true copy in the loop
        // above; this one is invisible and exists only to be measured.
    }
}

// Out-of-FM-band warning. The pill text carries no "MHz" label — FM always is.
component OutOfBandPill inherits Rectangle {
    border-width: 1.5px;
    border-radius: 10px;
    border-color: Pal.amber;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px;
        padding-top: 4px; padding-bottom: 4px;
        Text {
            text: "⚠ OUT OF FM BAND";
            font-family: Font.face; font-weight: Font.bold;
            font-size: 12px;
            letter-spacing: 0.5px;
            color: Pal.amber;
        }
    }
}

// Driving-status icons (§4.6) — wide/landscape tracks only.
export component DrivingStatus inherits HorizontalLayout {
    in property <bool> gps-fix: false;
    in property <bool> in-motion: false;
    /// Settings ▸ TUNER ▸ Turn-by-turn. Off means no tell at all (§4.9).
    in property <bool> osmand-on: false;
    /// The AIDL service is bound AND answering. See `App::push_nav`.
    in property <bool> osmand-linked: false;
    /// The band theme, for the airship alone.
    in property <EggTheme> egg;
    /// A tap on the mark itself — bring OsmAnd to the front. Fires whether or
    /// not `osmand-linked` is true; a driver watching a dim mark still wants
    /// the tap to try.
    callback open-osmand();

    // A slow ~2.6s breathe — gentler than TA's 1.1s.
    property <float> breathe: 1.0;
    init => { self.breathe = 0.4; }
    animate breathe {
        duration: 1300ms; easing: ease-in-out;
        iteration-count: -1; direction: alternate;
    }

    spacing: 12px;
    alignment: end;
    // `alignItems: 'center'` on CarFmFace's DrivingStatusIcons row (:247). The
    // SAME defect the stereo pill had, and found looking for it: the car states
    // 34dp and the satellite's wrapper 30dp, so under Slint's default cross-axis
    // stretch the satellite was clamped to 30 and pinned to the top of a 34dp row —
    // 2dp high whenever both are on screen. It has no effect when the car is
    // absent, which is why it reads as intermittent.
    cross-axis-alignment: center;

    // The car shows ONLY while moving — absent, not dimmed, when stopped. Amber:
    // the fixed safety-colour family, like TA, never the blue accent.
    //
    // LED ZEPPELIN FLIES AN AIRSHIP IN THIS SLOT (§2.3) and leaves the settings
    // gear alone — the mirror image of the other three, which take the gear and
    // leave this alone. Same colour, same breathe, same "only while moving": a
    // theme may change what the mark IS and never what it MEANS.
    if root.in-motion && !root.egg.airship: MotionCar {
        size: 34px;
        color: Pal.amber;
        opacity: root.breathe;
    }
    if root.in-motion && root.egg.airship: AirshipIcon {
        size: 34px;
        ink: Pal.amber;
        opacity: root.breathe;
    }
    // ── THE OSMAND TELL (§4.9) ──────────────────────────────────────────────
    //
    // "While the integration is enabled, OsmAnd's own mark sits in the right
    // cluster between the vehicle-in-motion glyph and the GPS satellite (so the
    // car glyph moves one slot left): full colour (#FF8800) once the AIDL
    // service is bound, the flat text colour at ~30% when it is not — the same
    // 'present but inert' language the GPS tell uses with no fix."
    //
    // ABSENT WHEN THE SWITCH IS OFF, not dimmed: "Off means no mirroring AND no
    // tell in the status bar." Dim already means something else on this mark —
    // enabled but not bound — and one glyph cannot carry two different
    // absences.
    //
    // THE ORANGE IS A LITERAL AND NOT A PALETTE TOKEN, on purpose. It is
    // OsmAnd's own #FF8800, near to but not `Pal.amber`: the amber family is
    // this face's safety colour and this is somebody else's brand. Routing it
    // through the palette would let a band theme restyle it, and §4.9 forbids
    // exactly that for the maneuver layer.
    if root.osmand-on: Rectangle {
        // The mark's own rendered width, so the row's 12px spacing is the whole
        // gap. §4.9 asks for "small negative margins" to close an optical gap;
        // those cancel per-tile padding the reference carries and this build
        // does not — its tiles are the ink.
        width: 27px; height: 30px;
        // A TAP BRINGS OSMAND FORWARD. Sized to the mark's own box rather than
        // padded out to a larger target: growing it would eat into the 12px
        // gap §4.9 tuned against the car glyph and the satellite on either
        // side, and this mark is no smaller than the GPS tell beside it, which
        // has never needed one.
        mark-touch := TouchArea {
            clicked => { root.open-osmand(); }
        }
        OsmAndMark {
            // NUDGED DOWN 2dp so the DISC's centre lands on the row's, which is
            // where the eye reads a round mark from. The glyph's box is not
            // centred on its disc — the pin's tail hangs below — and the offset
            // is that difference: the disc's centre sits 44.4% down a
            // 60.75-unit box against the box's own 50%, which over 30px is
            // 1.7px. §4.9 rounds it to 2.
            y: 2px;
            size: 30px;
            color: root.osmand-linked ? #FF8800 : Pal.text;
            // NOT `mark-touch.pressed` HERE — this opacity already carries the
            // linked/unlinked state (1.0 / 0.30), and folding a press-state
            // into the same property would flash a linked mark toward
            // "unlinked" for the length of every tap.
            opacity: root.osmand-linked ? 1.0 : 0.30;
        }
    }
    // Always present: it communicates lock state. With no fix it is not greyed
    // but styled like a disabled tell — full text colour at ~32%.
    Rectangle {
        width: 30px; height: 30px;
        GpsSatellite {
            y: -4px;
            size: 30px;
            color: root.gps-fix ? Pal.blue : Pal.text;
            opacity: root.gps-fix ? 1.0 : 0.32;
        }
    }
}

export component StatusBar inherits Rectangle {
    // ── WHERE THE CLOCK HANGS ITSELF (§4.8) ─────────────────────────────────
    //
    // The clock is OUT OF FLOW in the face's top-level Rectangle, and §4.8 says
    // what it measures from: "the clock line's optical center sits midway
    // between the bottom edge of the right cluster and the top line of the hero
    // card … Right edge flush with the gear."
    //
    // THE CLUSTER'S BOTTOM EDGE IS NOT THIS BOX'S. The status bar runs deeper on
    // the left — the signal arcs and the level readout are taller than the icon
    // row — so centring in the gap below this component would put the clock too
    // low and the spec calls that out in as many words. These two report the
    // GEAR, which is the cluster's real bottom on the wide and landscape tracks.
    //
    // Absolute, because the consumer is a sibling of this component's parent and
    // has no other frame of reference. Zero until the first layout pass, which
    // is why the face hides the readout until it has measured — see `clock-y`.
    // THE GEAR IS NOT ALWAYS THE BOTTOM OF THE CLUSTER, and §4.8 says which is:
    // "the settings gear on the wide/landscape tracks and the nearby button on
    // the tall track, where that sits below the gear." Anchoring to the gear
    // everywhere ran the clock straight THROUGH the nearby disc in portrait; the
    // first render of `clock-portrait.png` is what showed it.
    //
    // ── WHY THE DISC IS COMPUTED AND THE GEAR IS MEASURED ────────────────────
    //
    // The disc lives inside `if Metrics.tall:`, and Slint will not let an id
    // inside a conditional be referenced from outside it — "Cannot access id
    // 'nearby-disc'". So its bottom is derived from the two numbers that place
    // it, and BOTH are named properties used by the layout itself: change either
    // and this follows, which is the only thing that stops the two drifting.
    property <length> cluster-gap: 12px;
    property <length> nearby-disc-size: Metrics.s(74);
    out property <length> cluster-bottom: gear.absolute-position.y + gear.height
        + (Metrics.tall ? root.cluster-gap + root.nearby-disc-size : 0px);
    /// Where the centred column ends — §4.9's cruise countdown hangs from this.
    ///
    /// ── COMPUTED, NOT MEASURED, AND FOR THE USUAL REASON ────────────────────
    ///
    /// §4.9 anchors the countdown to "the genre line's baseline, not the status
    /// bar's box — the box runs deeper on the left for the RDS chip row, but the
    /// centered column is clear from the genre down". The genre line's own id
    /// cannot be reached: it lives inside two nested conditionals, and Slint
    /// refuses ("Cannot access id"), which is the same wall `cluster-bottom` hit
    /// and is solved the same way — derive it from the numbers that PLACE it.
    ///
    /// WIDE AND LANDSCAPE: the genre line is a column of the inline cluster and
    /// is given `band-h: Metrics.stereo-h`, so it is a box of exactly that
    /// height at the row's top. Its baseline is the bar's own top plus that
    /// band. The RDS chip strip hangs BELOW this and is deliberately not counted
    /// — that is the "box runs deeper" the spec is telling us to ignore.
    ///
    /// TALL: the genre line is in the separately centred middle column, under a
    /// stereo cluster whose height varies with its tell strip, and none of that
    /// is a named number. So this reports the bar's own bottom instead, which is
    /// BELOW the genre line rather than above it — the countdown sits a little
    /// lower than §4.9 draws it and can never land on top of the column. Said
    /// plainly rather than left as a silent difference.
    out property <length> genre-bottom: Metrics.tall
        ? root.absolute-position.y + root.height
        : root.absolute-position.y + Metrics.stereo-h;
    in property <int> full-pairs: 0;
    in property <bool> half: false;
    in property <float> dot-opacity: 1.0;
    in property <int> dotted-arcs: 0;
    in property <string> level-text: "—";
    in property <bool> stereo-known: false;
    in property <bool> stereo: false;
    in property <bool> rds: false;
    in property <bool> tp: false;
    in property <bool> ta: false;
    in property <bool> af: false;
    in property <string> pty: "";
    /// The band theme. When it names a genre of its own it REPLACES this line —
    /// the PTY this station broadcasts is not what the driver is being told
    /// about.
    in property <EggTheme> egg;

    /// What the genre line actually says, resolved ONCE for both layout tracks.
    ///
    /// A THEME MAY DRESS THIS LINE WITHOUT REPLACING IT. The five advanced
    /// themes each name a genre, so for them this is simply `egg.genre`; a BASIC
    /// theme is allowed to name only a font, and then the broadcaster's own PTY
    /// is what gets set in that font. Written here rather than twice below,
    /// because the wide and tall arms carried the same expression and one of
    /// them would eventually have been fixed alone.
    property <string> genre-line: root.egg.on && root.egg.genre != ""
        ? root.egg.genre
        : root.pty;

    in property <bool> in-band: true;
    /// No compatible tuner session. This pill REPLACES the whole OK cluster —
    /// with no tuner there is no signal, RDS, stereo or genre to read, so the
    /// two never show together.
    in property <bool> tuner-error: false;
    in property <bool> dead: false;
    in property <bool> gps-fix: false;
    in property <bool> in-motion: false;
    /// The OsmAnd tell (§4.9). See `DrivingStatus`.
    in property <bool> osmand-on: false;
    in property <bool> osmand-linked: false;
    in property <bool> reordering: false;

    callback open-settings();
    callback open-nearby();
    callback open-osmand();
    callback done-reordering();

    HorizontalLayout {
        spacing: 12px;
        alignment: space-between;

        // ── Left / status ──
        VerticalLayout {
            alignment: start;
            horizontal-stretch: Metrics.tall ? 1 : 0;

            if root.tuner-error: HorizontalLayout {
                alignment: start;
                Rectangle {
                    height: 44px;
                    border-radius: 10px;
                    border-width: 1.5px;
                    border-color: Pal.amber;
                    background: Pal.amber-fill;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        spacing: 11px;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            WarningTriangle { size: 26px; color: Pal.amber; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Failure to connect to tuner.";
                                font-family: Font.face; font-weight: Font.bold;
                                font-size: 17px;
                                letter-spacing: 0.3px;
                                color: Pal.amber;
                            }
                        }
                    }
                }
            }

            // Wide / landscape: everything inline in the left cluster, aligned to
            // the STEREO pill's band — the tell strip hangs BELOW the pill and
            // must not pull the signal or the genre down with it.
            if !root.tuner-error && !Metrics.tall: HorizontalLayout {
                spacing: 14px;
                alignment: start;
                VerticalLayout {
                    alignment: start;
                    SignalCluster {
                        full-pairs: root.full-pairs; half: root.half;
                        dot-opacity: root.dot-opacity; dotted-arcs: root.dotted-arcs;
                        level-text: root.level-text;
                    }
                }
                VerticalLayout {
                    alignment: start;
                    StereoCluster {
                        known: root.stereo-known; stereo: root.stereo;
                        rds: root.rds; tp: root.tp; ta: root.ta; af: root.af;
                        dead: root.dead; egg: root.egg;
                    }
                }
                // PTY: plain dim ellipsized text, no border or fill, on the
                // pill's own band.
                // A THEME'S GENRE, OR THE BROADCASTER'S, and the fall-through
                // is what lets a theme carry a FACE without carrying a line.
                // This read `egg.on ? egg.genre : pty`, so a theme with no genre
                // of its own blanked the PTY instead of restyling it. None of
                // the five advanced themes can reach that — every one names a
                // line — but a basic theme is allowed to name only a font, and
                // that is exactly the row it would have silenced.
                if root.genre-line != "" && !root.dead: GenreText {
                    text: root.genre-line;
                    egg: root.egg;
                    band-h: Metrics.stereo-h;
                }
                if !root.in-band: VerticalLayout {
                    alignment: start;
                    OutOfBandPill { }
                }
            }

            // Tall: the signal cluster (and any out-of-band pill) hold the left
            // zone on their own; the stereo column is centred separately.
            if !root.tuner-error && Metrics.tall: HorizontalLayout {
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: start;
                    SignalCluster {
                        full-pairs: root.full-pairs; half: root.half;
                        dot-opacity: root.dot-opacity; dotted-arcs: root.dotted-arcs;
                        level-text: root.level-text;
                    }
                }
                if !root.in-band: VerticalLayout {
                    alignment: start;
                    OutOfBandPill { }
                }
            }
        }

        // ── Centre (tall only) — STEREO pill, tells and genre, truly centred ──
        if Metrics.tall && !root.tuner-error: VerticalLayout {
            alignment: start;
            horizontal-stretch: 0;
            spacing: 5px;
            StereoCluster {
                known: root.stereo-known; stereo: root.stereo;
                rds: root.rds; tp: root.tp; ta: root.ta; af: root.af;
                dead: root.dead; egg: root.egg;
            }
            // Same line, same rule. See the wide arm above.
            if root.genre-line != "" && !root.dead: GenreText {
                text: root.genre-line;
                egg: root.egg;
                centered: true;
            }
        }

        // ── Right / controls ──
        VerticalLayout {
            alignment: start;
            horizontal-stretch: Metrics.tall ? 1 : 0;
            // NAMED AND READ BACK by `cluster-bottom`, which cannot measure the
            // disc directly — see that property. One source for each number.
            spacing: root.cluster-gap;

            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                if !Metrics.tall: VerticalLayout {
                    alignment: center;
                    DrivingStatus {
                        gps-fix: root.gps-fix;
                        in-motion: root.in-motion;
                        osmand-on: root.osmand-on;
                        osmand-linked: root.osmand-linked;
                        egg: root.egg;
                        open-osmand => { root.open-osmand(); }
                    }
                }
                gear := Rectangle {
                    width: 44px; height: 44px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Pal.border;
                    background: Pal.raised;
                    opacity: gear-touch.pressed ? 0.55 : 1.0;
                    gear-touch := TouchArea {
                        clicked => { root.open-settings(); }
                    }
                    // ── THE BAND MARK IN THE GEAR'S PLACE (EASTER-EGGS §12) ──
                    //
                    // Four of the five themes replace it; Led Zeppelin is the
                    // one that does not, and flies an airship in the motion slot
                    // instead. `BandGear::plain` covers both that theme and every
                    // unthemed face, so there is no empty slot to guard against.
                    //
                    // THE SPIRAL IS A PICTURE, the other three are paths. Nine
                    // Inch Nails' mark is seventy-two tapering round-capped
                    // strokes — the same shape as AC/DC's horns and baked for the
                    // same reason — so it ships as an alpha mask and takes the
                    // gear's own colour through `colorize`.
                    if root.egg.gear == BandGear.plain: GearIcon { size: 24px; color: Pal.dim; }
                    if root.egg.gear == BandGear.bolt: BoltIcon { size: 24px; color: Pal.dim; }
                    if root.egg.gear == BandGear.drum: DrumIcon { size: 24px; ink: Pal.dim; }
                    if root.egg.gear == BandGear.smiley: SmileyIcon { size: 24px; ink: Pal.dim; }
                    if root.egg.gear == BandGear.spiral: Image {
                        source: @image-url("art/nin-spiral.png");
                        image-fit: contain;
                        width: 24px; height: 24px;
                        colorize: Pal.dim;
                    }
                }
            }

            // The nearby disc lives HERE on the tall track (the preset band has
            // no room for it), and becomes DONE while reordering. The wide and
            // landscape tracks draw the same control at their own four sizes;
            // see `nearby-disc.slint`.
            if Metrics.tall: HorizontalLayout {
                alignment: end;
                NearbyDisc {
                    size: root.nearby-disc-size;
                    glass-size: Metrics.s(59);
                    tick-size: 22px;
                    label-size: 11px;
                    reordering: root.reordering;
                    open-nearby => { root.open-nearby(); }
                    done-reordering => { root.done-reordering(); }
                }
            }
        }
    }
}
