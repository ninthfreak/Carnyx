// Shapes the Rust side fills in.
//
// Anything that is a DECISION rather than a layout — which four call letters to
// show, which brand colour a station hashes to, what the level readout reads —
// is computed in Rust and arrives here as a finished value. Slint draws; it does
// not decide.

/// Which band mark stands in for the settings gear.
///
/// PARTIAL ON PURPOSE, as `bandArt.tsx`'s own `GEAR_BY_MOTIF` is: Led Zeppelin
/// replaces the vehicle-in-motion tell instead and leaves the gear alone, so it
/// takes `plain` and the ordinary gear is drawn.
export enum BandGear { plain, bolt, drum, smiley, spiral }

/// What a surface draws BEHIND a logo, decided in Rust by `logos::assign`.
///
/// A DARK-ADAPTED LOGO IS NOT ONE PICTURE, it is four, and only three of them
/// are finished. `remap`, `halo` and `as-is` come off the pipeline readable on a
/// near-black card and want nothing behind them; `plate` is deliberately the
/// odd one — the mark is keyed out of its paper and is meant to be set on a
/// light slab this side draws, so its corners stay vector-sharp and its fill can
/// follow the theme. Drawing all four the same way puts a dark mark on a dark
/// card and shows the driver an empty tile.
///
/// The fourth value is not a treatment at all: it is the honest answer for a
/// station whose adaptation has not happened yet.
export enum LogoPlate {
    /// The light face. Whatever the surface already did.
    light,
    /// The dark face with no cached variant — the LIGHT art, kept legible on a
    /// white plate while the adaptation runs. CarFM's `darkFallbackBg`.
    fallback,
    /// The dark face, adapted, `remap` / `halo` / `as-is`: nothing behind it.
    bare,
    /// The dark face, adapted, `plate`: the grey slab, padded and rounded.
    plate,
}

/// One preset, as the band and the peek cards need it.
export struct Preset {
    /// Stored preset name, used for accessibility and as the logo lookup key.
    name: string,
    /// The 4 core call letters — `-FM`/`-AM` and hyphens already stripped
    /// (CarFM `cleanCall`). This is what a no-logo tile prints inside its box.
    call: string,
    freq-mhz: float,
    /// The dial frequency already formatted to one decimal by Rust. Slint's
    /// float-to-string has no precision control, and "88.70000000000001" on a
    /// preset tile is not a thing that can be allowed to happen.
    freq-label: string,
    /// Station colour for the no-logo box, hashed from the callsign in Rust
    /// (CarFM `brandColor`).
    brand: color,
    /// A real logo asset. Empty unless `has-logo`.
    logo: image,
    has-logo: bool,
    /// Which of the four backings `logo` needs. See [`LogoPlate`].
    plate: LogoPlate,
}

/// The hero exactly as it stood BEFORE a preset step — the card that flies out
/// during the morph (§8).
///
/// CarFM does not need this: it FLIPs the peek slot's own DOM node from the
/// hero's rect with a non-uniform transform, so the departing card is the peek,
/// stretched. Nothing here can distort an element, so the outgoing card is a
/// real `HeroCard` and it needs the hero's content — which by the time the morph
/// runs has already been replaced, because Rust tunes synchronously. Captured in
/// `step_morph` before the tune, for the same reason `ghost-preset` is.
///
/// Read off the UI rather than recomputed from the preset list: what has to
/// leave the screen is exactly what the driver was looking at.
export struct HeroSnapshot {
    ident: string,
    freq-label: string,
    logo: image,
    has-logo: bool,
    /// Carried with the art it belongs to. The card that flies out keeps the
    /// backing it was drawn with — recomputing it from the LIVE theme would be
    /// right by accident, and wrong the moment a morph outlives a theme change.
    plate: LogoPlate,
    show-call: bool,
    show-freq: bool,
    saved: bool,
}

/// Which modal is up (ANDROID §6). One value, not four booleans: the four
/// overlays are mutually exclusive, and four flags can contradict each other the
/// way `NearbyState` replaced the picker's overlapping ones.
export enum Overlay {
    none,
    /// §6.2 nearby-stations picker — BOTH tabs. The direct-entry keypad used to be
    /// a fifth value here and its own modal; the mini-handoff folds it into this
    /// one as a tab, so there is nothing left for a `numpad` value to open.
    nearby,
    /// §6.3 settings panel.
    settings,
    /// §6.4 preset logo-search window.
    logo-search,
}

/// A band theme, resolved in Rust from what is playing (Design EASTER-EGGS §12).
///
/// PURELY PRESENTATIONAL, which is §12's own "scale-up rule": a theme may change
/// no layout, no control and no behaviour. Everything below is a colour, a
/// string, or a flag saying whether to draw one extra decoration — nothing here
/// can move a card or take a tap.
///
/// The VALUES live in `src/eggs.rs` and arrive here finished, like every other
/// decision in this file. Slint does not know what AC/DC is; it knows it has
/// been handed a gold genre line, a red accent and an instruction to draw horns.
export struct EggTheme {
    /// A theme is showing. Everything else is meaningless when this is false.
    on: bool,
    /// Replaces the PTY genre line.
    genre: string,
    /// That line's ink, and the colour it pulses to.
    genre-ink: color,
    genre-pulse: color,
    /// A lightning bolt splits the call sign at its midpoint — WI⚡BA.
    call-bolt: bool,
    /// Horns overhanging the hero card's top corners (EASTER-EGGS §2.1).
    horns: bool,
    /// A fan of bolts stands in for the stereo pill's speaker cones. ONE THEME
    /// HAS THIS — the reference gates on its own `stereoArtL` art being named,
    /// and only AC/DC names it, so this is not `on`.
    stereo-bolts: bool,
    /// Hide the station's logo so the lettering carries the card. Without this
    /// there is no call sign on screen for the bolt to split.
    suppress-logo: bool,

    // ── TYPE ──
    //
    // Family names as the bundled files declare them; an EMPTY string is "the
    // ordinary face". Resolved in Rust, because the reference's fallbacks are
    // not uniform — the RadioText face falls back to the body face, the genre
    // face falls back to nothing at all, and the hero face falls back and is
    // then vetoed for one theme.
    body-face: string,
    hero-face: string,
    genre-face: string,
    rt-face: string,
    freq-face: string,
    /// Multipliers and tracking. 1.0 and 0 leave the ordinary metrics.
    hero-scale: float,
    hero-track: length,
    freq-scale: float,
    rt-track: length,
    /// `heroCase: 'lower'` — the call sign is lower-cased. Applied in Rust,
    /// where the string is.
    hero-lower: bool,

    // ── ORNAMENT ──
    /// The second genre string, cross-faded with the first. Empty = no cycle.
    genre-cycle: string,
    /// The four marks stand IN PLACE OF the genre line (Led Zeppelin).
    genre-runes: bool,
    /// `nameGhost` — a hard offset shadow under the hero lettering. A fully
    /// transparent ink is no ghost.
    ghost-ink: color,
    ghost-dx: length,
    ghost-dy: length,
    /// `heroGlitch` — the hero identity twitches sideways on a long loop: still
    /// for 1900ms, then +2dp, −2dp and back over three 55ms legs. Nine Inch
    /// Nails alone.
    hero-glitch: bool,
    /// Which band mark replaces the settings gear. `plain` is the ordinary one,
    /// which is also what Led Zeppelin keeps.
    gear: BandGear,
    /// The vehicle-in-motion tell flies an airship instead of a car.
    airship: bool,

    // ── The per-scheme cut ("Back in Black" is AC/DC's dark one) ──
    //
    // EVERY FIELD BELOW IS SCOPED TO ONE ELEMENT, and a fully transparent colour
    // (or a zero width) means "leave the ordinary token alone" — which is what
    // the light cut hands down for all but the genre outline. The two a theme
    // restates FACE-WIDE, the ground and the accent, go through `Pal` instead,
    // because a dozen components read those and have to turn together.

    /// The HERO CARD's surface — `card.bg` / `card.border` / `card.text`. The
    /// dark cut states `#0B0B0B` behind a `#A2A2A2` border, which no ordinary
    /// token pair would give: a near-black card with a light rule around it.
    card-bg: color,
    card-border: color,
    card-text: color,
    /// The call sign's bolt. Silver on the dark cut; transparent means it takes
    /// the card's own text colour, which is what the light cut does.
    bolt-ink: color,
    /// The hero lettering's outline — `nameOutline`. The call sign AND the
    /// frequency are FILLED with `outline-fill` and held by a hairline of
    /// `outline-ink` at `outline-w`, so the glyph reads as cut out of the card
    /// rather than printed on it. A transparent fill leaves each of them the
    /// colour it would otherwise have — the card's text, and amber; a zero width
    /// is no outline at all, which is the light cut.
    outline-fill: color,
    outline-ink: color,
    outline-w: length,
    /// The RADIOTEXT PLATE — `rtPlate.bg` / `.border` / `.text`. Its own surface,
    /// darker than the card it sits below.
    rt-bg: color,
    rt-border: color,
    rt-text: color,
    /// The genre line's outline. The LIGHT cut is the one that has this
    /// (`genreOutline: #241B0E` at 1), so the gold reads against a pale ground.
    genre-outline-ink: color,
    genre-outline-w: length,
    /// `cardFrame` — up to four concentric rules inset into the hero card's
    /// edge. A zero-alpha colour is an unused slot; The Beatles uses all four.
    ring-1: color, ring-1-inset: length,
    ring-2: color, ring-2-inset: length,
    ring-3: color, ring-3-inset: length,
    ring-4: color, ring-4-inset: length,
    /// `rtPlate.serial` — a catalogue stamp in the RadioText plate's corner.
    rt-serial: string,
}
