// Hero band (ANDROID §4.2) — the primary readout, plus the RadioText strip that
// sits BELOW the card as a sibling, not inside it.
//
// The station row has two forms, decided by whether the tuned station has a real
// logo: the logo REPLACES the big call sign and fills the card, or there is no
// logo and the big call sign stands alone. There is deliberately no monogram tile
// on the hero — the generated cube adds nothing at this size (it still appears on
// preset tiles and peek cards).

import { Pal, Metrics, Font } from "tokens.slint";
import { Preset, HeroSnapshot, EggTheme, LogoPlate } from "types.slint";
import { PeekCard } from "presets.slint";
import { StarIcon, PowerIcon, BoltIcon } from "icons.slint";

// RadioText: static and centred when short, a continuous 16s left ticker beyond
// ~46 characters. Empty shows a dim italic placeholder.
export component RadioTextStrip inherits Rectangle {
    in property <string> text;
    /// The band theme. Its display face carries here as well as onto the hero.
    in property <EggTheme> egg;

    /// `rtSpacing` travels with the face rather than being a separate decision:
    /// a blackletter sets far too tight for a line meant to be read at a glance,
    /// and each theme states its own — 2 for AC/DC and Led Zeppelin, 1 for
    /// Nirvana, 5 for Nine Inch Nails, none for The Beatles.
    property <length> track: root.egg.rt-track;
    property <string> face: root.egg.rt-face != "" ? root.egg.rt-face : Font.face;

    property <bool> has-text: root.text != "";
    property <string> shown: root.has-text ? root.text : "Waiting for RadioText…";
    property <bool> marquee: root.shown.character-count > 46;

    // THE PLATE, which a theme may restate on its own (`rtPlate`) — separately
    // from the hero card above it, and darker: AC/DC's dark cut puts the card at
    // `#0B0B0B` and this at `#070707`. A transparent field means the theme is
    // silent about that colour, so the ordinary token stands.
    property <color> plate-bg: root.egg.rt-bg.alpha > 0 ? root.egg.rt-bg : Pal.raised;
    property <color> plate-edge: root.egg.rt-border.alpha > 0 ? root.egg.rt-border : Pal.border;
    property <color> ink: root.egg.rt-text.alpha > 0 ? root.egg.rt-text : Pal.text;

    // One linear pass per loop; x is derived so a text change re-derives the
    // travel instead of stranding the ticker at a stale offset.
    //
    // DELIBERATE DEVIATION, the only one in this file. The travel below is
    // textWidth + 100, so the second copy lands exactly where the first began.
    // CarFM's RadioTextStrip animates to -trackWidth/2 with trackWidth measured off
    // a row whose `columnGap: 100` puts the gap only BETWEEN the copies — so it
    // travels textWidth + 50 and hitches 50dp once every 16s. Its own comment says
    // "looping seamlessly (the second copy lands where the first began)", so this
    // matches the stated intent rather than the shipped arithmetic. Flagged, not
    // silent: if the hitch is wanted, the travel is the one number to change.
    property <float> phase: 0;
    init => { self.phase = 1; }
    animate phase { duration: 16s; easing: linear; iteration-count: -1; }

    height: Metrics.rt-height;
    border-width: 1px;
    border-radius: 16px;
    border-color: root.plate-edge;
    background: root.plate-bg;
    clip: true;

    if !root.marquee: Text {
        x: 28px;
        width: parent.width - 56px;
        height: parent.height;
        text: root.shown;
        horizontal-alignment: center;
        vertical-alignment: center;
        // Clip at the strip edges like the design's overflow:hidden — never an
        // ellipsis; the references show edge-clipped text, not "…".
        overflow: clip;
        font-family: root.face;
        letter-spacing: root.track;
        font-size: Metrics.rt-font;
        // THE PLACEHOLDER KEEPS THE ORDINARY FACE. "Waiting for RadioText…" is
        // the app talking, not the broadcaster, and a theme that has resolved off
        // a track cannot be showing while there is no track to have resolved off.
        font-italic: !root.has-text;
        // The placeholder's grey stays `Pal.dim` on purpose: `rtPlate` carries a
        // `text` and no `sub`, so the reference leaves this one alone too.
        color: root.has-text ? root.ink : Pal.dim;
    }

    // THE CATALOGUE STAMP, bottom-right of the plate — The Beatles' `rtPlate.serial`
    // and the only theme that has one. Absolutely placed and drawn LAST so it
    // sits over a marquee that scrolls underneath it, exactly as the reference
    // places it (`position: absolute, right: 14, bottom: 6`).
    if root.egg.rt-serial != "": Text {
        x: parent.width - self.preferred-width - 14px;
        y: parent.height - self.preferred-height - 6px;
        text: root.egg.rt-serial;
        font-family: Font.face;
        font-size: Math.max(11px, Metrics.rt-font * 0.4);
        letter-spacing: 1px;
        color: Pal.dim;
    }

    // Two copies with a fixed gap, translating left by half the track so the
    // second copy lands where the first began.
    if root.marquee: Rectangle {
        x: 28px - root.phase * (copy-a.preferred-width + 100px);
        y: 0;
        width: copy-a.preferred-width * 2 + 100px;
        height: parent.height;
        copy-a := Text {
            x: 0;
            width: self.preferred-width;
            height: parent.height;
            vertical-alignment: center;
            text: root.shown;
            font-family: root.face;
            letter-spacing: root.track;
            font-size: Metrics.rt-font;
            color: root.ink;
        }
        Text {
            x: copy-a.preferred-width + 100px;
            width: copy-a.preferred-width;
            height: parent.height;
            vertical-alignment: center;
            text: root.shown;
            font-family: root.face;
            letter-spacing: root.track;
            font-size: Metrics.rt-font;
            color: root.ink;
        }
    }
}

// Audio-priority claim/release (§4.7) — mirrors the star, top-left. A dim outline
// while this app holds priority; solid amber with a white glyph and a slow
// expanding ring once it is released, to draw the eye back. This is NOT a mute.
component PowerButton inherits Rectangle {
    in property <bool> dead: false;
    /// Scales with the hero card it sits on — see HeroCard's `scale`.
    in property <float> scale: 1.0;
    /// Drawn but not tappable — see HeroCard's `inert`.
    in property <bool> inert: false;
    callback toggled();

    property <float> ring: 0;
    init => { self.ring = 1; }
    animate ring { duration: 1800ms; easing: ease-out; iteration-count: -1; }

    width: Metrics.star * root.scale;
    height: Metrics.star * root.scale;
    border-radius: Metrics.s(16) * root.scale;
    background: root.dead ? Pal.power-on : transparent;
    border-width: root.dead ? 0px : 1px * root.scale;
    border-color: Pal.border;
    opacity: touch.pressed ? 0.6 : 1.0;

    if root.dead: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Metrics.star * root.scale * (1 + 0.9 * root.ring);
        height: self.width;
        border-radius: Metrics.s(16) * root.scale * (1 + 0.9 * root.ring);
        background: Pal.power-on;
        opacity: root.ring < 0.7 ? 0.5 * (1 - root.ring / 0.7) : 0;
    }
    touch := TouchArea {
        enabled: !root.inert;
        clicked => { root.toggled(); }
    }
    PowerIcon {
        size: Math.round(Metrics.star / 1px * 0.58) * 1px * root.scale;
        color: root.dead ? #FFFFFF : Pal.dim;
    }
}

// A real logo on the hero. Fixed HEIGHT (it grows as the call sign and frequency
// are hidden); the plate hugs the logo's own width so square badges and wide
// wordmarks both sit tight instead of floating in an empty box.
component HeroLogo inherits Rectangle {
    in property <image> logo;
    in property <length> logo-h;
    in property <length> max-w;
    in property <float> scale: 1.0;
    /// Which backing this art needs, decided in Rust. See `LogoPlate`.
    in property <LogoPlate> plate: LogoPlate.light;

    // Before the source is known, assume the 16/10 landscape shape the rest of
    // the face uses for logo plates, so the plate can never render one frame at
    // the full card width as a white flash and then snap in.
    property <float> aspect: (root.logo.height > 0)
        ? (root.logo.width / root.logo.height) : 1.6;

    // ── THE PLATE, WHICH THE HERO SIZES ITSELF ──
    //
    // The white paper is 8dp either side and 4dp top and bottom — the hero's own
    // numbers, and the ones this card has always drawn. The grey `plate` slab is
    // a FRACTION OF THE LOGO instead, and a bigger one than any other surface
    // uses: 0.11 where `plate_params()` says 0.09, which is the reference's
    // `HeroLogo` (`px = Math.round(height * 0.11)`) and not a typo for the stage
    // constant. A keyed mark at hero size needs the extra breathing room.
    //
    // `logo-h` already carries the card's morph scale, so the fractions must not
    // multiply by it again; the two fixed dp must.
    property <bool> plated: root.plate == LogoPlate.plate;
    property <length> pad-x: root.plated
        ? Math.round(root.logo-h / 1px * 0.11) * 1px
        : (root.plate == LogoPlate.bare ? 0px : 8px * root.scale);
    property <length> pad-y: root.plated
        ? root.pad-x
        : (root.plate == LogoPlate.bare ? 0px : 4px * root.scale);

    // ── THE PLATE MAY NOT GROW THE CARD, and the reference's would ──
    //
    // A DELIBERATE DEVIATION, and the only one here. CarFM pins the IMAGE to
    // `heroLogoH` and lets the plate shrink-wrap it, so the outer box grows with
    // the padding: 4dp for the white paper, 0.11 of the logo for the grey slab.
    // On a logo-only hero at the wide track `logo-h` is 256 against a card that
    // measures 262 — the white plate fills it exactly — so the grey one would
    // stand 48dp taller than the card that contains it. Faithful, and visibly
    // broken.
    //
    // So the OUTER box is fixed at what the light plate takes, which is what the
    // card was laid out around, and the IMAGE gives up the difference. Every
    // proportion the reference states survives — 0.11 padding, 0.14 radius, the
    // logo's own aspect — and none of them can reach the card's geometry. The
    // light and fallback cases resolve to exactly the arithmetic that was here
    // before, so an unthemed hero is untouched.
    property <length> box-h: root.logo-h + 8px * root.scale;
    property <length> art-h: Math.min(root.logo-h, root.box-h - root.pad-y * 2);

    width: Math.min(root.max-w, Math.round(root.art-h / 1px * root.aspect) * 1px) + root.pad-x * 2;
    height: root.art-h + root.pad-y * 2;
    border-radius: root.plated
        ? Math.round(root.logo-h / 1px * 0.14) * 1px
        : Metrics.s(16) * root.scale;
    // WHITE IS THE FALLBACK, NOT THE DEFAULT, on a face that can be either
    // theme. Light keeps the paper the artwork was drawn for; a dark face with
    // no variant yet keeps it too, so the logo stays visible while the
    // adaptation runs; an adapted `remap`/`halo`/`as-is` needs nothing behind
    // it and gets nothing; `plate` gets the grey slab.
    background: root.plated
        ? Pal.logo-plate
        : (root.plate == LogoPlate.bare ? transparent : Pal.logo-fallback);
    clip: true;

    Image {
        source: root.logo;
        image-fit: contain;
        width: parent.width - root.pad-x * 2;
        height: root.art-h;
    }
}

// One rule of a themed card frame. `bandArt.tsx`'s `CardFrame`: 1.4dp, inset on
// all four sides, radius following the card's less the inset.
component CardRing inherits Rectangle {
    in property <color> ink;
    in property <length> inset;
    in property <length> radius;
    /// The card's own box. Handed in rather than read off `parent`, which a
    /// component cannot reach from its own root.
    in property <length> card-w;
    in property <length> card-h;

    x: root.inset; y: root.inset;
    width: root.card-w - root.inset * 2;
    height: root.card-h - root.inset * 2;
    border-width: 1.4px;
    border-color: root.ink;
    border-radius: Math.max(0px, root.radius - root.inset);
}

export component HeroCard inherits Rectangle {
    /// The band theme now showing, or one with `on: false`. See `EggTheme`.
    in property <EggTheme> egg;
    /// Is the card carrying LETTERING rather than art? True with no logo, and
    /// true with one the theme suppresses. Declared here on `root` rather than
    /// beside its use: a property belongs to the element that owns it, and
    /// putting it inside a child left `root.lettering` naming nothing.
    property <bool> lettering: !root.scanning
        && (!root.has-logo || root.egg.suppress-logo)
        && root.ident != "";
    /// `heroScale` — 1.3 for Led Zeppelin and Nine Inch Nails, 1.5 for Nirvana,
    /// 1 for the rest. A display cut set at the body face's size reads small.
    ///
    /// ZERO IS "UNSTATED", NOT ZERO, and that guard is not decoration: an
    /// unthemed face gets `EggTheme::default()`, every float in a Slint struct
    /// defaults to 0, and multiplying by it collapsed the call sign and the
    /// frequency to nothing on EVERY face without a theme. Caught by the shot
    /// comparison — thirty-seven unthemed shots moved for a change that should
    /// have touched five.
    property <float> hero-mul: root.egg.hero-scale > 0 ? root.egg.hero-scale : 1.0;
    /// The call sign's size BEFORE the fit and after it. See `fit`.
    property <length> call-size-nat: Metrics.call-size * root.scale * root.hero-mul;
    property <length> call-size: root.call-size-nat * root.fit;
    /// The frequency's, likewise. `freqScale` is stated by Nine Inch Nails alone,
    /// at 0.95; zero is "unstated" for the same reason `hero-scale` is.
    property <length> freq-size-nat: Metrics.freq-size * root.scale
        * (root.egg.freq-scale > 0 ? root.egg.freq-scale : 1.0);
    property <length> freq-size: root.freq-size-nat * root.fit;
    /// `heroTrack` — stated only by Nine Inch Nails, at 9dp. Everything else
    /// keeps the -1 the ordinary call sign has always had.
    property <length> call-track: root.egg.hero-track > 0px
        ? root.egg.hero-track * root.scale
        : -1px * root.scale;
    /// The theme's hero face, or the ordinary one.
    ///
    /// EMPTY IS A REAL CASE, not just a default: The Beatles names SgtPeppers
    /// here and the reference vetoes it (`motif !== 'submarine'`) because §4
    /// records that cut as unfinished, so a Beatles hero is Atkinson while its
    /// tiles and RadioText are YellowSubmarine.
    property <string> call-face: root.egg.hero-face != "" ? root.egg.hero-face : Font.face;

    /// THE CARD'S OWN SURFACE, which a theme restates for this element and no
    /// other (`card.bg` / `.border` / `.text`). AC/DC's dark cut is a `#0B0B0B`
    /// card inside a `#A2A2A2` rule — a near-black panel with a LIGHT edge, which
    /// is nothing the ordinary token pair can express. A transparent field means
    /// the theme is silent, so the ordinary token stands and an unthemed card is
    /// exactly what it was.
    property <color> surface: root.egg.card-bg.alpha > 0 ? root.egg.card-bg : Pal.panel;
    property <color> edge: root.egg.card-border.alpha > 0 ? root.egg.card-border : Pal.border;
    property <color> ink: root.egg.card-text.alpha > 0 ? root.egg.card-text : Pal.text;
    /// The bolt takes the lettering's colour unless the theme names one — the
    /// reference states it as `dark ? '#C9C9C9' : heroCardText`, so the light cut
    /// leaves it transparent and falls through to exactly that.
    ///
    /// NOT `lettering` BELOW, DELIBERATELY. Under the outline treatment the call
    /// sign is filled in the card's own black and the bolt sits between its two
    /// halves — inheriting that fill would erase it. The reference hits the same
    /// wall and answers the same way: "the bolt inherits that through
    /// currentColor — so it needs its own fill there", and gives it the
    /// outline's STROKE.
    property <color> bolt: root.egg.bolt-ink.alpha > 0 ? root.egg.bolt-ink : root.ink;

    /// What the call sign and the frequency are actually painted in.
    ///
    /// `nameOutline.fill` when a theme states one, and the ordinary colour
    /// otherwise — the card's text for the lettering, amber for the frequency.
    /// AMBER IS A FIXED SAFETY COLOUR AND THIS IS ITS ONE EXCEPTION: §2.1 says
    /// "call sign + frequency filled `#0B0B0B` with a 1.1px `#C9C9C9` outline",
    /// the prototype spreads `outlineFx` over `freqStyle` AFTER its `color:
    /// t.amber` so the fill wins, and `screenshots/egg-acdc-dark.png` renders
    /// 88.7 hollow rather than gold. Stated three times over, so it is the rule
    /// and not an oversight.
    property <color> lettering-ink: root.egg.outline-fill.alpha > 0
        ? root.egg.outline-fill
        : root.ink;
    property <color> freq-ink: root.egg.outline-fill.alpha > 0
        ? root.egg.outline-fill
        : Pal.amber;

    /// The call sign already cut in two for the AC/DC bolt to stand between.
    ///
    /// SPLIT IN RUST, because Slint has no substring: a string here can be
    /// measured and drawn but not sliced. That suits the house rule anyway —
    /// where to cut "WIBA" is a decision, and decisions are made on the other
    /// side of this boundary. Both are empty unless the bolt is showing.
    in property <string> ident-a;
    in property <string> ident-b;
    in property <string> ident;
    in property <string> freq-label;
    in property <image> logo;
    in property <bool> has-logo: false;
    /// What goes behind `logo`, decided in Rust. See `LogoPlate`.
    in property <LogoPlate> logo-plate: LogoPlate.light;
    /// Per-station hero options (§6.4). Both default OFF for a station that HAS a
    /// logo, so the logo fills the card; a no-logo hero always shows both.
    in property <bool> show-call: true;
    in property <bool> show-freq: true;
    in property <bool> saved: false;
    in property <bool> dead: false;
    /// The client-side FCC sweep is running: the identity reads "Scanning…" and
    /// the digits slide as the dial steps.
    ///
    /// NOTHING SETS THIS TODAY, and that is correct rather than unfinished. On the
    /// built-in tuner CarFM hands the seek to the hardware and animates nothing —
    /// "the landed frequency arrives via the tuner callback, so there's no
    /// client-side sweep to animate here" (CarFmFace.tsx:918-921) — and the
    /// built-in tuner is the only one this app has. The branches below are that
    /// client-side sweep, which belongs to the SDR path Carnyx has not built. Said
    /// out loud so the next reader does not take an unreachable branch for a bug.
    in property <bool> scanning: false;
    in property <int> scan-dir: 0;

    /// THE CARD'S UNIFORM SCALE — the whole of #75, and what lets the step morph
    /// be a FLIP instead of a slide.
    ///
    /// Slint 1.17.1 is the newest there is and exposes no scale transform to user
    /// code (`Transform` carries `//-is_internal`), so this card is scaled by
    /// ARITHMETIC: every dimension below multiplies through this one number —
    /// padding, corner radius, border, shadow, the logo plate, the star, the
    /// power button and all three font sizes. That is what makes it animatable as
    /// a unit, and it is the same trick `PeekCard` already uses.
    ///
    /// A previous note here said this was infeasible because a marquee measures
    /// its own text. That was wrong: the marquee is `RadioTextStrip`, a SIBLING of
    /// this card, not a child of it. The two gauges below DO measure text, and
    /// they multiply through this number like everything else — their font sizes
    /// carry `root.scale` and the height they are compared against arrives
    /// pre-scaled, so the ratio they produce is the same at every size.
    in property <float> scale: 1.0;

    /// Drawn, but it takes no taps.
    ///
    /// For the OUTGOING card in the step morph, which spends the first stretch
    /// of its flight covering the hero's own rect: its star and its power button
    /// would otherwise swallow taps meant for the card underneath — and a save
    /// or an audio release aimed at the station now playing would land on the
    /// one that just left. (The frequency stopped being a tap target when the
    /// numpad became a tab; the star and the power button are what is left.)
    /// `PeekCard` carries the same property for the same reason.
    in property <bool> inert: false;

    callback toggle-save();
    callback toggle-audio();

    property <bool> tall: Metrics.tall;
    property <length> pad-v: Metrics.s(root.tall ? 30 : 24) * root.scale;
    property <length> pad-h: Metrics.s(root.tall ? 26 : 30) * root.scale;
    property <length> corner: Metrics.s(root.tall ? 16 : 18) * root.scale;

    // Hero logo growth (LOGO-SIZING §2.1): three tiers, stepping up as the call
    // sign and frequency rows are hidden. Both hidden is the logo default and the
    // largest. Landscape is its own branch, not the generic wide one. Capped so a
    // logo can never eat a short surface's whole card.
    property <int> hidden: (root.show-call ? 0 : 1) + (root.show-freq ? 0 : 1);
    property <length> logo-h: Math.min(
        Metrics.s(root.hidden == 0
            ? (root.tall ? 108 : Metrics.landscape ? 120 : 144)
            : root.hidden == 1
                ? (root.tall ? 152 : Metrics.landscape ? 171 : 205)
                : (root.tall ? 188 : Metrics.landscape ? 215 : 256)),
        Math.round(Metrics.h * 0.42) * 1px) * root.scale;
    property <length> logo-max-w: root.width - Metrics.s(root.tall ? 52 : 60) * root.scale;

    // ── THE FIT: A THEMED HERO TAKES NO MORE ROOM THAN AN ORDINARY ONE ──
    //
    // `heroScale` sets a display cut at the size the body face reads at — 1.3 for
    // Led Zeppelin and Nine Inch Nails, 1.5 for Nirvana — and on the wide track
    // the card it lands in is 98% of the hero row and does NOT grow with it
    // (CarFM says the same: `heroCardWide: { height: '98%' }`). MEASURED ON THE
    // SHOTS, Led Zeppelin's frequency finished 15px BELOW the card's bottom edge,
    // Nirvana's 2px below, Nine Inch Nails' 2px inside it, against 26px of
    // clearance on an unthemed card. The digits were drawn outside the panel they
    // belong to. Same answer the genre line got when its string ran long: give up
    // POINTS before giving up the content.
    //
    // THE YARDSTICK IS THE ORDINARY HERO, NOT THE CARD, and that took a wrong
    // turn to learn. Measuring the content against the card's inner height looks
    // obviously right and is not: an UNTHEMED card's two line boxes already come
    // to 234dp inside a 213dp box and it renders perfectly, because a layout that
    // is short of room compresses leading long before it touches ink. Fitting to
    // the card therefore shrank every ordinary station on the face by 9% to solve
    // a problem five themes have. What the card can hold is exactly what it is
    // already known to hold, so that is what a theme is held to: the SAME two
    // line boxes set in the ordinary face at the ordinary size.
    //
    // It leaves the scale-up intact — Kashmir still lands at 1.13x, Gridnik 1.27,
    // Onyx 1.38 — and it is a no-op for AC/DC and The Beatles, whose heroes are
    // already at or under the ordinary height.
    //
    // WHY MEASURE AT ALL, RATHER THAN CAP `hero-scale`. The faces are not
    // interchangeable at a size: Nirvana overflows at 1.5x with 103px of ink
    // where Nine Inch Nails overflows at 1.3x with 80px, because Onyx, Kashmir
    // and Gridnik each carry their own ascent and descent. The multiplier does
    // not predict the overflow; the line box does.
    //
    // NOT A CYCLE, by the same split the genre gauge uses: all four gauges are
    // pinned to `Metrics` and the theme, and depend on no layout — not even the
    // card's own height, which is why the tall track needs no exemption. The
    // gauges feed `fit`; the drawn text reads `fit`. Nothing reads back.
    /// Each term is dropped when its row is not drawn: a card carrying a LOGO has
    /// no call-sign line, and holding its frequency against one that is not there
    /// would be a fit against nothing.
    property <bool> freq-shown: root.scanning || root.show-freq || root.ident == "";
    /// THE TWO LINE BOXES ALONE. The layout spacing between them and the
    /// frequency's 6dp lead-in are the same constants on both sides of the ratio
    /// and do not scale with the type, so carrying them would under-shrink by
    /// exactly their weight.
    property <length> fit-natural:
        (root.lettering ? call-gauge.preferred-height : 0px)
        + (root.freq-shown ? freq-gauge.preferred-height : 0px);
    property <length> fit-plain:
        (root.lettering ? call-plain.preferred-height : 0px)
        + (root.freq-shown ? freq-plain.preferred-height : 0px);
    property <float> fit: (root.fit-natural > root.fit-plain && root.fit-natural > 0px)
        ? root.fit-plain / root.fit-natural
        : 1.0;

    // EXPLICIT GEOMETRY KEEPS A GAUGE OUT OF THE FOLD — the rule the genre
    // gauge and the STEREO pill's invisible reserve both rely on. `visible: false`
    // rather than `opacity: 0`: an invisible element still reports a preferred
    // size and, unlike a transparent one, costs no layer and no draw.
    //
    // THE STRINGS ARE THE DRAWN ONES, because a line box is a property of the
    // glyphs in it — a face whose digits carry a descender measures taller than
    // its capitals do, and the frequency is all digits. Both pairs read the same
    // two strings so the ratio compares like with like.
    call-gauge := Text {
        x: 0px; y: 0px; width: 0px; height: 0px;
        visible: false;
        text: root.ident;
        font-family: root.call-face; font-weight: Font.bold;
        font-size: root.call-size-nat;
    }
    freq-gauge := Text {
        x: 0px; y: 0px; width: 0px; height: 0px;
        visible: false;
        text: root.freq-label;
        font-family: root.egg.freq-face != "" ? root.egg.freq-face : root.call-face;
        font-weight: Font.bold;
        font-size: root.freq-size-nat;
    }
    /// The same two lines as an unthemed card sets them. This pair is what the
    /// card is known to hold.
    call-plain := Text {
        x: 0px; y: 0px; width: 0px; height: 0px;
        visible: false;
        text: root.ident;
        font-family: Font.face; font-weight: Font.bold;
        font-size: Metrics.call-size * root.scale;
    }
    freq-plain := Text {
        x: 0px; y: 0px; width: 0px; height: 0px;
        visible: false;
        text: root.freq-label;
        font-family: Font.face; font-weight: Font.bold;
        font-size: Metrics.freq-size * root.scale;
    }

    // ── `heroGlitch` — A MACHINE THAT DOES NOT QUITE LOCK (Nine Inch Nails) ──
    //
    // The reference states the movement, not just the flag: `GlitchWrap`
    // (CarFmFace.tsx:407) holds the identity still for 1900ms, then runs three
    // 55ms legs — +2dp, −2dp, back to zero — and repeats, "a DELIBERATELY subtle
    // periodic horizontal jitter … never sustained, so the type stays readable".
    // A dashboard is the one surface where that last clause is not negotiable,
    // so the amplitude and the duty cycle are transcribed rather than tuned.
    //
    // IT NEEDS NO TRANSFORM, and the claim that it did was this file's own error
    // — written off by reading `translateX` and stopping there. What that
    // translates is the hero identity, and the hero identity here is a `Text`
    // inside a box that already sets its own `x` for the ghost's sake. Moving it
    // is an offset on a coordinate.
    //
    // ONE STEPPED SAWTOOTH, not a timer and not a state. `glitch-turn` runs
    // 0 → 1 on the cycle's own length and the legs are read off it as hard
    // steps, which is also closer to the intent than an interpolated slide: a
    // glitch snaps. It is READ only while a glitching theme is showing — the
    // guard below short-circuits — so every other face never depends on the
    // animation and never redraws for it, the same rule the genre pulse follows.
    property <float> glitch-turn: 0;
    init => { self.glitch-turn = 1.0; }
    animate glitch-turn {
        duration: 2065ms; easing: linear; iteration-count: -1;
    }
    /// THE LIVE LETTERING MOVES AND ITS GHOST DOES NOT, which is a deviation and
    /// the reason for it is that the ghost is a different KIND of thing here. In
    /// RN it is `textShadow` on the very Text being translated, so it cannot do
    /// anything but travel with it — and a whole word stepping 2dp sideways is
    /// invisible without something to step against. On this side the ghost is a
    /// real second impression, so the twitch is what pulls the two apart: the
    /// register slips and comes back. That is what `nameGhost` is describing.
    property <length> glitch-dx: !root.egg.hero-glitch ? 0px
        : root.glitch-turn < 0.9201 ? 0px
        : root.glitch-turn < 0.9467 ? 2px * root.scale
        : root.glitch-turn < 0.9734 ? -2px * root.scale
        : 0px;

    border-width: 1px * root.scale;
    border-radius: 28px * root.scale;
    border-color: root.edge;
    background: root.surface;
    drop-shadow-blur: root.dead ? 0px : 22px * root.scale;
    drop-shadow-offset-y: root.dead ? 0px : 14px * root.scale;
    drop-shadow-color: #0000002E;

    VerticalLayout {
        padding-top: root.pad-v;
        padding-bottom: root.pad-v;
        padding-left: root.pad-h;
        padding-right: root.pad-h;
        spacing: Metrics.s(14) * root.scale;
        alignment: center;

        if root.scanning: Text {
            text: "Scanning…";
            horizontal-alignment: center;
            font-family: Font.face; font-weight: Font.bold;
            font-italic: true;
            font-size: Metrics.call-size * root.scale;
            letter-spacing: root.call-track;
            color: Pal.dim;
        }

        // Real logo REPLACES the big call sign; the call sign becomes a small
        // label beneath it.
        // THE THEME CAN HIDE A REAL LOGO, and must be able to: AC/DC's whole
        // card is the lettering, and a station that has art would otherwise never
        // show a call sign for the bolt to split. CarFM's `suppressLogos`.
        if !root.scanning && root.has-logo && !root.egg.suppress-logo: VerticalLayout {
            spacing: 8px * root.scale;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                HeroLogo {
                    logo: root.logo;
                    logo-h: root.logo-h;
                    max-w: root.logo-max-w;
                    scale: root.scale;
                    plate: root.logo-plate;
                }
            }
            if root.show-call && root.ident != "": Text {
                text: root.ident;
                horizontal-alignment: center;
                overflow: elide;
                font-family: Font.face; font-weight: Font.bold;
                font-size: Metrics.s(root.tall ? 22 : 26) * root.scale;
                letter-spacing: 0.5px * root.scale;
                color: Pal.dim;
            }
        }

        // No real logo: the big call sign, no monogram tile. When nothing has
        // resolved (built-in tuner with no GPS lock yet) this is empty and the
        // frequency below stands as the identity — never an inaccurate "Tuning…".
        //
        // A BOX AROUND ONE LINE OF TEXT, and the box is what `nameGhost` needs.
        // The ghost is a second impression of the identity printed off register
        // beneath the first — Nirvana 3/3 down in 20% black, Nine Inch Nails 2/0
        // in 16%: a photocopy that did not quite line up, and a machine that did
        // not quite lock. It has to be OFFSET, and a child of a VerticalLayout
        // cannot set its own `y`, so both impressions live in one slot here and
        // position themselves inside it. The box takes its height from the live
        // line, so the ghost can never grow the card.
        if root.lettering && !root.egg.call-bolt: Rectangle {
            height: live-call.preferred-height;

            if root.egg.ghost-ink.alpha > 0: Text {
                x: root.egg.ghost-dx * root.scale;
                y: root.egg.ghost-dy * root.scale;
                width: parent.width;
                text: root.ident;
                horizontal-alignment: center;
                overflow: elide;
                font-family: root.call-face; font-weight: Font.bold;
                font-size: root.call-size;
                letter-spacing: root.call-track;
                color: root.egg.ghost-ink;
            }

            live-call := Text {
            x: root.glitch-dx; y: 0; width: parent.width;
            text: root.ident;
            horizontal-alignment: center;
            overflow: elide;
            font-family: root.call-face; font-weight: Font.bold;
            font-size: root.call-size;
            letter-spacing: root.call-track;
            color: root.lettering-ink;
            // ── `nameOutline`, AND WHY THIS IS `center` ──
            //
            // CENTRED IS WHAT THE REFERENCE DOES. `-webkit-text-stroke` straddles
            // the glyph edge — half the width inside, half outside — so a centred
            // stroke is the faithful one, and `outside` was a guess dressed up as
            // a reason ("so the letterform keeps its own weight").
            //
            // IT IS ALSO THE ONLY ONE SLINT 1.17.1's SOFTWARE RENDERER DRAWS.
            // Measured: with `outside`, the peak coverage over a `#0B0B0B` ground
            // is 57/201 — a quarter — and it does not change between width 0 and
            // width 4. With `center` the same text reaches the full 201. The
            // outlined call sign had been shipping as a hairline ghost because of
            // it, and it was misread twice as a missing typeface.
            //
            // `stroke-width` IS IGNORED by that renderer either way — 0, 0.5, 1.1,
            // 2 and 8 all ink exactly 4234 pixels. It is kept because it is the
            // design's value, because a zero width still has to mean "no outline",
            // and because the device renders with SKIA, which this container
            // cannot run. What the shots show for stroke WEIGHT is therefore not
            // evidence about the unit; what they show for stroke PRESENCE is.
            stroke: root.egg.outline-ink;
            stroke-width: root.egg.outline-w * root.scale;
            stroke-style: center;
            }
        }

        // WI⚡BA — the bolt splits the call sign at its midpoint.
        //
        // A ROW OF THREE, not a glyph inside the string. The bolt is traced art
        // and there is no character for it; drawing it as an element between two
        // halves is also what keeps it scaling with the card during a morph,
        // since everything here multiplies by `root.scale`.
        if root.lettering && root.egg.call-bolt: HorizontalLayout {
            alignment: center;
            spacing: 0px;
            Text {
                text: root.ident-a;
                vertical-alignment: center;
                font-family: root.call-face; font-weight: Font.bold;
                font-size: root.call-size;
                letter-spacing: root.call-track;
                color: root.lettering-ink;
                stroke: root.egg.outline-ink;
                stroke-width: root.egg.outline-w * root.scale;
                stroke-style: center;
            }
            Rectangle {
                width: root.call-size * 0.74;
                height: root.call-size * 1.05;
                BoltIcon {
                    size: root.call-size * 0.74;
                    color: root.bolt;
                }
            }
            Text {
                text: root.ident-b;
                vertical-alignment: center;
                font-family: root.call-face; font-weight: Font.bold;
                font-size: root.call-size;
                letter-spacing: root.call-track;
                color: root.lettering-ink;
                stroke: root.egg.outline-ink;
                stroke-width: root.egg.outline-w * root.scale;
                stroke-style: center;
            }
        }

        // Always show the frequency when there is no name, even if the user turned
        // the frequency line off — otherwise the hero would be blank.
        if root.freq-shown: Rectangle {
            height: freq.preferred-height + 6px * root.scale;
            freq := Text {
                y: 6px * root.scale;
                width: parent.width;
                text: root.freq-label;
                horizontal-alignment: center;
                // THE THEME'S FACE REACHES THE FREQUENCY. The prototype's
                // `freqStyle` falls through `eggFreqFont || eggHeroFont ||
                // eggFont`, so a theme with no frequency face of its own still
                // lands its general one — Squealer here, which is why
                // `screenshots/egg-acdc-dark.png` sets 88.7 in blackletter.
                //
                // THIS WAS BLAMED ON THE FONT AND IT WAS NEVER THE FONT. Squealer
                // maps all of ASCII, digits and full stop included (201
                // codepoints, checked against its own `cmap`), and it was
                // rendering here all along. The outline was faint for the reason
                // given on the call sign above, which is the same reason it was
                // faint there — and the call sign's own outline reading as solid
                // was the BOLT being measured, not the stroke.
                // `freqFont` / `freqScale`. Nine Inch Nails is the only theme
                // that names a frequency face — Singothic at 0.95 — but the
                // reference falls through `eggFreqFont || eggHeroFont || eggFont`,
                // so a theme with none still lands its hero face here. That is
                // why AC/DC's 88.7 is Squealer in `egg-acdc-dark.png`.
                font-family: root.egg.freq-face != "" ? root.egg.freq-face : root.call-face;
                font-weight: Font.bold;
                font-size: root.freq-size;
                letter-spacing: root.egg.on ? 1px * root.scale : 0px;
                color: root.freq-ink;
                stroke: root.egg.outline-ink;
                stroke-width: root.egg.outline-w * root.scale;
                stroke-style: center;
            }
            // NO TOUCH AREA. The frequency used to open a standalone keypad modal;
            // the mini-handoff (§2, §7) removes that entry point outright — the
            // keypad is a tab inside the tune overlay now, reached from the status
            // bar's nearby button, and this line is display-only text with no
            // pressed state and no pointer affordance.
        }
    }

    // The star ALWAYS sits in the card's top-right corner, on both tracks — never
    // inline with the station identity. It is not part of the centred group.
    if !root.scanning: Rectangle {
        x: root.width - root.corner - Metrics.star * root.scale;
        y: root.corner;
        width: Metrics.star * root.scale;
        height: Metrics.star * root.scale;
        border-radius: Metrics.s(16) * root.scale;
        background: root.saved ? Pal.blue-fill : transparent;
        border-width: root.saved ? 0px : 1px * root.scale;
        border-color: Pal.border;
        opacity: star-touch.pressed ? 0.55 : 1.0;
        star-touch := TouchArea {
            enabled: !root.inert;
            clicked => { root.toggle-save(); }
        }
        StarIcon {
            size: Metrics.s(30) * root.scale;
            filled: root.saved;
            color: Pal.amber;
            outline: Pal.dim;
        }
    }

    // §4.7: a light grey veil over the hero card when priority is released. The
    // power button is drawn ABOVE it, in full colour — the one element that keeps
    // its colour on a dead face.
    if root.dead: Rectangle {
        border-radius: 28px * root.scale;
        background: Pal.hero-veil;
    }

        // ── HORNS (Design EASTER-EGGS §2.1) ──
    //
    // They OVERHANG the card's top corners, which is why they are placed with
    // negative offsets rather than laid out: the reference has them breaking
    // the card's outline, and a horn tucked politely inside it reads as a
    // sticker instead of the card having grown them.
    //
    // BAKED TO PNG, not drawn. Each horn is sixty tapered round-capped strokes
    // under a Gaussian drop-shadow in the source SVG — a hundred and twenty
    // `Path` elements across the pair, on a unit that draws a whole frame every
    // 131ms. `tools/bake-acdc-horns.py` renders them from that same SVG at 4x
    // and the result is two images.
    //
    // Scaled by `root.scale` like everything else on the card, so they shrink
    // with it through a morph instead of staying full size on a peek-sized card.
    // ── `cardFrame` — THE DRUM HOOP (The Beatles) ──
    //
    // Four concentric rules inset into the card's edge, each its own colour and
    // its own inset: cream, blue, cream, red. Four inert rectangles rather than a
    // border stack, because a border is one colour and this is four rules with
    // gaps between them. Every radius follows the card's own less the inset, so
    // the hoop stays concentric as the card scales through a morph.
    if root.egg.ring-1.alpha > 0: CardRing { ink: root.egg.ring-1; inset: root.egg.ring-1-inset * root.scale; radius: root.border-radius; card-w: root.width; card-h: root.height; }
    if root.egg.ring-2.alpha > 0: CardRing { ink: root.egg.ring-2; inset: root.egg.ring-2-inset * root.scale; radius: root.border-radius; card-w: root.width; card-h: root.height; }
    if root.egg.ring-3.alpha > 0: CardRing { ink: root.egg.ring-3; inset: root.egg.ring-3-inset * root.scale; radius: root.border-radius; card-w: root.width; card-h: root.height; }
    if root.egg.ring-4.alpha > 0: CardRing { ink: root.egg.ring-4; inset: root.egg.ring-4-inset * root.scale; radius: root.border-radius; card-w: root.width; card-h: root.height; }

    if root.egg.horns: Image {
        source: @image-url("art/acdc-horn-left.png");
        image-fit: contain;
        width: Metrics.s(70) * root.scale;
        height: Metrics.s(96) * root.scale;
        // CarFM: `top: L.s(-44), left: L.s(-16)`, through the same design ramp.
        x: -Metrics.s(16) * root.scale;
        y: -Metrics.s(44) * root.scale;
    }
    if root.egg.horns: Image {
        source: @image-url("art/acdc-horn-right.png");
        image-fit: contain;
        width: Metrics.s(70) * root.scale;
        height: Metrics.s(96) * root.scale;
        // CarFM: `top: L.s(-44), right: L.s(-16)` — anchored to the card's RIGHT
        // edge, so the offset is measured from there.
        x: parent.width - self.width + Metrics.s(16) * root.scale;
        y: -Metrics.s(44) * root.scale;
    }

    if !root.scanning: PowerButton {
        x: root.corner;
        y: root.corner;
        scale: root.scale;
        inert: root.inert;
        dead: root.dead;
        toggled => { root.toggle-audio(); }
    }
}

// The hero row: the card, flanked by the previous and next presets as peek cards
// that tuck UNDER it. They flank it on BOTH tracks whenever a previous/next
// preset exists — tucked in tighter on tall than on wide.
export component HeroRow inherits Rectangle {
    /// The band theme, handed to every card this row can build.
    in property <EggTheme> egg;
    in property <string> ident-a;
    in property <string> ident-b;
    in property <Preset> prev-preset;
    in property <Preset> next-preset;
    /// The station the discarded peek held BEFORE the step, captured by Rust in
    /// `step_morph` while the geometry is still at rest. CarFM clones the DOM
    /// node for this; there is no cloning here, so the content is carried across
    /// instead and drawn as a ghost that fades out.
    in property <Preset> ghost-preset;
    /// The hero as it stood BEFORE the step — what the OUTGOING card draws.
    /// Captured by Rust in `step_morph` alongside `ghost-preset`, and for the
    /// same reason: by the time the morph runs the hero already holds the new
    /// station, so the old one has to have been carried across.
    in property <HeroSnapshot> outgoing;
    /// Whether the landing slot CHANGES HANDS this step.
    ///
    /// False when its occupant is the same card before and after. Stepping
    /// forward off an unsaved dial is the case: `push_hero` shows the last entry
    /// on the left and the first on the right, so landing on entry 0 leaves the
    /// prev slot showing the last entry — exactly what was already there.
    ///
    /// GATES BOTH THE GHOST AND THE FLIGHT. A first cut wired it to the ghost
    /// only, which suppressed the fade of nothing but still FLIPPED the unchanged
    /// card up to the hero's footprint and back, leaving its own slot empty for
    /// the whole 520ms while the station that actually departed — the unsaved
    /// dial — was not animated at all.
    in property <bool> hand-off: true;
    in property <bool> has-prev: false;
    in property <bool> has-next: false;
    in property <length> card-w;
    /// Wide tracks give the row its height and the card fills 98% of it; the tall
    /// track gives the row nothing and the card sizes to its own content.
    in property <bool> card-fill: true;

    in property <string> ident;
    in property <string> freq-label;
    in property <image> logo;
    in property <bool> has-logo: false;
    in property <LogoPlate> logo-plate: LogoPlate.light;
    in property <bool> show-call: true;
    in property <bool> show-freq: true;
    in property <bool> saved: false;
    in property <bool> dead: false;
    in property <bool> scanning: false;

    callback step(int);
    callback toggle-save();
    callback toggle-audio();

    // ── The step morph (§8) ──
    //
    // Rust bumps `step-nonce` on every preset step and sets `step-dir` to the
    // direction. A NONCE rather than a boolean because two steps in a row must
    // both animate, and a boolean that is already true changes nothing.
    in property <int> step-nonce: 0;
    in property <int> step-dir: 0;

    /// One frame at the PRE-swap geometry. This is a FLIP: by the time the
    /// nonce arrives the cards already hold the new stations — Rust tunes
    /// synchronously — so the morph is a matter of putting the hero back where
    /// its station came from and letting it travel to where it now belongs.
    property <bool> arming: false;

    arm := Timer {
        // One frame at 60Hz. CarFM arms with `requestAnimationFrame` for the
        // same reason and spells out why: the morph is native-driven and starts
        // before the new content has mounted, so without the frame of slack it
        // plays out on the OLD cards — the video shows the wrong side growing
        // and the content snapping partway through.
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            root.arming = false;
        }
    }

    /// One line into the diagnostics log, for a morph that cannot be watched.
    callback morph-note(string);

    /// ONE TICK PER FRAME OF THE MORPH, so the unit can report its own frame rate.
    ///
    /// Every millisecond in the performance review came from a desktop running
    /// the SOFTWARE renderer, while the APK renders with Skia on a 32-bit ARM
    /// GPU — so the one number that decides whether this animation reads as
    /// motion or as a cut has never been measured where it matters. It cannot be
    /// measured from outside either: Slint exposes no per-frame hook.
    ///
    /// `flip` is the morph's own clock, one linear run per step, and a `changed`
    /// handler on it fires each time the animation ADVANCES — which is once per
    /// turn of the event loop, and on a loop that draws every turn (the device's
    /// does) that is once per frame. `examples/morphbench.rs` holds the tally
    /// against an independently counted 163 frames and gets 157, and says so in
    /// its output so the claim is checked rather than asserted. It costs nothing
    /// at rest, because `flip` only moves during a step.
    callback morph-frame();
    changed flip => {
        root.morph-frame();
    }

    changed step-nonce => {
        // §4.7/§8: instant swaps with audio released. A dead face does not
        // animate, and CarFM skips the flip for exactly this case.
        if (root.step-dir != 0 && !root.dead) {
            root.arming = true;
            arm.running = true;
        }
        root.morph-note("dir=" + root.step-dir
            + " dead=" + (root.dead ? "yes" : "no")
            + " fit=" + Math.round(root.hero-fit * 100) + "%"
            + " cardw=" + Math.round(root.card-w / 1px)
            + " peekw=" + Math.round(root.peek-w / 1px));
    }

    /// How far the hero starts from its resting place: the peek slot on the side
    /// the new station came from. Stepping to NEXT takes the right-hand peek, so
    /// the card enters from the right.
    ///
    /// THE HERO'S FLIP — from the source peek's footprint to its own rect.
    ///
    /// This is a real FLIP now, because `HeroCard` scales (#75). It was a slide
    /// before, and every problem the slide had came from the card never changing
    /// size: centring a full-size 635px card on a peek slot 348px off the row's
    /// centre put a quarter of it past the bezel, so the throw had to be clamped,
    /// which on the tall track cut it to 21px and left a twitch.
    ///
    /// Shrunk to the peek's footprint the card is 180 wide, so centring it there
    /// puts it INSIDE the slot and nothing needs clamping. The full travel is
    /// back.
    ///
    /// Interpolated as a CENTRE and a SCALE rather than as a corner offset, so
    /// the card stays centred on its path at every instant instead of only at the
    /// two ends.
    property <length> peek-mid: root.peek-w * 0.88 / 2;
    property <float> hero-fit: root.peek-w * 0.88 / root.card-w;
    /// 1.0 at rest, `hero-fit` at the far end of the travel.
    ///
    /// OFF `m-scale`, NOT `m-out`, and that separation is CarFM's. Its morph
    /// runs translation on an ease-out CUBIC and scale on an ease-out QUINT, and
    /// says why in one line: "size settles slightly ahead of position"
    /// (`CarFmFace.tsx:962`). The card swells to full size while it is still
    /// travelling the last of the distance, so it arrives as a card rather than
    /// growing into place. Carnyx drove both off one cubic and lost that.
    property <float> hero-s: 1.0 - (1.0 - root.hero-fit) * root.m-scale;
    /// The slot the incoming station came from: NEXT on a forward step.
    property <length> src-cx: root.fwd
        ? root.next-rest-x + root.peek-mid
        : root.prev-rest-x + root.peek-mid;
    property <length> src-cy: root.peek-y + root.peek-mid;
    property <length> hero-rest-cx: root.card-x + root.card-w / 2;
    property <length> hero-rest-cy: root.height / 2;
    property <length> hero-cx: root.hero-rest-cx + (root.src-cx - root.hero-rest-cx) * root.m-out;
    property <length> hero-cy: root.hero-rest-cy + (root.src-cy - root.hero-rest-cy) * root.m-out;

    property <length> peek-w: Metrics.peek-w;
    property <length> overlap: Metrics.peek-overlap;
    // CarFM lays this out as a centred flex row whose peek boxes carry a negative
    // margin that tucks them under the card. The same arithmetic, done directly:
    // the row is the two full peek boxes plus the card, less one overlap a side.
    property <length> total-w: (root.has-prev ? root.peek-w - root.overlap : 0px)
        + root.card-w
        + (root.has-next ? root.peek-w - root.overlap : 0px);
    property <length> start-x: (root.width - root.total-w) / 2;
    property <length> card-x: root.start-x + (root.has-prev ? root.peek-w - root.overlap : 0px);
    // A peek is authored at 0.88, so it sits centred inside its own layout box.
    property <length> peek-inset: root.peek-w * 0.06;
    property <length> peek-y: (root.height - root.peek-w * 0.88) / 2;

    property <length> resolved-card-h: root.card-fill ? root.height * 0.98 : card.preferred-height;
    property <length> peek-h: (root.has-prev || root.has-next) ? root.peek-w * 0.88 : 0px;
    // Content-sized on the tall track, where the parent gives the row no height of
    // its own. Deliberately reads the card's PREFERRED height, never its resolved
    // one: the latter is the row's own height on the wide track, and asking a
    // layout how tall it is in order to tell it how tall to be is a binding loop.
    min-height: root.card-fill ? root.peek-h : Math.max(card.preferred-height, root.peek-h);

    // ── The three beats that are NOT the hero (§8) ──
    //
    // CarFM's morph is four things at once, and this used to be one of them. The
    // hero travelled and everything else POPPED: the outgoing station appeared in
    // its peek slot fully formed, the discarded card vanished between frames, and
    // the station arriving from further out snapped in at full strength. Three of
    // the four beats were simply missing.
    //
    // Which slot plays which part is the direction mapping, and it is the whole
    // of the wiring. Stepping FORWARD (dir > 0): the hero goes to the PREV slot,
    // the new hero comes from the NEXT slot, and the old prev card is discarded.
    // Back is mirrored.
    //
    //   dir > 0   left  = the DESTINATION: where the outgoing hero lands, over
    //                     the ghost of the old prev card
    //             right = the SOURCE the incoming hero grows out of, with the
    //                     newly-reachable station fading in behind it
    //   dir < 0   mirrored
    //
    // The four beats are driven by four progress properties rather than by
    // referencing elements from `states`, because the peeks are conditional and a
    // state cannot name an element that may not exist. Each runs 1 → 0 across the
    // transition with its own duration and delay, which is what lets the far card
    // lag the cards in motion and the departing card dissolve only after it has
    // landed.
    property <bool> fwd: root.step-dir > 0;

    /// CarFM's `flipProg`, and the reason the two curves below are EXACT.
    ///
    /// `Animated.timing(flipProg, { toValue: 1, duration: 520, easing: linear })`
    /// (CarFmFace.tsx:1061) drives one linear clock, and every geometry channel
    /// is an `interpolate()` off it with the easing baked into a 13-point sampled
    /// track (`track()`, :988-993). So the reference's easings are ANALYTIC
    /// functions — `1 - (1-p)^3` and `1 - (1-p)^5` (:986-987) — approximated by a
    /// 12-segment polyline.
    ///
    /// Slint 1.17 exposes `Math.pow`, so those functions can be written out
    /// rather than fitted. This clock runs 1 → 0 linearly across the transition
    /// and `m-out`/`m-scale` are powers of it; since `hero-cx` is
    /// `rest + (src - rest) * m-out`, `m-out = (1-p)^3` reproduces CarFM's
    /// `from + (to - from) * (1 - (1-p)^3)` term for term. The previous cut used
    /// the easings.net Bézier fits, which are within ~1% but are not the same
    /// function — and are no closer than CarFM's own polyline.
    property <float> flip: 0;
    /// POSITION — CarFM's `easeMove`, `1 - (1-p)^3` (CarFmFace.tsx:986).
    property <float> m-out: Math.pow(root.flip, 3);
    /// SIZE — CarFM's `easeScale`, `1 - (1-p)^5` (CarFmFace.tsx:987), one power
    /// faster so that "size settles slightly ahead of position" (:962).
    ///
    /// QUINT, NOT THE QUART A PREVIOUS CUT CHOSE. Quart was picked because quint
    /// puts the arriving card's right edge 8px past the bezel for ~100ms on the
    /// TALL track. That protected a 360px layout at the cost of the 1024x614 the
    /// owner actually drives, where quint peaks at 952px of 1024 — and the tall
    /// track already overhangs by 1.2px under ANY curve. CarFM overhangs there
    /// too and is clipped by the window.
    property <float> m-scale: Math.pow(root.flip, 5);
    property <float> m-ghost: 0;
    property <float> m-far: 0;
    /// A morph is on screen. Gates the resting card out and the flying pair in.
    property <bool> morphing: root.m-out > 0.001;

    property <length> prev-rest-x: root.start-x + root.peek-inset;
    property <length> next-rest-x: root.card-x + root.card-w - root.overlap + root.peek-inset;
    property <float> peek-rest: root.dead ? 0.28 : 0.6;

    /// THE OUTGOING HERO'S FLIP — the mirror of the incoming one.
    ///
    /// This card used to be a `PeekCard` standing in for the hero: the
    /// destination peek started on the hero's footprint and shrank home. That IS
    /// CarFM's shape — its peek node is the outgoing card, FLIPped from the
    /// hero's rect — but CarFM does it with a NON-UNIFORM transform that stretches
    /// the peek's content out to 635x180 on the way. Nothing here can distort an
    /// element, so the square had to be fitted to `min(card-w, card-h)` instead,
    /// and the station that left was represented for the whole 520ms by a 180px
    /// square that had never been on screen.
    ///
    /// Now that `HeroCard` scales, the card that leaves is a REAL HERO CARD
    /// carrying the station that was playing, so the first frame of the morph is
    /// the face as it stood before the step — which is what a FLIP is. It is not
    /// a workaround for the missing transform; it is better than the transform,
    /// because nothing is stretched.
    ///
    /// Interpolated as a CENTRE off `m-out` and a SCALE off `m-scale`, the same
    /// pair the incoming hero uses — so the card leaving and the card arriving
    /// cannot drift apart, while size still settles ahead of position.
    property <length> dst-cx: root.fwd
        ? root.prev-rest-x + root.peek-mid
        : root.next-rest-x + root.peek-mid;
    property <length> dst-cy: root.peek-y + root.peek-mid;
    /// 1.0 where the travel starts, `hero-fit` where it lands — the same fit the
    /// incoming hero uses, so both cards meet the peek slots on their WIDTH.
    /// Fitting on height instead would land a 559px card in a 158px slot.
    property <float> out-s: root.hero-fit + (1.0 - root.hero-fit) * root.m-scale;
    property <length> out-cx: root.dst-cx + (root.hero-rest-cx - root.dst-cx) * root.m-out;
    property <length> out-cy: root.dst-cy + (root.hero-rest-cy - root.dst-cy) * root.m-out;

    /// The slot that CHANGES HANDS cross-dissolves. The ghost of its old occupant
    /// fades out while the card underneath — the outgoing station, already
    /// swapped in by Rust — fades up to meet it, so the slot carries one card's
    /// worth of weight the whole way across instead of briefly stacking two at
    /// 0.6 and reading as a bright double exposure. A slot that keeps its
    /// occupant simply sits at rest.
    /// ONE REPRESENTATION OF THE DEPARTING STATION AT A TIME, which is what
    /// CarFM gets for free by having only one element.
    ///
    /// There, the landing peek IS the departing card: the same node is FLIPped
    /// from the hero's rect and sits at 0.6 throughout. Here the flying
    /// `HeroCard` carries it while the morph runs, so the RESTING peek in that
    /// slot must stay dark until the flying one is gone — otherwise the slot
    /// holds two cards of the same station and reads at double weight as they
    /// converge. It was cross-dissolving against the ghost before, which was
    /// Carnyx compensating for a beat the reference does not have.
    property <float> dst-weight: (root.hand-off && root.morphing)
        ? 0.0
        : root.peek-rest;
    /// The station arriving from further out.
    property <float> far-weight: root.peek-rest * (1.0 - root.m-far);

    // THE PEEKS NO LONGER FLY, and neither is `inert` any more. Until the
    // outgoing card became a `HeroCard` the destination peek WAS the outgoing
    // card, so it had to be displaced onto the hero's footprint — which put it
    // centred over the hero for the first stretch, where its TouchArea would have
    // taken taps meant for the hero and stepped the radio a second time the
    // driver never asked for. Both cards stand still now, the card in flight is
    // the one that is `inert`, and a tap on a peek during the morph does the
    // ordinary thing.
    // HOW MUCH OF EACH PEEK THE HERO COVERS, so `PeekCard` can keep that strip
    // out of its own touch target. The layout tucks the peeks under the card by
    // `Metrics.peek-overlap` on purpose — that is the look — but the hero does
    // not stop a tap landing on what is underneath it, so without this the
    // covered strip is a live "step preset" button sitting on the hero's face.
    // `examples/tapprobe.rs` measured it at 1024x614: 56px of the card's own
    // body on each side tuned a different station.
    //
    // Derived from the same rest positions the cards are placed at rather than
    // from `overlap` directly, so a change to `peek-inset` or to the peek's 0.88
    // cannot leave this stale.
    property <length> peek-side: root.peek-w * 0.88;
    property <length> prev-blocked: Math.max(0px, root.prev-rest-x + root.peek-side - root.card-x);
    property <length> next-blocked: Math.max(0px, root.card-x + root.card-w - root.next-rest-x);

    if root.has-prev: PeekCard {
        x: root.prev-rest-x;
        y: root.peek-y;
        egg: root.egg;
        card-w: root.peek-w;
        side: "left";
        preset: root.prev-preset;
        weight: root.fwd ? root.dst-weight : root.far-weight;
        blocked: root.prev-blocked;
        selected => { root.step(-1); }
    }
    if root.has-next: PeekCard {
        x: root.next-rest-x;
        y: root.peek-y;
        egg: root.egg;
        card-w: root.peek-w;
        side: "right";
        preset: root.next-preset;
        weight: root.fwd ? root.far-weight : root.dst-weight;
        blocked: root.next-blocked;
        selected => { root.step(1); }
    }

    // The discarded card. CarFM stamps an absolutely-positioned CLONE over the
    // peek that is about to be replaced, so it can keep existing after React
    // swaps the slot's content; `ghost-preset` is that clone — Rust captures the
    // slot's station BEFORE tuning and it is drawn here, fading 0.6 → 0, for as
    // long as the morph runs.
    //
    // `inert`, because it sits on top of the real card and must not swallow a
    // second tap. Conditional, so it is not an invisible touch target at rest.
    if root.hand-off && root.m-ghost > 0.001: PeekCard {
        x: root.fwd ? root.prev-rest-x : root.next-rest-x;
        y: root.peek-y;
        egg: root.egg;
        card-w: root.peek-w;
        side: root.fwd ? "left" : "right";
        preset: root.ghost-preset;
        weight: root.peek-rest * root.m-ghost;
        inert: true;
    }
    // THE CARD THAT LEAVES. Above the peeks and the ghost, so it reads as a card
    // in flight rather than something buried in the row — and BELOW the incoming
    // hero, so the arriving station is never occluded by the departing one. That
    // is CarFM's z-order too: the peeks tuck under the hero container, and its
    // outgoing card is a peek.
    //
    // GATED ON `hand-off`, exactly like the ghost. When the destination slot keeps
    // its occupant there is nowhere for this card to land, and flying it into a
    // slot it does not end up in would draw the driver a lie. Stepping forward off
    // an unsaved dial is that case: the dial is not stored anywhere, so it leaves
    // without going into a slot, and the centre is held by the incoming hero
    // growing in.
    //
    // NOT PIXEL-EXACT AT FRAME 0, and the reason is worth saying rather than
    // discovering. `HeroCard` takes its height from the row, and on the tall track
    // the row's height is the INCOMING card's preferred height — so a step between
    // a logo hero and a no-logo hero starts this card at the new card's height
    // rather than the old one's. Cloning the departing node is the only way round
    // that, and there is no cloning here; carrying the station across is.
    if root.hand-off && root.morphing: HeroCard {
        scale: root.out-s;
        width: root.card-w * root.out-s;
        height: root.resolved-card-h * root.out-s;
        x: root.out-cx - self.width / 2;
        y: root.out-cy - self.height / 2;
        // CONSTANT 0.6, WHICH IS CarFM'S, and the `m-settle` beat this replaces
        // was Carnyx's own invention. In the reference the departing station is
        // the LANDING PEEK — an ordinary `SidePresetCard` FLIPped from the hero's
        // rect (CarFmFace.tsx:1529-1545) — and its opacity is the static branch
        // of `isEntering ? enterOpacity : PEEK_OPACITY` (:1538). It is never
        // animated: it is at 0.6 on frame 0 and 0.6 on frame 520.
        //
        // A previous cut flew this at full strength and dissolved it over 140ms
        // from 380ms, on the stated grounds that "the card travels at full
        // strength, because that is what CarFM's does". That was wrong about the
        // reference — it read `centerTransform`, which is the ARRIVING card, and
        // the arriving card is indeed at full opacity in both.
        opacity: root.peek-rest;
        inert: true;
        ident: root.outgoing.ident;
        freq-label: root.outgoing.freq-label;
        logo: root.outgoing.logo;
        has-logo: root.outgoing.has-logo;
        logo-plate: root.outgoing.plate;
        show-call: root.outgoing.show-call;
        show-freq: root.outgoing.show-freq;
        saved: root.outgoing.saved;
        // FACE STATE, not station state, so it is NOT in the snapshot: `dead` is
        // the audio-priority veil and it belongs to the whole face at once. A
        // morph never STARTS dead (the arm handler skips when dead), but the
        // release can land mid-flight — and a card flying at full colour through
        // a face that just went grayscale is the one thing worse than the veil
        // arriving a frame late. `scanning` is deliberately left at its default:
        // a sweep started mid-morph belongs to the dial that ARRIVED, and the
        // departing station claiming it would be a lie about the past.
        dead: root.dead;
    }

    // THE RESTING HERO, and the row's RULER — two jobs that cannot be done by
    // one flying card, which is what the first cut of #75 tried.
    //
    // On the tall track the parent gives this row no height of its own, so the
    // row measures the card: `resolved-card-h` is `card.preferred-height`. Put
    // the scale on that same card and the measurement scales with it — the card
    // is then laid out at `preferred-height * scale`, and its height binding
    // multiplies by the scale AGAIN, so the hero shrank quadratically and its
    // rect was empty at frame 0. The row's own `min-height` collapsed with it,
    // re-laying the whole face out under the driver mid-morph. The wide track
    // hid all of it, because there `resolved-card-h` is 98% of the row and never
    // asks the card anything. `examples/outprobe.rs` is what caught it.
    //
    // So this card never scales and never moves. The two that fly are separate
    // elements, drawn only while the morph runs, and the incoming one lands
    // exactly on this rect — the handover is between two cards that coincide.
    card := HeroCard {
        width: root.card-w;
        height: root.resolved-card-h;
        x: root.card-x;
        y: (root.height - root.resolved-card-h) / 2;
        // HIDDEN, NOT REMOVED. An `if` would take it out of the tree and its
        // height with it, which is the collapse this card exists to prevent.
        // `inert` alongside, so an invisible card cannot take the taps its star
        // and power button would otherwise still receive.
        //
        // `visible`, NOT `opacity: 0`, and the two are not the same instruction.
        // `opacity` compiles to an Opacity item, and `Opacity::need_layer`
        // (i-slint-core items.rs:953) returns false only at 1.0 or for a childless
        // subtree — a HeroCard is neither, so Skia ran `save_layer_alpha`, drew
        // this entire card into that layer and composited it at alpha zero. Every
        // frame, for all 520ms of every step. `visible` lowers to a Clip with
        // `clip: !visible` (i-slint-compiler passes/visible.rs) and an empty clip
        // returns `ContinueRenderingWithoutChildren` (item_rendering.rs:529), so
        // nothing under it is drawn at all. The card keeps its geometry either
        // way, which is what the paragraph above is really asking for — the
        // collapse it warns about belongs to `if`, not to this.
        //
        // NOT MEASURED, AND IT CANNOT BE FROM HERE. The layer is a SKIA
        // behaviour: `i-slint-renderer-software` has no `visit_opacity` override
        // at all, so on the host `opacity: 0` merely draws with alpha zero and
        // there is nothing for this to save. `morphbench` A/B'd it four times and
        // the difference sat inside the run-to-run spread (144-170 frames either
        // way). The saving is real on the device's renderer and invisible on the
        // one every probe in this tree uses. `outprobe` was run before and after
        // and reports pixel-identical geometry, which is what was checkable here.
        visible: !root.morphing;
        inert: root.morphing;
        egg: root.egg;
        ident-a: root.ident-a;
        ident-b: root.ident-b;
        ident: root.ident;
        freq-label: root.freq-label;
        logo: root.logo;
        has-logo: root.has-logo;
        logo-plate: root.logo-plate;
        show-call: root.show-call;
        show-freq: root.show-freq;
        saved: root.saved;
        dead: root.dead;
        scanning: root.scanning;
        toggle-save => { root.toggle-save(); }
        toggle-audio => { root.toggle-audio(); }
    }

    // THE CARD THAT ARRIVES. Above the departing one, so the station coming in
    // is never occluded by the station going out — CarFM's z-order, where the
    // peeks tuck under the hero container and its outgoing card is a peek.
    //
    // Position comes from `m-out` and size from `m-scale`, so there is no
    // separate animation on this element and no state that displaces it: the two
    // progress properties are driven from one transition, which is what keeps
    // every beat in step while letting scale lead.
    if root.morphing: HeroCard {
        scale: root.hero-s;
        width: root.card-w * root.hero-s;
        height: root.resolved-card-h * root.hero-s;
        x: root.hero-cx - self.width / 2;
        y: root.hero-cy - self.height / 2;
        inert: true;
        egg: root.egg;
        ident-a: root.ident-a;
        ident-b: root.ident-b;
        ident: root.ident;
        freq-label: root.freq-label;
        logo: root.logo;
        has-logo: root.has-logo;
        logo-plate: root.logo-plate;
        show-call: root.show-call;
        show-freq: root.show-freq;
        saved: root.saved;
        dead: root.dead;
        scanning: root.scanning;
    }

    // ── The travel ──
    //
    // A STATE with an `out` transition, not an `animate` on the card's own
    // bindings, and the difference is the whole bug. Written as
    //
    //     x: root.card-x + (root.arming ? root.enter-dx : 0px);
    //     animate x { duration: root.arming ? 0ms : 520ms; }
    //
    // it worked in the screenshot harness and did nothing on the device: the
    // card blinked out and came back at rest with no travel at all. Two things
    // conspire. The duration is itself a binding on the state being left, so the
    // out-transition can be set up reading the value it is leaving — 0ms — and
    // snap. And Slint evaluates bindings lazily, at render, so if no frame is
    // drawn between arming and the timer clearing it, `x` never holds the source
    // value and there is nothing to animate FROM. A head unit mid-tune is
    // exactly where that frame goes missing.
    //
    // A state has neither problem: the duration is a constant, and the state
    // machine — not a rendered frame — is what decides the value being left.
    states [
        entering when root.arming: {
            // ONE TRANSITION FOR EVERY BEAT. `card.x` used to be displaced here
            // and animated separately; now the hero's centre comes from `m-out`
            // and its scale from `m-scale`, both left by this one state, so the
            // hero and the cards beside it cannot drift out of step. Two curves,
            // one clock — see the `out` block for why scale is the faster of
            // them.
            root.flip: 1.0;
            root.m-ghost: 1.0;
            root.m-far: 1.0;
            // NO OPACITY. The card travels at full strength, because that is
            // what CarFM's does: its `centerTransform` is translate and scale
            // only, and the two opacity animations in that morph belong to the
            // clone leaving and the far peek arriving, neither of which exists
            // here. Fading the hero to nothing was my own addition, and it is
            // exactly the "hero card disappears for a moment" reported from the
            // car — because the arming window is one frame in the harness and
            // however long a synchronous retune takes on a head unit, and the
            // card is a HOLE for all of it.
            //
            // NO `in` BLOCK either. Going in must be instantaneous, or the card
            // visibly slides AWAY to the peek slot before coming back.
            out {
                // ONE LINEAR CLOCK, exactly CarFM's: `duration: 520,
                // easing: Easing.linear` (CarFmFace.tsx:1061). Position and size
                // get their shapes from `Math.pow` on this, not from an easing
                // here — see `flip`.
                animate root.flip {
                    duration: 520ms;
                    easing: linear;
                }
                // THE DISCARDED CARD — CarFM's `cloneOpacity` (CarFmFace.tsx:1062):
                // 0.6 to 0 across the FULL window, no delay, on CSS ease
                // (`Easing.bezier(0.25, 0.1, 0.25, 1)`), which Slint takes as the
                // same four numbers. A previous cut ran this in 160ms linear on
                // the argument that a leaving card should snap away; the
                // reference is the spec now.
                animate root.m-ghost {
                    duration: 520ms;
                    easing: cubic-bezier(0.25, 0.1, 0.25, 1);
                }
                // THE STATION ARRIVING FROM FURTHER OUT — CarFM's `enterOpacity`
                // (CarFmFace.tsx:1063): 0 to 0.6 over a FULL 520ms window after a
                // 120ms delay, same ease. So it finishes 120ms AFTER the travel
                // does, which is the reference's shape; a previous cut compressed
                // it to land with everything else.
                animate root.m-far {
                    duration: 520ms;
                    delay: 120ms;
                    easing: cubic-bezier(0.25, 0.1, 0.25, 1);
                }
            }
        }
    ]
}
