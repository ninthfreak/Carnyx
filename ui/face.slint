// The radio face: a vertical stack of three regions — status bar, hero, preset
// band — laid out directly at the real available dp.
//
// ANDROID §0 is the rule this file exists to obey: no design canvas, no uniform
// scale. The tracks reflow per surface and the token ramp in `Metrics` re-derives
// the spec's dp for the space actually available.

import { Pal, Metrics, Font } from "tokens.slint";
import { Preset, HeroSnapshot, EggTheme, LogoPlate, NavStage } from "types.slint";
import { StatusBar } from "status-bar.slint";
import { TurnArrow } from "icons.slint";
import { HeroRow, RadioTextStrip } from "hero.slint";
import { PresetsBand } from "presets.slint";

export component Face inherits Rectangle {
    // ── Dial and identity ──
    in property <string> ident;
    in property <string> freq-label: "—";
    in property <image> logo;
    in property <bool> has-logo: false;
    in property <LogoPlate> logo-plate: LogoPlate.light;
    in property <bool> show-call: true;
    in property <bool> show-freq: true;
    in property <bool> saved: false;
    in property <bool> in-band: true;
    in property <string> radio-text;

    // ── Status ──
    in property <int> full-pairs: 0;
    in property <bool> half: false;
    in property <float> dot-opacity: 1.0;
    in property <int> dotted-arcs: 0;
    in property <string> level-text: "—";
    in property <bool> stereo-known: false;
    in property <bool> stereo: false;
    in property <bool> rds: false;
    in property <bool> tp: false;
    in property <bool> ta: false;
    in property <bool> af: false;
    in property <string> pty;
    /// The band theme, and the call sign pre-split for its bolt.
    in property <EggTheme> egg;
    in property <string> ident-a;
    in property <string> ident-b;
    in property <bool> tuner-error: false;
    /// §4.8's readout, already formatted. EMPTY DRAWS NOTHING — the switch is
    /// off, or the platform had no reading to give.
    in property <string> clock-time;
    /// `A`, `P`, or empty in 24-hour mode.
    in property <string> clock-meridiem;

    in property <bool> gps-fix: false;
    in property <bool> in-motion: false;
    /// The OsmAnd tell (§4.9): the switch, and whether the service is answering.
    in property <bool> osmand-on: false;
    in property <bool> osmand-linked: false;

    // ── The maneuver layer (§4.9) ──
    /// Which of the three stages, or `idle` for "nothing to draw" — which covers
    /// both no route and a layer suppressed by OsmAnd's own map.
    in property <NavStage> nav-stage: NavStage.idle;
    /// The stage-1 hairline's width, 0 to 1.
    in property <float> nav-progress: 0.0;
    /// Already local and already formatted. Empty draws nothing.
    in property <string> nav-eta;
    in property <string> nav-left-distance;
    /// The maneuver arrow as SVG path data on a 24-unit box, and a roundabout's
    /// exit number. Empty draws nothing — see `crate::app::arrow_for`.
    in property <string> nav-arrow;
    in property <string> nav-exit;
    in property <string> nav-distance;
    in property <string> nav-street;
    /// The turn AFTER the next one — §4.9's `then` block, and the only maneuver
    /// the strip shows once the hero card has taken over.
    in property <string> nav-after-arrow;
    in property <string> nav-after-exit;
    in property <string> nav-after-street;

    // ── Presets ──
    in property <[Preset]> presets;
    /// Settings ▸ APPEARANCE ▸ Wrap the preset rail (§8). Passed straight
    /// through; `PresetsBand` decides whether the conditions to honour it hold.
    in property <bool> preset-loop: false;
    in property <int> active-index: -1;
    in property <Preset> prev-preset;
    in property <Preset> next-preset;
    /// The station the discarded peek held before a step — the ghost that
    /// fades out during the hero morph. See `step_morph` in src/app.rs.
    in property <Preset> ghost-preset;
    /// The hero as it stood before the step — the card that flies OUT during the
    /// morph. Captured alongside `ghost-preset`; see `step_morph` in src/app.rs.
    in property <HeroSnapshot> outgoing;
    in property <bool> hand-off: true;
    in property <bool> has-prev: false;
    in property <bool> has-next: false;

    // ── Modes ──
    /// Whether this app holds FM audio priority on the shared bus (§4.7). NOT a
    /// mute: false means priority is released to another source and the face goes
    /// flat and dead.
    in property <bool> audio-active: true;
    in property <bool> scanning: false;
    in property <bool> reordering: false;
    /// The step morph (§8) — see `HeroRow`.
    in property <int> step-nonce: 0;
    in property <int> step-dir: 0;

    callback toggle-save();
    callback open-settings();
    callback open-nearby();
    /// A tap on the OsmAnd status-bar mark — bring OsmAnd to the front.
    callback open-osmand();
    /// The reorder-mode logo badge on preset `i` (§6.4).
    callback open-logo-search(int);
    callback claim-audio();
    callback release-audio();
    callback select-preset(int);
    callback step-preset(int);
    callback done-reordering();
    /// Long-press on a preset tile. The only door to reorder mode.
    callback enter-reordering();
    /// A drag let go: move the preset at the first index to the second.
    callback reorder-preset(int, int);
    /// One diagnostics line about the reorder gesture. See `PresetsBand`.
    callback drag-note(string);
    /// The same, for the hero's step morph. See `HeroRow`.
    callback morph-note(string);
    /// One tick per morph frame — see HeroRow's `morph-frame`.
    callback morph-frame();

    property <bool> dead: !root.audio-active;

    // The face measures its own container so it composes correctly at any size
    // the design handoff targets — the Dudu7 full width, its ⅔ and ⅓ slices, and
    // two phone surfaces — as well as full-screen on the unit.
    //
    // THOSE ARE DESIGN SURFACES, NOT THE DEPLOYMENT. The unit this app runs on is
    // an NWD/NOWADA head unit running its stock ROM full-screen; it is not a
    // DuduOS unit and nothing here is windowed. This comment has been read the
    // other way and a whole diagnosis built on it — see `android::FOCUSED`.
    init => {
        Metrics.avail-w = root.width;
        Metrics.avail-h = root.height;
        Pal.off = root.dead;
    }
    changed width => { Metrics.avail-w = root.width; }
    changed height => { Metrics.avail-h = root.height; }
    changed dead => { Pal.off = root.dead; }

    background: Pal.page;

    // Tall track: the preset band sizes to its 3-column grid content but is capped
    // at ~42% of the screen. A definite computed height keeps the vertical grid
    // scrollable while still letting the hero reclaim the freed space when there
    // are few presets, which is what kills the dead void on a real phone portrait.
    //
    // THE GRID'S EXTENT IS THE GRID'S TO STATE, and it is read here rather than
    // recomputed. This used to restate the whole tile arithmetic — tile height,
    // gap and trailing pad — from its own copies of the numbers, and the two had
    // already drifted: 8px of trailing pad here against the 6px the grid actually
    // leaves. `PresetsBand::grid-content-h` is now the one statement of it, read
    // off the band the same way the clock reads `cluster-bottom` off the status
    // bar. No loop: that extent depends on the preset count and on `Metrics`, and
    // on nothing this height feeds.
    //
    // THE CAP AND THE FLOOR STAY HERE. Both are about the SCREEN, not the grid —
    // never more than 42% of it, never less than 96 — so they do not belong to
    // the band.
    property <length> tall-band: Math.min(
        Math.round(Metrics.h * 0.42) * 1px,
        Math.max(Metrics.s(96), preset-band.grid-content-h));
    property <length> band-h: Metrics.tall ? root.tall-band : Metrics.band-height;

    VerticalLayout {
        padding-left: Metrics.pad-h;
        padding-right: Metrics.pad-h;
        padding-top: Metrics.pad-v;
        padding-bottom: Metrics.pad-v;
        spacing: Metrics.gap;

        status := StatusBar {
            vertical-stretch: 0;
            // §4.7: with priority released the indicators go to their off states
            // — no bars, no level, an empty pill, dim tells, no genre. The face
            // enforces that here so no caller has to remember to.
            full-pairs: root.dead ? 0 : root.full-pairs;
            half: root.dead ? false : root.half;
            dot-opacity: root.dead ? 0 : root.dot-opacity;
            dotted-arcs: root.dead ? 0 : root.dotted-arcs;
            level-text: root.dead ? "—" : root.level-text;
            stereo-known: root.stereo-known;
            stereo: root.stereo;
            rds: root.rds;
            tp: root.tp;
            ta: root.ta;
            af: root.af;
            pty: root.pty;
            egg: root.egg;
            in-band: root.in-band;
            tuner-error: root.tuner-error;
            dead: root.dead;
            gps-fix: root.gps-fix;
            in-motion: root.in-motion;
            osmand-on: root.osmand-on;
            osmand-linked: root.osmand-linked;
            reordering: root.reordering;
            open-settings => { root.open-settings(); }
            open-nearby => { root.open-nearby(); }
            open-osmand => { root.open-osmand(); }
            done-reordering => { root.done-reordering(); }
        }

        // Space reserved for the hero band. The band itself is drawn last, over
        // the §4.7 screen veil, because the hero rises above that veil and carries
        // its own lighter one.
        hero-slot := Rectangle { vertical-stretch: 1; }

        preset-band := PresetsBand {
            vertical-stretch: 0;
            band-height: root.band-h;
            presets: root.presets;
            preset-loop: root.preset-loop;
            egg: root.egg;
            active-index: root.active-index;
            reordering: root.reordering;
            show-nearby: !Metrics.tall;
            select(i) => { root.select-preset(i); }
            open-nearby => { root.open-nearby(); }
            done-reordering => { root.done-reordering(); }
            enter-reordering => { root.enter-reordering(); }
            reorder(from, to) => { root.reorder-preset(from, to); }
            drag-note(m) => { root.drag-note(m); }
            open-logo-search(i) => { root.open-logo-search(i); }
        }
    }

    // ── §4.8 THE CLOCK ───────────────────────────────────────────────────────
    //
    // OUT OF FLOW, so it adds no height to the status bar and starting or ending
    // navigation cannot move it. A sibling of the layout above, positioned from
    // two measured edges, exactly as the hero band below is.
    //
    // ── IT IS THE LINE THAT IS CENTRED, NOT THE BLOCK ────────────────────────
    //
    // §4.8 is emphatic and says why: "so an ETA hanging below it (§4.9) changes
    // neither the clock's size nor its position, and moves nothing else on the
    // face." So the TIME's own box is centred in the gap and the block is left
    // to hang below it — get this wrong and the ETA pushes the clock up the
    // moment a route starts, which is the one thing the whole design avoids.
    //
    // ── THE UPPER EDGE IS THE CLUSTER, NOT THE STATUS BAR ────────────────────
    //
    // Also §4.8's: the status bar runs deeper on the left, so its box bottom is
    // not the cluster's. `status.cluster-bottom` reports the gear on the wide and
    // landscape tracks and the NEARBY DISC on the tall one, where that sits below
    // the gear — anchoring to the gear everywhere ran the clock straight through
    // the disc in portrait.
    //
    // ── HIDDEN UNTIL MEASURED ────────────────────────────────────────────────
    //
    // Both anchors are zero before the first layout pass, which would put the
    // clock at the top-left for one frame. The mock "hides the countdown until
    // it has measured its top, so it never flashes at the wrong y"; this is the
    // same guard for the same reason.
    property <length> clock-gap-top: status.cluster-bottom;
    // THE CARD'S TOP, NOT THE SLOT'S. §4.8 says "the top line of the hero
    // card", and the two differ: the card hangs centred inside its slot, ~7px
    // lower on the wide track and ~70px lower on the tall one, where the slot
    // takes whatever the column above leaves. Anchored to the slot, the clock
    // sat ~4px high on the head unit and ~53px high in portrait — measured off
    // the shots, not estimated. `Metrics.hero-card-top` is written back by the
    // HeroRow that owns the card, because the rows live inside this face's
    // per-track `if` arms and their ids cannot be reached from here.
    property <length> clock-gap-bottom: Metrics.hero-card-top;
    property <bool> clock-measured: root.clock-gap-bottom > root.clock-gap-top;
    // §4.8 STATED 30SP/36SP; A LATER, DIRECT ASK GREW IT 20% ON TOP — "the
    // clock ... be 20% larger" — WHILE PINNING ITS TOP TO THE SAME DISTANCE
    // FROM THE GEAR IT ALREADY SAT AT, rather than letting a taller box
    // re-centre and creep closer to the settings button as it grew. So the
    // clock no longer centres itself in the gap at all: `clock-top-gap` below
    // measures where the top of the box sat under the ORIGINAL, un-enlarged
    // formula — computed once, from the pre-enlargement height alone — and the
    // enlarged box hangs from that same fixed point, growing downward toward
    // the hero card instead of both ways from the middle.
    property <length> clock-font-size: (Metrics.tall ? Metrics.s(36) : Metrics.s(30)) * 1.2;
    // ONE DEFINITION, READ BY THREE THINGS: the clock's own box, the ETA that
    // hangs under it, and the countdown that has to clear both on the tall
    // track. It was declared twice and drifting apart was only a matter of time.
    property <length> clock-line-h: root.clock-font-size * 1.2;
    // THE INK RIDES ABOVE THE BOX'S CENTRE, and §4.8 anchors the OPTICAL
    // centre — the ink's — not the box's. MEASURED, NOT DERIVED, at 30sp
    // (before the 20% enlargement): with the box's centre placed exactly on
    // the spec midpoint, subpixel edge-crossing profiles of the reference
    // surface put the digits' ink centre 0.85px above it — 0.03 × font-size.
    // Part is how parley (the one text layout behind this harness's software
    // renderer AND the device's Skia renderer) seats DSEG's 90/em line gap in
    // the centred line box, part is the anchors' own whole-pixel edge
    // snapping.
    //
    // IT IS PINNED TO THE PRE-ENLARGEMENT SIZE ON PURPOSE, and that is why the
    // 0.03 is written into `clock-top-gap` below against `Metrics.s(36)` /
    // `Metrics.s(30)` rather than against the live `clock-font-size`. The whole
    // job of `clock-top-gap` is to reproduce the ORIGINAL top edge exactly —
    // the point the un-enlarged, box-centred formula put the clock at — so
    // every term in it, this ride included, has to be the term that formula
    // used. Riding the live size instead would add 0.03 × 0.2 = 0.006 of the
    // pre-enlargement size to the top edge and defeat the anchor. So there is
    // no standing constant here that survives another size change: enlarge the
    // clock again and this term has to be re-derived against whatever
    // "original" top edge is being held fixed that time.
    //
    // THE ORIGINAL, UN-ENLARGED LINE HEIGHT — §4.8's 30sp/36sp × the same 1.2
    // leading — used ONLY to find where the top of the box sat before the 20%
    // ask, so that point can be held fixed while the real, enlarged
    // `clock-line-h` above decides how tall the box actually is.
    property <length> clock-line-h-preenlarge: (Metrics.tall ? Metrics.s(36) : Metrics.s(30)) * 1.2;
    property <length> clock-top-gap:
        (root.clock-gap-bottom - root.clock-gap-top - root.clock-line-h-preenlarge) / 2
        + ((Metrics.tall ? Metrics.s(36) : Metrics.s(30)) * 0.03);
    property <length> clock-line-top: root.clock-gap-top + root.clock-top-gap;
    property <length> clock-line-bottom: root.clock-line-top + root.clock-line-h;
    if root.clock-time != "" && root.clock-measured: Rectangle {
        // `clock-line-top` is fixed relative to the gear; the box's height is
        // the only thing the 20% enlargement changed, and it grows downward
        // from this same top edge rather than the old centred formula's `y:
        // clock-line-bottom - clock-line-h`.
        x: 0;
        y: root.clock-line-top;
        width: root.width;
        height: root.clock-line-h;

        HorizontalLayout {
            alignment: end;
            spacing: 0px;
            // RIGHT EDGE FLUSH WITH THE GEAR (§4.8). The face's own right
            // padding is what puts the gear where it is, so the same padding
            // lands this on the same edge.
            padding-right: Metrics.pad-h;

            Text {
                text: root.clock-time;
                // THE ONE NON-ATKINSON FACE IN THE APP, and deliberately: §4.8
                // wants it to "read as head-unit hardware, not as UI text".
                // REGULAR ONLY — a synthesized bold smears the segment gaps, so
                // there is no `font-weight` here and there must not be one.
                //
                // THE FAMILY IS "DSEG7 Classic Mini", WITH SPACES, which is what
                // the file's own `name` table declares — not the filename. Slint
                // resolves `font-family` against the declared family and falls
                // back to Atkinson in silence when it misses, which is the trap
                // `ui/tokens.slint` records this tree falling into five times.
                font-family: "DSEG7 Classic Mini";
                font-size: root.clock-font-size;
                letter-spacing: 1px;
                // `dim` — the genre line's colour, §4.8.
                color: Pal.dim;
                vertical-alignment: center;
            }

            // The meridiem: a SINGLE letter, never AM/PM, absent in 24-hour.
            // Baseline-aligned to the time, which with two centred boxes of
            // different sizes is `bottom` plus the difference in descent — near
            // enough at these sizes, and the alternative is measuring a font
            // this renderer will not measure. SCALES WITH THE CLOCK'S OWN 20%
            // — it is part of the clock, not the ETA that dropped its meridiem
            // entirely; see `crate::clock::eta`.
            if root.clock-meridiem != "": Text {
                text: " " + root.clock-meridiem;
                font-family: "DSEG7 Classic Mini";
                font-size: (Metrics.tall ? Metrics.s(20) : Metrics.s(17)) * 1.2;
                letter-spacing: 1px;
                color: Pal.dim;
                vertical-alignment: center;
            }
        }
    }

    // ── STAGE 1: THE CRUISE HAIRLINE (§4.9) ──────────────────────────────────
    //
    // "A 3dp amber hairline flush to the face's top inner edge, its width the
    // fraction of the way to the next turn."
    //
    // FLUSH TO THE INNER EDGE means y = 0 of the face's own box, above the
    // status bar's padding and outside every layout — so it costs no height and
    // nothing below it moves when a route starts. Same discipline as the clock.
    //
    // AMBER, WHICH IS THE FIXED SAFETY FAMILY. §4.9: "the maneuver is amber, the
    // fixed safety family (TA, motion tell) — never the blue accent, never a
    // band theme's palette." `Pal.amber` is not themeable and must not become so.
    //
    // IT DOES NOT ANIMATE. The bar is a distance readout, and one that eases
    // toward its target is wrong for the length of the easing — at 100 km/h the
    // driver covers 28 m a second, and the hairline's whole job is to be true
    // at a glance.
    if root.nav-stage != NavStage.idle: Rectangle {
        x: 0;
        y: 0;
        width: root.width * Math.clamp(root.nav-progress, 0.0, 1.0);
        height: 3px;
        background: Pal.amber;
    }

    // ── STAGE 1: THE ETA, HANGING UNDER THE CLOCK (§4.9) ─────────────────────
    //
    // "ETA directly under the clock — right-aligned to it, 7dp clear, and in the
    // UI face, not DSEG7: an `ETA` label at 11sp/700 with the time at 15sp/700
    // (17sp on the tall track), all `dim`. Distance-left joins it on the tall
    // track, where there is room."
    //
    // ── IT HANGS, IT DOES NOT PUSH ───────────────────────────────────────────
    //
    // A SEPARATE OUT-OF-FLOW BLOCK rather than a row inside the clock's, which
    // is the whole reason §4.8 centres the clock's LINE and not its block: "so
    // an ETA hanging below it (§4.9) changes neither the clock's size nor its
    // position, and moves nothing else on the face." Putting this inside the
    // clock's Rectangle would recentre the pair and shift the clock up the
    // moment a route started — the one thing the design is arranged to avoid.
    //
    // Its top is the clock line's bottom, computed from the same two anchors, so
    // the two cannot drift apart.
    //
    // THE UI FACE AND NOT DSEG7, which §4.9 states and which also matters
    // mechanically: `crate::clock::eta` pads nothing, because the segment font's
    // blank is a literal `!` in Atkinson.
    // NO FIT GUARD, AND ONE WAS TRIED: `clock-gap-bottom` is the hero CARD's
    // top line, the ETA hangs past it BY DESIGN — §4.8's own verification puts
    // it "in the empty space right of the hero card", which is BELOW that line —
    // and a guard demanding it stay above the anchor hid it on the head unit
    // itself. The clock takes the same liberty with the same anchor.
    // ── WHAT STAYS UNDER THE CLOCK, AND WHAT LEFT (v3.3.0 §7a.1) ────────────
    //
    // THE ETA MOVED OUT and is now the tail of the countdown line below — §7a.1:
    // "The ETA never appears under the clock in any stage — that would put it
    // directly above the clock, which is the wrong priority while navigating."
    // The owner confirms the move was their instruction to Claude Design.
    //
    // The 1.6x multiplier that used to size it here went with it. That was a
    // direct ask against the OLD placement ("the ETA display should be 60%
    // larger"), and §6 supersedes it with the pill's own sizes — 24sp, 26 on the
    // tall track. Superseded, not ignored.
    //
    // DISTANCE-LEFT STAYS, and §7a.1 says so in the same breath: "Distance-left
    // keeps its place under the clock on the tall track in every stage, cruising
    // included. Only the ETA moves." So this block survives with one child, on
    // the tall track alone, in every stage.
    property <bool> left-distance-showing: Metrics.tall
        && root.nav-left-distance != ""
        && root.nav-stage != NavStage.idle
        && root.clock-measured;
    property <length> left-distance-line-h: Metrics.s(15) * 1.4;
    if root.left-distance-showing: Rectangle {
        x: 0;
        y: root.clock-line-bottom + Metrics.s(7);
        width: root.width;
        height: root.left-distance-line-h;

        HorizontalLayout {
            alignment: end;
            // The same right padding the clock uses, so the two share an edge.
            padding-right: Metrics.pad-h;
            cross-axis-alignment: center;

            Text {
                text: root.nav-left-distance;
                font-family: Font.face; font-weight: Font.bold;
                font-size: Metrics.s(15);
                color: Pal.dim;
            }
        }
    }

    // ── STAGE 1: THE CRUISE COUNTDOWN (§4.9) ─────────────────────────────────
    //
    // "One centered line in the band between the genre line and the hero card's
    // top: `in` + the distance to the next turn, counting down (24sp/700 amber,
    // tabular, 26sp on the tall track) + the maneuver arrow at 26dp + the street
    // in `dim` at 18sp. Out of flow like the clock, so it costs no height."
    //
    // CRUISE ONLY, and §4.9 says why: "At stage 2 the strip carries the same
    // maneuver, larger; two copies of one turn on one screen is noise, so the
    // countdown ends when the strip yields."
    //
    // OUT OF FLOW, like the clock and the ETA — it costs no height and nothing
    // below it moves when a route starts.
    //
    // CENTRED IN THE BAND AND CLAMPED TO IT, which is the spec's own wording.
    // The clamp is what stops a short band (a tall surface with a deep status
    // column) pushing the line up over the genre or down over the hero card.
    property <length> countdown-top: status.genre-bottom;
    // "The hero card's top" is §4.9's own wording, and it is the same line the
    // clock anchors to — the card's, not the slot's, written back through
    // `Metrics` because the card's row is unreachable from here (see the clock's
    // anchor above). The two readouts sharing one anchor is what keeps them in
    // one band.
    property <length> countdown-bottom: Metrics.hero-card-top;
    property <length> countdown-line-h: Metrics.tall ? Metrics.s(26) * 1.35 : Metrics.s(24) * 1.35;
    // MEASURED MEANS THE ANCHORS EXIST, NOT THAT THE LINE FITS BETWEEN THEM —
    // and the difference emptied the face once. On the wide track the band
    // between the genre line and the card's top is thin, the line has always
    // overhung the card's flanks, and §4.8 places the ETA "in the empty space
    // right of the hero card" the same way. A guard that demanded the line fit
    // above the anchor hid the countdown on exactly the track it was built
    // for. The y below is order-safe instead.
    property <bool> countdown-measured: root.countdown-bottom > root.countdown-top;
    // ── THE LINE RUNS IN EVERY STAGE NOW (v3.3.0 §7a.1) ──────────────────────
    //
    // It was cruise-only, because the countdown text is. The ETA lives here now
    // and §7a.1 is explicit that it does not leave when the countdown does: "On
    // approach and turn now the countdown text drops away and the ETA stays in
    // that same line, alone, at the same size. The line is not cruise-only; only
    // its countdown text is."
    //
    // So the gate is "not idle, and there is something to put in it", and the
    // COUNTDOWN half carries its own `cruise` test below.
    property <bool> countdown-content: root.nav-stage == NavStage.cruise
        && root.nav-distance != "";
    if (root.countdown-content || root.nav-eta != "") && root.countdown-measured:
    Rectangle {
        // ── THE RECTANGLE IS THE BUDGET *AND* THE CLIP ───────────────────────
        //
        // The budget used to sit on the layout inside, and that only bounded
        // where the row STARTED. Slint's box layouts in alignment mode hand
        // every child its preferred size — nothing shrinks — so a long street
        // ("onto US-151 N, Dubuque" is what `formatStreetName` produces) grew
        // the row straight past the budget and back under the clock: the exact
        // collision the budget exists to prevent, returning for long names.
        // The bound lives on this Rectangle now and `clip: true` enforces it,
        // which is the RadioText strip's own precedent — "the references show
        // edge-clipped text".
        x: Metrics.tall ? Metrics.pad-h : 0;
        // 0.62 STAYS, AND WIDENING IT WAS TRIED AND REVERTED. The reasoning that
        // said it could widen is sound as far as it goes — the ETA left the
        // clock's column (v3.3.0 §7a.1), so what stacks under the clock now is
        // distance-left alone at 15sp instead of a 24sp x 1.6 readout, and the
        // column IS narrower. What that reasoning missed is that the ETA did not
        // leave the SCREEN: it moved into this row, so the row grew by a whole
        // pill at the same time the column shrank. At 0.68 the pill ran straight
        // into the segment clock — `shots/nav-cruise-portrait.png` showed it.
        //
        // So the street elides on the tall track, which is what an elide is for
        // and what this budget has always done. Of the two, an elided street
        // beats a pill overlapping the clock: §6 makes the ETA "the
        // highest-contrast element on the nav line", and a street name is the one
        // part of the line a driver can also read off the road.
        width: Metrics.tall ? root.width * 0.62 - Metrics.pad-h : root.width;
        height: root.countdown-line-h;
        // `max(min(…))` RATHER THAN `clamp`, because the bounds can cross: a
        // band shorter than the line makes `bottom - height` sit above `top`,
        // and what clamp does with an inverted range is not something to build
        // on. This order resolves the crossing toward `top` — the line stays
        // under the genre and overhangs the slot's empty top instead, which is
        // where the room actually is.
        y: Math.max(
            root.countdown-top,
            Math.min(
                (root.countdown-top + root.countdown-bottom) / 2 - self.height / 2,
                root.countdown-bottom - self.height));
        clip: true;

        // ── IT SHARES THE BAND WITH THE CLOCK, AND ON A NARROW FACE THAT
        //    MEANS GIVING WAY ─────────────────────────────────────────────────
        //
        // §4.9 puts this line in the same band the clock hangs in and centres
        // it. On the wide track that works exactly as drawn: the clock is flush
        // RIGHT and this is CENTRED, and 1024dp is wide enough that they never
        // touch. At 360dp they do — `shots/nav-cruise-portrait.png` had
        // "Whitney Way" running straight through the segment clock.
        //
        // So the tall track keeps the same band and the same anchor, and gives
        // way sideways instead: the line goes flush LEFT and takes a width
        // budget that stops short of the clock's column. A BUDGET AND NOT A
        // MEASUREMENT, because the clock's own box is inside a conditional and
        // Slint will not let its id out — 62% of the face leaves 137dp at
        // 360dp, which is more than the clock and its ETA occupy. The street
        // elides into whatever is left, which is what an elide is for.
        //
        // Stacking it under the clock was tried first and is worse: the band
        // between the ETA and the hero card is 8dp at that surface, and the line
        // disappeared entirely.
        HorizontalLayout {
            alignment: Metrics.tall ? LayoutAlignment.start : LayoutAlignment.center;
            spacing: Metrics.s(9);
            cross-axis-alignment: center;

            // A LABEL, NOT A WORD IN A SENTENCE — the v3.0.1 correction: at
            // 16-17sp lowercase it competed with the distance beside it.
            // s(13)/700/1.5px/uppercase reads as a tag the way the ETA
            // label and the `THEN` blocks above it do.
            if root.countdown-content: Text {
                text: "IN";
                font-family: Font.face; font-weight: Font.bold;
                font-size: Metrics.s(13);
                letter-spacing: 1.5px;
                color: Pal.dim;
            }
            if root.countdown-content: Text {
                text: root.nav-distance;
                font-family: Font.face; font-weight: Font.bold;
                font-size: Metrics.tall ? Metrics.s(26) : Metrics.s(24);
                // AMBER, THE FIXED SAFETY FAMILY — never a band theme's palette.
                color: Pal.amber;
            }
            // GATED ON THE PATH: an unknown turn type arrives as an empty
            // string, and an empty TurnArrow is not nothing — it is a hole
            // in the middle of the line. The distance and street still show,
            // which is `NavState::Unknown`'s own rule: the distance is good
            // and the glyph is not.
            if root.countdown-content && root.nav-arrow != "": TurnArrow {
                // The tall-track step the v3.0.1 correction found missing.
                size: Metrics.s(Metrics.tall ? 28 : 26);
                color: Pal.amber;
                commands: root.nav-arrow;
                exit: root.nav-exit;
                // 2.4 at 26dp, which is §4.9's own heavier weight.
                stroke-w: 2.4;
            }
            // THE STREET COLLAPSES WHEN IT IS MISSING rather than leaving a gap
            // — the handoff's rule for every field the poll may not carry.
            if root.countdown-content && root.nav-street != "": Text {
                text: root.nav-street;
                font-family: Font.face;
                // The tall-track step the v3.0.1 correction found missing.
                font-size: Metrics.s(Metrics.tall ? 19 : 18);
                color: Pal.dim;
                overflow: elide;
            }

            // ── THE ETA PILL (v3.3.0 §6) ─────────────────────────────────────
            //
            // "The highest-contrast element on the nav line", and the tail of the
            // countdown when there is one — `in · 1.4 km · ↱ · Whitney Way ·
            // ETA 4:52`. On approach and turn it is the only thing left in the
            // line, at the same size.
            //
            // THE FILL AND INK ARE `Pal.eta-pill` / `Pal.on-eta-pill`, which are
            // NOT the theme's amber on the light side — see their note: white on
            // `Pal.amber` fails AA and the fill is darkened rather than the type
            // faded. NO OPACITY ON THE LABEL either; §6 says it was tried at 0.82
            // and failed.
            if root.nav-eta != "": Rectangle {
                border-radius: Metrics.s(11);
                background: Pal.eta-pill;
                // WRAPPED TO THE ROW'S CONTENT. A Rectangle in a layout takes the
                // space offered, so the pill states its own size from the text
                // inside it — which is what the prototype's `inline-flex` and
                // `flex-shrink: 0` do.
                horizontal-stretch: 0;
                width: pill.preferred-width;
                height: pill.preferred-height;

                pill := HorizontalLayout {
                    padding-left: Metrics.s(Metrics.tall ? 12 : 11);
                    padding-right: Metrics.s(Metrics.tall ? 12 : 11);
                    padding-top: Metrics.s(Metrics.tall ? 7 : 6);
                    padding-bottom: Metrics.s(Metrics.tall ? 8 : 7);
                    spacing: Metrics.s(6);
                    cross-axis-alignment: end;

                    Text {
                        text: "ETA";
                        font-family: Font.face; font-weight: Font.bold;
                        font-size: Metrics.s(13);
                        letter-spacing: 1.5px;
                        color: Pal.on-eta-pill;
                    }
                    Text {
                        // NO MERIDIEM, SPELLED OUT OR ABBREVIATED — a direct ask
                        // that survives the move: `crate::clock::eta` appends
                        // none in 12-hour mode and 24-hour never had one.
                        text: root.nav-eta;
                        font-family: Font.face; font-weight: Font.bold;
                        font-size: Metrics.s(Metrics.tall ? 26 : 24);
                        color: Pal.on-eta-pill;
                    }
                }
            }
        }
    }

    // §4.7: a darker veil over the rest of the face. The hero band sits above it.
    if root.dead: Rectangle {
        background: Pal.screen-veil;
    }

    // ── Hero band ──
    Rectangle {
        x: hero-slot.x;
        y: hero-slot.y;
        width: hero-slot.width;
        height: hero-slot.height;

        // Wide: the hero row takes the leftover height, with the RadioText zone
        // pinned beneath it.
        if !Metrics.tall: VerticalLayout {
            spacing: 16px;
            HeroRow {
                // §4.9's stage 3 — the hero card carries the maneuver.
                nav-stage: root.nav-stage;
                nav-arrow: root.nav-arrow;
                nav-exit: root.nav-exit;
                nav-distance: root.nav-distance;
                nav-street: root.nav-street;
                vertical-stretch: 1;
                card-w: Metrics.hero-card-w;
                card-fill: true;
                step-nonce: root.step-nonce;
                step-dir: root.step-dir;
                morph-note(m) => { root.morph-note(m); }
                morph-frame() => { root.morph-frame(); }
                egg: root.egg;
                ident-a: root.ident-a;
                ident-b: root.ident-b;
                ident: root.ident;
                freq-label: root.freq-label;
                logo: root.logo;
                has-logo: root.has-logo;
                logo-plate: root.logo-plate;
                show-call: root.show-call;
                show-freq: root.show-freq;
                saved: root.saved;
                dead: root.dead;
                scanning: root.scanning;
                has-prev: root.has-prev;
                has-next: root.has-next;
                prev-preset: root.prev-preset;
                next-preset: root.next-preset;
                ghost-preset: root.ghost-preset;
                outgoing: root.outgoing;
                hand-off: root.hand-off;
                step(d) => { root.step-preset(d); }
                toggle-save => { root.toggle-save(); }
                toggle-audio => { if (root.dead) { root.claim-audio(); } else { root.release-audio(); } }
            }
            Rectangle {
                vertical-stretch: 0;
                height: Metrics.rt-zone-h;
                RadioTextStrip {
                    // Centred in its zone: the strip is 64 tall on every track
                    // and the ZONE around it is what varies. The zone is FLOORED
                    // at the strip's own height (tokens.slint:305), so "centred"
                    // can never mean "overhanging" — three of the four per-track
                    // zone figures are smaller than the strip.
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: Math.min(parent.width, Metrics.s(880));
                    text: root.radio-text;
                    egg: root.egg;
                    // `visible`, NOT `opacity: 0` — the mechanism is spelled out
                    // at hero.slint:1769-1779. `Opacity::need_layer` returns false
                    // only at 1.0 or for a CHILDLESS subtree, and this strip is a
                    // whole subtree, so a zero-opacity one had Skia allocate a
                    // `save_layer_alpha`, draw the plate, the marquee and every
                    // synthetic-bold copy into it and composite the result at
                    // alpha zero — for as long as audio priority stayed released.
                    // `visible: false` lowers to an empty clip and draws nothing.
                    // The zone Rectangle above holds the height either way, so
                    // the column does not collapse.
                    visible: !root.dead;
                    // §4.9's stages 2 and 3 — the strip carries the maneuver,
                    // then the turn after it once the hero card takes over.
                    nav-stage: root.nav-stage;
                    nav-arrow: root.nav-arrow;
                    nav-exit: root.nav-exit;
                    nav-distance: root.nav-distance;
                    nav-street: root.nav-street;
                    nav-after-arrow: root.nav-after-arrow;
                    nav-after-exit: root.nav-after-exit;
                    nav-after-street: root.nav-after-street;
                }
            }
        }

        // Tall: the leftover height is DISTRIBUTED, not pooled. Three equal
        // flexible gaps — above the hero, hero to RadioText, RadioText to the
        // preset shelf — put the hero upper-middle and centre the strip in the
        // space beneath it, instead of pooling all the slack at the bottom.
        if Metrics.tall: VerticalLayout {
            padding-top: 14px;
            spacing: 0px;
            Rectangle { vertical-stretch: 1; }
            HeroRow {
                // §4.9's stage 3 — the hero card carries the maneuver.
                nav-stage: root.nav-stage;
                nav-arrow: root.nav-arrow;
                nav-exit: root.nav-exit;
                nav-distance: root.nav-distance;
                nav-street: root.nav-street;
                vertical-stretch: 0;
                card-w: Metrics.tall-hero-w;
                card-fill: false;
                step-nonce: root.step-nonce;
                step-dir: root.step-dir;
                morph-note(m) => { root.morph-note(m); }
                morph-frame() => { root.morph-frame(); }
                egg: root.egg;
                ident-a: root.ident-a;
                ident-b: root.ident-b;
                ident: root.ident;
                freq-label: root.freq-label;
                logo: root.logo;
                has-logo: root.has-logo;
                logo-plate: root.logo-plate;
                show-call: root.show-call;
                show-freq: root.show-freq;
                saved: root.saved;
                dead: root.dead;
                scanning: root.scanning;
                has-prev: root.has-prev;
                has-next: root.has-next;
                prev-preset: root.prev-preset;
                next-preset: root.next-preset;
                // THE TALL TRACK GETS THE MORPH TOO. §8's note is explicit: the
                // peek cards animate on both layout tracks, and only the
                // preset-band chevrons are wide-only. This binding was added to
                // the wide HeroRow above and missed here, which would have left
                // the discarded card popping out of existence on the tall track
                // while the wide one faded it correctly — the harder half of a
                // bug to notice, because the track that is looked at most is the
                // one that works.
                ghost-preset: root.ghost-preset;
                outgoing: root.outgoing;
                hand-off: root.hand-off;
                step(d) => { root.step-preset(d); }
                toggle-save => { root.toggle-save(); }
                toggle-audio => { if (root.dead) { root.claim-audio(); } else { root.release-audio(); } }
            }
            Rectangle { vertical-stretch: 1; }
            Rectangle {
                vertical-stretch: 0;
                height: Metrics.rt-zone-h;
                RadioTextStrip {
                    // Centred in its zone: the strip is 64 tall on every track
                    // and the ZONE around it is what varies. The zone is FLOORED
                    // at the strip's own height (tokens.slint:305), so "centred"
                    // can never mean "overhanging" — three of the four per-track
                    // zone figures are smaller than the strip.
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: Math.min(parent.width, Metrics.s(880));
                    text: root.radio-text;
                    egg: root.egg;
                    // `visible`, NOT `opacity: 0` — the mechanism is spelled out
                    // at hero.slint:1769-1779. `Opacity::need_layer` returns false
                    // only at 1.0 or for a CHILDLESS subtree, and this strip is a
                    // whole subtree, so a zero-opacity one had Skia allocate a
                    // `save_layer_alpha`, draw the plate, the marquee and every
                    // synthetic-bold copy into it and composite the result at
                    // alpha zero — for as long as audio priority stayed released.
                    // `visible: false` lowers to an empty clip and draws nothing.
                    // The zone Rectangle above holds the height either way, so
                    // the column does not collapse.
                    visible: !root.dead;
                    // §4.9's stages 2 and 3 — the strip carries the maneuver,
                    // then the turn after it once the hero card takes over.
                    nav-stage: root.nav-stage;
                    nav-arrow: root.nav-arrow;
                    nav-exit: root.nav-exit;
                    nav-distance: root.nav-distance;
                    nav-street: root.nav-street;
                    nav-after-arrow: root.nav-after-arrow;
                    nav-after-exit: root.nav-after-exit;
                    nav-after-street: root.nav-after-street;
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
