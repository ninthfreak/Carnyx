// The frequency-entry pieces, and the "Enter frequency" tab built out of them
// (mini-handoff "Tune overlay: Nearby / Enter frequency tabs").
//
// THIS FILE USED TO BE AN OVERLAY. It was the standalone direct-entry card you
// got by tapping the hero's frequency — its own scrim, its own 440dp card, its
// own TUNE title. The mini-handoff folds it into the nearby picker as the second
// of two tabs and removes the hero tap, so the scrim, the card and the title are
// gone; what is left is the keypad's parts and the column they stand in. The
// column is `FreqPad`, and `nearby.slint` puts it where the station list goes.
//
// WHERE THE NUMBERS COME FROM, and a gap worth knowing about. The mini-handoff
// names `NearbyPicker.dc.html` at v1.14.6 as the reference for this tab. The
// bundle in this tree is v1.10.0 and its NearbyPicker has no tabs at all — it
// still draws the old title-and-subtitle header — so the v1.14.6 file cannot be
// read here. Every metric below is therefore the mini-handoff's own §4, which
// states all of them; nothing is inferred from a reference that is not present.
// The PIECES keep the citations they were built with, because the mini-handoff
// restyles them rather than redrawing them: same keypad, same seek row, same
// CANCEL/TUNE pair, new sizes.
//
// WHAT CHANGED FROM THE OLD CARD, all of it from §4 and §5:
//
//   readout     78 → 62dp tall, value 46 → 42sp
//   seek row    56 → 48dp tall
//   keys        64 → 48dp tall, radius 14 → 12 (the readout, seek row and
//               actions stay at 14 — the keypad alone drops)
//   actions     60 → 52dp tall
//   column gap  14 → 9dp, and the column is capped at 440dp and CENTRED in the
//               tab body rather than being the card's own width
//   title       gone; the tab's own label is the title
//   compact     gone. The old card had a second metric set for surfaces under
//               560dp tall; §4 gives one set and a scroll container for "shorter
//               head-unit slices", which is what this is.
//
// The 48dp tap floor stays. §10 makes it a safety constraint in REAL dp, and it
// is not a no-op here any more: at k=1 the new keys ARE 48dp, so any surface that
// ramps below k=1 would put them under the floor without it.
//
// SLINT DECIDES NOTHING HERE. No string is formatted, no value parsed, no band
// compared. Everything arrives finished; see the property comments for the
// contract.

import { Pal, Metrics, Font } from "tokens.slint";
import { OverlayCard } from "overlay.slint";

// ── The backspace glyph ─────────────────────────────────────────────────────
//
// U+232B ERASE TO THE LEFT is NOT in either bundled Atkinson cut — I read the
// cmaps of ui/fonts/AtkinsonHyperlegible-{Regular,Bold}.ttf: ‹ › – . are present,
// ⚠ ⌫ ✕ ✓ ★ are not. CarFmLive.dc.html:333 renders "⌫" as text and only got a
// glyph because a browser fallback font supplied one; the software renderer that
// produces our screenshots has no fallback stack to lean on. So the key draws the
// icon, which is what Numpad.tsx:110 does anyway (`<BackspaceIcon size={30} …>`).
//
// This is the TENTH icon and it belongs in icons.slint beside the other nine, with
// icons.slint's `VPath` wrapper. Both are duplicated here ONLY because this pass
// was scoped to one file and icons.slint belongs to another agent — see the report.
// The wrapper below is icons.slint:19-40 verbatim; do not let the two drift.

// Slint's Path fits its geometry into (element size − stroke width) and then nudges
// it back by half a stroke, and it does NOT scale stroke width with the viewbox —
// both differ from SVG. This wrapper cancels the difference.
component VPath inherits Path {
    in property <length> box-w;
    in property <length> box-h;
    in property <float> vbw;
    in property <float> vbh;
    /// Stroke width in VIEWBOX units, as written in the SVG.
    in property <float> raw-stroke: 0;

    // preserveAspectRatio="xMidYMid meet" — uniform, so the smaller ratio wins.
    property <float> sc: Math.min(root.box-w / 1px / root.vbw, root.box-h / 1px / root.vbh);

    viewbox-width: root.vbw;
    viewbox-height: root.vbh;
    stroke-width: root.raw-stroke * root.sc * 1px;
    x: 0px - self.stroke-width / 2;
    y: 0px - self.stroke-width / 2;
    width: root.box-w + self.stroke-width;
    height: root.box-h + self.stroke-width;
}

/// Backspace — the keypad's twelfth key.
///
/// Exact port of CarFM's `icons.tsx:350-359`: viewBox 24×24, stroke 1.8, no fill.
/// The SVG splits it into a closed body (round joins) and two crossing lines (round
/// caps); one Path carries both correctly, because the body is closed with `z` so
/// its caps never show and the two lines have no joins.
component BackspaceIcon {
    in property <length> size: 30px;
    in property <color> color;

    width: root.size;
    height: root.size;

    VPath {
        box-w: root.size; box-h: root.size; vbw: 24; vbh: 24; raw-stroke: 1.8;
        commands: "M8.2 5h11.3A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5H8.2a1.5 1.5 0 0 1-1.1-.5L2 12l5.1-6.5a1.5 1.5 0 0 1 1.1-.5z M11 9.5 L16 14.5 M16 9.5 L11 14.5";
        stroke: root.color;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// ── Rounded warning triangle ────────────────────────────────────────────────
//
// Same story as the backspace glyph: both references lead the error line with a
// literal "⚠", and U+26A0 is absent from the app font. Carnyx already ships the
// mark drawn (icons.slint's WarningTriangle, used by the tuner-error pill at
// status-bar.slint:360) as well as typed (status-bar.slint:265's literal
// "⚠ OUT OF FM BAND"). Drawn is the only one that survives the software renderer,
// so the numpad draws it — and `error-text` therefore arrives WITHOUT the mark.
//
// Duplicated from icons.slint:236-250 for the same one-file reason as VPath.
component WarnMark {
    in property <length> size: 26px;
    in property <color> color;

    width: root.size;
    height: root.size;

    VPath {
        box-w: root.size; box-h: root.size; vbw: 24; vbh: 24; raw-stroke: 2;
        commands: "M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9 L12 13 M12 17 L12.01 17";
        stroke: root.color;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// ── The three button shapes ─────────────────────────────────────────────────
//
// All three dim to 0.55 while held. That is Numpad.tsx (76, 84, 104, 118, 129) and
// only the TSX — the dc.html is a web demo and carries nothing but `cursor:pointer`
// — so it is behaviour, and it is the same 0.55 CloseButton already uses
// (overlay.slint:49).

/// One keypad key. Twelve of these, row-major.
component NumpadKey inherits Rectangle {
    /// The literal character, and its own accessibility label (Numpad.tsx:107).
    in property <string> label;
    /// The backspace key draws the icon instead of a character.
    in property <bool> erase: false;
    in property <length> box-h;
    in property <length> radius;
    in property <length> label-size;
    /// 30dp in BOTH branches (Numpad.tsx:110) — the icon is one of the three things
    /// the compact branch leaves alone, along with the "MHz" unit and, in the TSX
    /// only, the seek button's radius. It still rides the k ramp, like every other
    /// design dimension.
    in property <length> icon-size: Metrics.s(30);

    callback clicked();

    // Equal thirds. The references get there two different ways — `width:'30.5%'`
    // plus flexGrow (Numpad.tsx:169) and `calc((100% − 24px)/3)`
    // (CarFmLive.dc.html:328) — and the dc.html's fixed 24 is stale in the compact
    // branch, where the gap is 9 and its keys come out ~2dp narrow. An equal share
    // of the row does it with no card width in any binding at all, which also keeps
    // the grid out of the width-dependency graph.
    horizontal-stretch: 1;
    min-width: 0px;

    vertical-stretch: 0;
    height: root.box-h;
    border-radius: root.radius;
    border-width: 1px;
    border-color: Pal.border;
    background: Pal.raised;
    opacity: touch.pressed ? 0.55 : 1.0;

    accessible-role: button;
    accessible-label: root.erase ? "Delete" : root.label;

    touch := TouchArea { clicked => { root.clicked(); } }

    if !root.erase: Text {
        text: root.label;
        font-family: Font.face;
        font-weight: Font.bold;
        font-size: root.label-size;
        color: Pal.text;
    }
    if root.erase: BackspaceIcon {
        size: root.icon-size;
        color: Pal.text;
    }
}

/// One of the two seek buttons. `up` picks the direction AND the glyph order:
/// chevron-then-label going down, label-then-chevron going up (Numpad.tsx:79-88).
component SeekButton inherits Rectangle {
    in property <bool> up: false;
    in property <length> box-h;
    in property <length> radius;
    in property <length> glyph-size;
    in property <length> label-size;
    in property <length> inner-gap;

    callback clicked();

    horizontal-stretch: 1;
    min-width: 0px;
    vertical-stretch: 0;
    height: root.box-h;
    border-radius: root.radius;
    border-width: 1px;
    border-color: Pal.border;
    background: Pal.raised;
    opacity: touch.pressed ? 0.55 : 1.0;

    accessible-role: button;
    accessible-label: root.up ? "Seek up to next station" : "Seek down to previous station";

    touch := TouchArea { clicked => { root.clicked(); } }

    HorizontalLayout {
        alignment: center;
        spacing: root.inner-gap;

        // "‹‹" and "››" are two U+2039 / U+203A SINGLE ANGLE QUOTATION MARKs each,
        // not guillemets and not an icon. I checked the cmaps: both codepoints are
        // in the bundled Regular and Bold, so they render from the app font and no
        // path is needed. Blue, per CarFmLive.dc.html:406 — see the disagreement
        // note on the root; the TSX draws them in Pal.text.
        if !root.up: Text {
            text: "‹‹";
            font-family: Font.face;
            font-weight: Font.bold;
            font-size: root.glyph-size;
            // Inherited from the button in the dc.html, which applies it to the
            // chevron pair too. Letter-spacing stays raw px everywhere in ui/
            // (presets.slint:29/479, status-bar.slint:37).
            letter-spacing: 1.5px;
            color: Pal.blue;
        }

        Text {
            text: "SEEK";
            font-family: Font.face;
            font-weight: Font.bold;
            font-size: root.label-size;
            letter-spacing: 1.5px;
            color: Pal.text;
        }

        if root.up: Text {
            text: "››";
            font-family: Font.face;
            font-weight: Font.bold;
            font-size: root.glyph-size;
            letter-spacing: 1.5px;
            color: Pal.blue;
        }
    }
}

/// CANCEL and TUNE. Same box; TUNE takes the blue border, the blue fill and the
/// disabled state.
component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    /// TUNE only: false while the buffer is empty (Numpad.tsx:125-128), which dims
    /// the button to 0.4 and swallows the tap.
    in property <bool> enabled: true;
    in property <length> box-h;
    in property <length> radius;
    in property <length> label-size;

    callback clicked();

    horizontal-stretch: 1;
    min-width: 0px;
    vertical-stretch: 0;
    height: root.box-h;
    border-radius: root.radius;
    // 1.5px on TUNE (CarFmLive.dc.html:414), 1px on CANCEL. A border weight, so it
    // stays raw px like the 1.5px pill borders in status-bar.slint:258/351.
    border-width: root.primary ? 1.5px : 1px;
    border-color: root.primary ? Pal.blue : Pal.border;
    // CANCEL has no fill in either reference; only TUNE does.
    background: root.primary ? Pal.blue-fill : transparent;
    opacity: !root.enabled ? 0.4 : (touch.pressed ? 0.55 : 1.0);

    accessible-role: button;
    accessible-label: root.label;

    touch := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }

    Text {
        text: root.label;
        font-family: Font.face;
        font-weight: Font.bold;
        font-size: root.label-size;
        letter-spacing: 1px;
        color: root.primary ? Pal.blue : Pal.dim;
    }
}

// ── The tab body ────────────────────────────────────────────────────────────

/// The "Enter frequency" tab: readout, seek row, error line, keypad, actions.
///
/// Drops straight into the overlay card's body band — it carries the
/// `vertical-stretch: 1` and the scroll surface itself, so the caller only has to
/// hand it a side padding and gate it on the tab.
///
/// IT SCROLLS, AND IT CENTRES, which are the same mechanism seen from two sides.
/// §4 puts the column in a scroll container and also asks for it "vertically
/// centred (`margin: auto 0`)". A Flickable whose viewport is exactly its own
/// height centres its content and cannot be dragged; one whose viewport is taller
/// scrolls and centring stops meaning anything. So the viewport is the larger of
/// the two and the column centres inside it, which is both behaviours from one
/// binding. §4 says the column is 414dp in a 495dp body at 900×600, so the
/// scrolling half only ever runs on a short head-unit slice.
export component FreqPad inherits Rectangle {
    // ── What Rust supplies ──────────────────────────────────────────────────

    /// The whole readout string, already chosen and already formatted: the typed
    /// buffer when there is one, otherwise the live frequency — or the sweeping
    /// value while a seek is running (§5, "the readout shows the buffer while
    /// typing, otherwise the live frequency (or the sweeping value while
    /// seeking)").
    ///
    /// Mid-typing this is the raw buffer, so "1", "10", "104", "104." and "104.5"
    /// are all legitimate values — do NOT normalise it before it gets here.
    in property <string> display;

    /// True when `display` is the station you are ON rather than something you
    /// typed or a sweep in flight. Picks 0.45 vs 1.0 opacity, so a freshly opened
    /// tab does not look as though the current frequency had been entered.
    in property <bool> display-dim: true;

    /// Shows the out-of-band line (§6, `freqError`).
    in property <bool> error: false;

    /// That line's text, finished, and WITHOUT a leading "⚠": the mark is drawn
    /// (see WarnMark above), not typed.
    in property <string> error-text;

    // ── What the user can do ────────────────────────────────────────────────

    /// A keypad character: "1".."9", "0" or "." (U+002E FULL STOP).
    callback enter(string);
    /// The twelfth key. A callback of its own rather than `enter("⌫")`, because
    /// that sentinel is a character the app font cannot draw.
    callback backspace();
    /// −1 down / +1 up. The sweep runs with the overlay OPEN and the readout
    /// follows it (§5).
    callback seek(int);
    /// TUNE. §5: it commits the buffer and closes the overlay, and an empty or
    /// invalid buffer closes without retuning — so there is no disabled state
    /// here and no `can-tune`. The button is always live.
    callback tune();
    /// CANCEL. §5: abandons entry and restores the frequency the tab opened on.
    /// The ✕ and the scrim land on the same thing while this tab is up.
    callback cancel();

    // ── Metrics ─────────────────────────────────────────────────────────────

    /// The overlay's own side padding, so the column lines up with the station
    /// list's rows when the tab is switched (§4, "padding `8dp / sidePad`").
    in property <length> side-pad: Metrics.s(22);

    /// §10's "hit targets ≥ 48dp in real dp (not a scaled-down canvas)", applied
    /// where the ramp would otherwise break it. See the file header: at k=1 the
    /// keys and the seek row are exactly 48, so this is live, not spare.
    in property <length> tap-floor: 48px;

    // §4, all of it. One set — there is no compact branch any more.
    property <length> g: Metrics.s(9);
    property <length> box-radius: Metrics.s(14);
    /// The keypad alone drops to 12; the readout, seek row and actions stay at 14.
    property <length> key-radius: Metrics.s(12);
    property <length> disp-h: Metrics.s(62);
    property <length> value-size: Metrics.s(42);
    property <length> unit-size: Metrics.s(18);
    property <length> seek-h: Math.max(root.tap-floor, Metrics.s(48));
    property <length> key-h: Math.max(root.tap-floor, Metrics.s(48));
    property <length> key-font: Metrics.s(26);
    property <length> action-h: Math.max(root.tap-floor, Metrics.s(52));
    /// §4's `max-width: 440dp`, and the column takes the body's width below it.
    property <length> col-w: Math.min(root.width - 2 * root.side-pad, Metrics.s(440));
    /// The scroll fade's depth. NOT the column's 8dp padding, which is what it
    /// was first written as: 8dp of gradient is invisible at a glance and the
    /// whole point of the band is to be seen. It is not a §4 dimension — §4 has
    /// no fade, because a browser has the card's own shadow to lean on and the
    /// software renderer's `draw_box_shadow` is an empty TODO.
    property <length> fade-h: Metrics.s(20);

    vertical-stretch: 1;
    // The scroll surface is placed with explicit x/y, exactly as in OverlayBody
    // and presets.slint's rail, so it cannot report a content-sized minimum back
    // up into the card's layout.
    min-height: 0px;

    flick := Flickable {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        // Vertical only — a keypad has no horizontal travel.
        viewport-width: self.width;
        viewport-height: Math.max(self.height, col.preferred-height);
        // Nothing to scroll means nothing to drag: a keypad that slid a few dp
        // under a fingertip in a moving car would swallow the tap.
        interactive: col.preferred-height > self.height;

        col := VerticalLayout {
            // Centres the column when the body has slack, which is the case §4
            // sizes for; when it does not, the viewport above has already grown
            // and there is no slack left to centre in.
            alignment: center;
            padding-left: root.side-pad;
            padding-right: root.side-pad;
            padding-top: Metrics.s(8);
            padding-bottom: Metrics.s(8);

            HorizontalLayout {
                alignment: center;

                VerticalLayout {
                    // An explicit width inside a centred row, the shape
                    // nearby.slint's genre divider already proves: it pins the
                    // column at the cap instead of letting it shrink to the
                    // widest key.
                    width: root.col-w;
                    spacing: root.g;

                    // ── Readout ──
                    //
                    // The value and the unit are placed by hand rather than laid
                    // out: §4 baseline-aligns them and Slint has no baseline
                    // alignment, so the PAIR's relationship is computed and the
                    // pair is centred in the box.
                    Rectangle {
                        vertical-stretch: 0;
                        height: root.disp-h;
                        border-radius: root.box-radius;
                        background: Pal.raised;
                        // A hairline — the stated exception to the Metrics.s rule.
                        border-width: 1px;
                        // The amber border is this file's own carry-over from the
                        // old card: §4 gives the readout a plain `border` and says
                        // nothing about an error state for it, while §4.3 puts the
                        // error on its own line below. Kept because the line alone
                        // is easy to miss at a glance in a moving car, and it
                        // costs nothing when `error` is false.
                        border-color: root.error ? Pal.amber : Pal.border;
                        clip: true;

                        // §4's `gap: 10`.
                        property <length> pair-gap: Metrics.s(10);
                        property <length> pair-w: val.width + self.pair-gap + unit.width;

                        val := Text {
                            x: (parent.width - parent.pair-w) / 2;
                            y: (parent.height - self.height) / 2;
                            text: root.display;
                            font-family: Font.face;
                            font-weight: Font.bold;
                            font-size: root.value-size;
                            // Fixed safety colour, both themes, never re-themed (§10).
                            color: Pal.amber;
                            letter-spacing: -1px;
                            opacity: root.display-dim ? 0.45 : 1.0;
                        }

                        // "MHz". §10: the only place this string is allowed
                        // anywhere in the app, which is also why status-bar.slint's
                        // out-of-band pill carries no unit. The mini-handoff's own
                        // error copy now says "MHz" too — see `error-text`'s
                        // caller — so the tab is the one place it appears twice.
                        //
                        // Baseline-matched to the value. Atkinson's ascender is
                        // 950/1000 upem in both cuts (read off the bundled TTFs;
                        // typo and win agree), so a top-aligned line box puts its
                        // baseline 0.95em down and the drop that lines the two up
                        // is 0.95 × the size difference: 22.8dp at 42/18.
                        unit := Text {
                            x: val.x + val.width + parent.pair-gap;
                            y: val.y + Math.round((root.value-size - root.unit-size) / 1px * 0.95) * 1px;
                            text: "MHz";
                            font-family: Font.face;
                            font-weight: Font.bold;
                            font-size: root.unit-size;
                            color: Pal.dim;
                        }
                    }

                    // ── Seek row ──
                    //
                    // LEFT is down (−1), RIGHT is up (+1); §4 puts the chevrons on
                    // the OUTER side of each label, which is what `up` selects.
                    HorizontalLayout {
                        spacing: root.g;

                        SeekButton {
                            up: false;
                            box-h: root.seek-h;
                            radius: root.box-radius;
                            glyph-size: Metrics.s(22);
                            label-size: Metrics.s(15);
                            inner-gap: Metrics.s(10);
                            clicked => { root.seek(-1); }
                        }
                        SeekButton {
                            up: true;
                            box-h: root.seek-h;
                            radius: root.box-radius;
                            glyph-size: Metrics.s(22);
                            label-size: Metrics.s(15);
                            inner-gap: Metrics.s(10);
                            clicked => { root.seek(1); }
                        }
                    }

                    // ── Band error ──
                    //
                    // Between the seek row and the keypad, which is §4's order.
                    // Nothing here is ever closed or cleared by it.
                    if root.error: HorizontalLayout {
                        alignment: center;
                        // Sized off the one warning-mark-beside-amber-text pairing
                        // the codebase already ships: status-bar.slint:354-367 puts
                        // a 26dp triangle beside 17dp bold amber text with 11dp
                        // between them. At this line's 14dp that is 21dp and 9dp.
                        spacing: Metrics.s(9);

                        VerticalLayout {
                            alignment: center;
                            WarnMark { size: Metrics.s(21); color: Pal.amber; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.error-text;
                                horizontal-alignment: center;
                                font-family: Font.face;
                                font-weight: Font.bold;
                                font-size: Metrics.s(14);
                                letter-spacing: 0.5px;
                                color: Pal.amber;
                            }
                        }
                    }

                    // ── Keypad ──
                    //
                    // Exactly 12 keys, 4 rows × 3 columns, row-major:
                    // [1 2 3] [4 5 6] [7 8 9] [. 0 ⌫]. Written out as four rows
                    // because Slint has no flex-wrap, and because an `if`-free
                    // explicit grid keeps every id in scope. §4's
                    // `calc((100% - 18dp) / 3)` is an equal share of the row with
                    // two 9dp gaps taken out, which is what these stretch to.
                    VerticalLayout {
                        spacing: root.g;

                        HorizontalLayout {
                            spacing: root.g;
                            NumpadKey {
                                label: "1"; box-h: root.key-h;
                                radius: root.key-radius; label-size: root.key-font;
                                clicked => { root.enter("1"); }
                            }
                            NumpadKey {
                                label: "2"; box-h: root.key-h;
                                radius: root.key-radius; label-size: root.key-font;
                                clicked => { root.enter("2"); }
                            }
                            NumpadKey {
                                label: "3"; box-h: root.key-h;
                                radius: root.key-radius; label-size: root.key-font;
                                clicked => { root.enter("3"); }
                            }
                        }
                        HorizontalLayout {
                            spacing: root.g;
                            NumpadKey {
                                label: "4"; box-h: root.key-h;
                                radius: root.key-radius; label-size: root.key-font;
                                clicked => { root.enter("4"); }
                            }
                            NumpadKey {
                                label: "5"; box-h: root.key-h;
                                radius: root.key-radius; label-size: root.key-font;
                                clicked => { root.enter("5"); }
                            }
                            NumpadKey {
                                label: "6"; box-h: root.key-h;
                                radius: root.key-radius; label-size: root.key-font;
                                clicked => { root.enter("6"); }
                            }
                        }
                        HorizontalLayout {
                            spacing: root.g;
                            NumpadKey {
                                label: "7"; box-h: root.key-h;
                                radius: root.key-radius; label-size: root.key-font;
                                clicked => { root.enter("7"); }
                            }
                            NumpadKey {
                                label: "8"; box-h: root.key-h;
                                radius: root.key-radius; label-size: root.key-font;
                                clicked => { root.enter("8"); }
                            }
                            NumpadKey {
                                label: "9"; box-h: root.key-h;
                                radius: root.key-radius; label-size: root.key-font;
                                clicked => { root.enter("9"); }
                            }
                        }
                        HorizontalLayout {
                            spacing: root.g;
                            // U+002E FULL STOP, not a middle dot.
                            NumpadKey {
                                label: "."; box-h: root.key-h;
                                radius: root.key-radius; label-size: root.key-font;
                                clicked => { root.enter("."); }
                            }
                            NumpadKey {
                                label: "0"; box-h: root.key-h;
                                radius: root.key-radius; label-size: root.key-font;
                                clicked => { root.enter("0"); }
                            }
                            // The twelfth slot carries no `label`: the app font has
                            // no glyph for "⌫", so the key draws the icon.
                            NumpadKey {
                                erase: true; box-h: root.key-h;
                                radius: root.key-radius; label-size: root.key-font;
                                clicked => { root.backspace(); }
                            }
                        }
                    }

                    // ── Actions ──
                    //
                    // CANCEL left, TUNE right. The old card gave this row 4dp more
                    // space than the column's gap; §4 lists it as one more item in
                    // a 9dp column, so the extra is gone.
                    HorizontalLayout {
                        spacing: root.g;

                        ActionButton {
                            label: "CANCEL";
                            box-h: root.action-h;
                            radius: root.box-radius;
                            label-size: Metrics.s(16);
                            clicked => { root.cancel(); }
                        }
                        ActionButton {
                            label: "TUNE";
                            primary: true;
                            box-h: root.action-h;
                            radius: root.box-radius;
                            label-size: Metrics.s(16);
                            clicked => { root.tune(); }
                        }
                    }
                }
            }
        }
    }

    // Scroll affordance. There is no drop shadow to lean on — the software
    // renderer's `draw_box_shadow` is an empty TODO — and a CANCEL/TUNE row that
    // has fallen below the fold with nothing to say so is the worst failure this
    // tab has. Explicit x/y keeps it out of the parent's layout info, so it costs
    // the column nothing. It fades to the card fill, which is Pal.bg here — the
    // picker's card, not the old numpad's panel.
    Rectangle {
        x: 0;
        y: parent.height - root.fade-h;
        width: parent.width;
        height: root.fade-h;
        // Only while something is still below: viewport-y is ≤ 0, so this goes
        // false exactly at the bottom of the travel.
        visible: flick.viewport-height + flick.viewport-y > flick.height;
        background: @linear-gradient(180deg, Pal.bg.with-alpha(0.0) 0%, Pal.bg 100%);
    }
}
