}

// ── Nearby: magnifier over a radio tower (§7) ───────────────────────────────
//
// A thin-line lens containing a tower — straight A-frame legs widening to the
// base, one X-brace, an antenna mast and tip dot, and symmetric radiating waves,
// all bowed by a subtle barrel warp (lens refraction). The warp is why the tower
// segments below are polylines rather than straight lines.
export component MagnifierTower {
    in property <length> size: 92px;
    in property <color> line;
    in property <color> glass;

    width: root.size;
    height: root.size;

    VPath {   // lens glaze
        box-w: root.size; box-h: root.size; vbw: 32; vbh: 32;
        commands: "M3.6 14.3 A11.2 11.2 0 1 0 26 14.3 A11.2 11.2 0 1 0 3.6 14.3 Z";
        fill: root.glass;
    }
    VPath {   // lens rim
        box-w: root.size; box-h: root.size; vbw: 32; vbh: 32; raw-stroke: 1.6;
        commands: "M2.8 14.3 A12 12 0 1 0 26.8 14.3 A12 12 0 1 0 2.8 14.3 Z";
        stroke: root.line;
    }
    VPath {   // A-frame legs
        box-w: root.size; box-h: root.size; vbw: 32; vbh: 32; raw-stroke: 1.1;
        commands: "M10.46 22.56 L10.86 21.40 L11.27 20.20 L11.70 18.97 L12.13 17.71 L12.58 16.44 L13.03 15.16 L13.48 13.87 L13.94 12.58 M19.14 22.56 L18.74 21.40 L18.33 20.20 L17.90 18.97 L17.47 17.71 L17.02 16.44 L16.57 15.16 L16.12 13.87 L15.66 12.58";
        stroke: root.line; stroke-line-cap: round; stroke-line-join: round;
    }
    VPath {   // X-brace
        box-w: root.size; box-h: root.size; vbw: 32; vbh: 32; raw-stroke: 1.0;
        commands: "M12.50 16.65 L13.32 17.35 L14.15 18.04 L14.96 18.72 L15.78 19.40 L16.59 20.07 L17.38 20.72 L18.17 21.36 L18.94 21.98 M17.10 16.65 L16.28 17.35 L15.45 18.04 L14.64 18.72 L13.82 19.40 L13.01 20.07 L12.22 20.72 L11.43 21.36 L10.66 21.98";
        stroke: root.line; stroke-line-cap: round;
    }
    VPath {   // mast
        box-w: root.size; box-h: root.size; vbw: 32; vbh: 32; raw-stroke: 1.2;
        commands: "M14.80 12.58 L14.80 12.10 L14.80 11.62 L14.80 11.14 L14.80 10.67 L14.80 10.19 L14.80 9.72 L14.80 9.25 L14.80 8.78";
        stroke: root.line; stroke-line-cap: round;
    }
    VPath {   // mast tip
        box-w: root.size; box-h: root.size; vbw: 32; vbh: 32;
        commands: "M13.90 8.78 A0.9 0.9 0 1 0 15.70 8.78 A0.9 0.9 0 1 0 13.90 8.78 Z";
        fill: root.line;
    }
    VPath {   // radiating waves
        box-w: root.size; box-h: root.size; vbw: 32; vbh: 32; raw-stroke: 1.1;
        commands: "M13.19 7.07 A 2.6 2.6 0 0 0 13.19 10.50 M12.07 5.88 A 4.4 4.4 0 0 0 12.07 11.69 M16.41 7.07 A 2.6 2.6 0 0 1 16.41 10.50 M17.53 5.88 A 4.4 4.4 0 0 1 17.53 11.69";
        stroke: root.line; stroke-line-cap: round;
    }
    VPath {   // butt-capped handle toward 5 o'clock
        box-w: root.size; box-h: root.size; vbw: 32; vbh: 32; raw-stroke: 3.2;
        commands: "M21.3 25.6 L24.5 31.1";
        stroke: root.line;
    }
}

/// GPS lock (§4.6) — an angled satellite: body tilted ~28 degrees, two side
/// panels, dish, and downward signal arcs. Blue on a fix; the caller dims it to
/// the disabled-tell look when there is none.
export component GpsSatellite {
    in property <length> size: 30px;
    in property <color> color;

    width: root.size;
    height: root.size;

    VPath {
        box-w: root.size; box-h: root.size; vbw: 24; vbh: 24; raw-stroke: 1.5;
        commands: "M0.86 15.54 L7.31 12.12 L9.28 15.83 L2.83 19.25 Z M2.98 14.42 L4.95 18.13 M5.10 13.29 L7.07 17.00 M1.85 17.40 L8.29 13.97 M14.72 8.17 L21.17 4.75 L23.14 8.46 L16.69 11.88 Z M16.84 7.05 L18.81 10.76 M18.96 5.92 L20.93 9.63 M15.71 10.03 L22.15 6.60 M8.29 13.97 L9.44 13.36 M14.56 10.64 L15.71 10.03 M7.70 10.09 L12.82 7.37 L16.30 13.91 L11.18 16.63 Z M13.74 15.27 L15.19 18.00 M13.29 18.90 A 3 3 0 0 0 17.00 16.93 M12.76 21.11 A 6 6 0 0 0 19.12 17.73";
        stroke: root.color;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

/// Vehicle in motion (§4.6) — a car with three trailing lines. Amber, never the
/// blue accent: it is in the fixed safety-colour family, like TA. The slow ~2.6s
/// pulse is applied by the caller.
export component MotionCar {
    in property <length> size: 34px;
    in property <color> color;

    width: root.size;
    height: root.size;

    // The car body is drawn in its own 24-unit space and placed by the SVG's
    // translate(2.6 1) scale(0.82) — expressed here as a smaller, offset box.
    VPath {
        box-w: root.size * 0.82; box-h: root.size * 0.82;
        ox: root.size * 2.6 / 24; oy: root.size * 1 / 24;
        vbw: 24; vbh: 24; raw-stroke: 1.7;
        commands: "M19 17h2a1 1 0 0 0 1-1v-3c0-.9-.7-1.6-1.5-1.9L16 10l-1.9-2.4A2 2 0 0 0 12.5 7H6.2a2 2 0 0 0-1.8 1.1L2.7 11.6A3 3 0 0 0 2 13.5V16a1 1 0 0 0 1 1h1.5 M6 17 A2 2 0 1 0 10 17 A2 2 0 1 0 6 17 Z M15 17 A2 2 0 1 0 19 17 A2 2 0 1 0 15 17 Z M10 17h5";
        stroke: root.color;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    VPath {   // trailing motion lines (outside the group transform)
        box-w: root.size; box-h: root.size; vbw: 24; vbh: 24; raw-stroke: 1.7;
        commands: "M0.5 8.5 L3.6 8.5 M0 12 L2.8 12 M1 15.5 L3.4 15.5";
        stroke: root.color;
        stroke-line-cap: round;
    }
}

/// Magnifier-over-picture — the reorder-mode "find a logo for this station" badge
/// (icons.tsx `LogoSearchIcon`, 24-unit viewbox, stroke 2). Deliberately a
/// different drawing from `MagnifierTower`: a framed picture with a lens at the
/// lower right, not a lens over a transmitter.
///
/// The picture's sun is a filled r=1.15 circle in the SVG. Slint's Path takes ONE
/// fill for the whole command string, so it is drawn the way `WarningTriangle`
/// already draws its dot — a zero-length round-capped segment, which puts down a
/// disc of the stroke width (2 units against the SVG's 2.3).
export component LogoSearchIcon {
    in property <length> size: 26px;
    in property <color> color: #FFFFFF;

    width: root.size;
    height: root.size;

    VPath {
        box-w: root.size; box-h: root.size; vbw: 24; vbh: 24; raw-stroke: 2;
        commands: "M4.5 3.5 H12.5 A2 2 0 0 1 14.5 5.5 V11.5 A2 2 0 0 1 12.5 13.5 H4.5 A2 2 0 0 1 2.5 11.5 V5.5 A2 2 0 0 1 4.5 3.5 Z M6 7 L6.01 7 M3 12 L6.8 8.3 L10 11 M12.3 16 A4.2 4.2 0 1 0 20.7 16 A4.2 4.2 0 1 0 12.3 16 Z M19.6 19.1 L22 21.5";
        stroke: root.color;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// ── LED ZEPPELIN'S FOUR MARKS (Design EASTER-EGGS §2.3) ─────────────────────
//
// From the untitled fourth record, in sleeve order, and they stand IN PLACE OF
// the genre line rather than beside it. Traced outlines lifted verbatim from
// `bandArt.tsx`'s `RUNE_PATHS`, which took them from the handoff's own
// `zeppelin-runes.json` — they are SPECIFIC MARKS, never lettering, and must
// never be redrawn or stood in for by a font glyph.
//
// EACH HAS ITS OWN VIEWBOX and they differ in aspect: the row is laid out by
// HEIGHT and every mark takes its width from its own ratio, which is why these
// are four components rather than one with a parameter.
//
// DEBOSSED, NOT PRINTED (§2.3, LOSSY-ELEMENTS #14). The design's recess is a
// four-layer filter chain — two hard 1px edges for the rim, two soft blooms for
// the wall — and Slint has no filter chain. What it does have is the trick the
// tells and the genre line already use: a second copy offset a pixel, light
// below and dark above. That gives the rim and not the wall, which is the half
// that carries the read; it is an approximation and is called one here.

