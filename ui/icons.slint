// The four in sleeve order, laid out by height with each mark's own width.
// `bandArt.tsx` sizes them at 1.45x the genre line and gaps them at 0.62x.
export component ZeppelinRunes inherits HorizontalLayout {
    in property <length> size;
    in property <color> ink;

    spacing: root.size * 0.62 / 1.45;
    alignment: center;
    RuneZoso { size: root.size; ink: root.ink; }
    RuneTriquetra { size: root.size; ink: root.ink; }
    RuneRings { size: root.size; ink: root.ink; }
    RuneFeather { size: root.size; ink: root.ink; }
}

// ── THE BEATLES' DRUM (bandArt `GEAR_BEATLES`) ──────────────────────────────
//
// A hoop, an inner hoop, the head's band across the middle, and four lugs. It
// replaces the settings gear while that theme is showing.
