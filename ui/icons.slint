        fill: root.ink.with-alpha(0.9);
    }
    VPath {
        box-w: root.size; box-h: root.size; vbw: 24; vbh: 24; raw-stroke: 1.6;
        commands: "M12 2 L12 4.4 M12 19.6 L12 22 M2 12 L4.4 12 M19.6 12 L22 12";
        stroke: root.ink; stroke-line-cap: round;
    }
}

// ── NIRVANA'S SMILEY (bandArt `GEAR_NIRVANA`) ───────────────────────────────
//
// The xerox face: a ring, two crossed-out eyes, a lolling tongue and a grin.
export component SmileyIcon inherits Rectangle {
    in property <length> size: 26px;
    in property <color> ink;

    width: root.size; height: root.size;

    VPath {
        box-w: root.size; box-h: root.size; vbw: 24; vbh: 24; raw-stroke: 1.6;
        commands: "M2 12 A10 10 0 1 0 22 12 A10 10 0 1 0 2 12 Z";
        stroke: root.ink;
    }
    VPath {
        box-w: root.size; box-h: root.size; vbw: 24; vbh: 24; raw-stroke: 1.5;
        commands: "M6.7 7.9 L9.7 10.9 M9.7 7.9 L6.7 10.9 M14.3 7.9 L17.3 10.9 M17.3 7.9 L14.3 10.9";
        stroke: root.ink; stroke-line-cap: round;
    }
    // The tongue: a rounded slab, rotated -16 degrees about its own top corner in
    // the SVG. Slint cannot rotate an element, so the rotation is baked into the
    // four corners as a path.
    VPath {
        box-w: root.size; box-h: root.size; vbw: 24; vbh: 24;
        commands: "M13.32 16.58 L16.01 15.81 L17.22 20.04 L14.53 20.81 Z";
        fill: root.ink;
    }
    VPath {
        box-w: root.size; box-h: root.size; vbw: 24; vbh: 24; raw-stroke: 1.7;
        commands: "M7 14.9 Q12 19.6 17 14.9";
        stroke: root.ink; stroke-line-cap: round;
    }
}

// ── LED ZEPPELIN'S AIRSHIP (bandArt `ZeppelinAirship`) ──────────────────────
//
// It flies in the VEHICLE-IN-MOTION slot rather than replacing the settings
