// Design tokens — the CarFM face, verbatim, EXCEPT WHERE THE DESIGN HAS MOVED ON.
//
// Every value here was copied from CarFM's `src/components/carfm/tokens.ts` and
// the token ramp in `CarFmFace.tsx`, on the rule that the shipped app is the
// reference and the design bundle is not: the bundle in this tree was v1.10.0,
// it predated the app on several values — `amberFill` is 0.12/0.15 there and
// 0.08/0.10 in the app — and the brief was a face identical to the one on the
// head unit.
//
// THE v1.16.1 HANDOFF INVERTS THAT FOR THE DARK RAMP. It postdates the CarFM
// app, which still carries the old blue-navy values, so on these lines the
// bundle is ahead and Carnyx is first: the dark theme is lifted one step and
// de-tinted to neutral charcoal, with a wider page-to-panel gap so cards still
// read as raised at the higher base. The rule is unchanged — the newest
// statement wins — and where the app is still newer, the app still wins.
//
// Sizes are logical pixels, which Slint maps to Android dp, so the spec's dp
// numbers transfer 1:1.

// Atkinson Hyperlegible (400/700) — an accessibility face chosen for
// glance-legibility in a moving car (ANDROID §3). Importing the .ttf here
// registers the family with the runtime; `font-weight: 700` picks the bold cut.
import "fonts/AtkinsonHyperlegible-Regular.ttf";
import "fonts/AtkinsonHyperlegible-Bold.ttf";

// ── THE BAND THEMES' DISPLAY FACES (Design EASTER-EGGS §12) ──
//
// The REAL supplied typefaces, not system stand-ins — §12 is explicit that a
// stand-in is a failed build. Each is imported here so its family name resolves;
// none is ever asked for except while its own theme is showing, and the rest of
// the face never sees any of them.
//
// THE FAMILY NAMES ARE THE FONTS' OWN, READ OUT OF THEIR `name` TABLES, and
// that is not a detail. CarFM registers these under the keys it passes to RN's
// `useFonts` — `BeatlesYellowSub`, `Gridnik`, `PermanentMarker` — which are file
// labels and not family names. Slint resolves `font-family` against the family
// the file DECLARES, so copying CarFM's keys would have missed every one of them
// and fallen back to Atkinson without a word. Checked file by file:
//
//   BeatlesYellowSub.ttf  -> "YellowSubmarine"
//   Gridnik.otf           -> "FoundryGridnik"
//   PermanentMarker.ttf   -> "Permanent Marker"
//   MadieRoger.ttf        -> "Madie Roger"
//   Kashmir.ttf / Onyx.ttf / Singothic.ttf / Squealer.otf -> their own names
//
// THE STRINGS THEMSELVES LIVE IN ONE PLACE, AND IT IS NOT THIS FILE. `Font`
// below used to carry a third copy of that table as nine `egg-*` properties
// that nothing ever read: the themes are built in `src/eggs.rs`, which owns the
// `FACE_*` consts and `BUNDLED_FACES`, and every face reaches the .slint files
// as a string field on `EggTheme`. A copy of a name table that nothing reads is
// a copy nobody notices going wrong — which is the failure this whole note is
// about — so the nine are gone. What is
// load-bearing HERE is the `import` lines — they are what registers the
// families with the runtime, and src/eggs.rs's
// `every_face_a_theme_names_is_bundled_and_imported` reads this file back to
// check that every bundled file is imported. Never drop one.
//
// SGTPEPPERS IS NOT BUNDLED. The registry names it for the Beatles hero, and the
// reference then refuses to apply it — `eggHeroFont` is gated on
// `motif !== 'submarine'` — because §4 records that cut as outline-only and
// unfinished. A 177 KB file that nothing can ask for is not a port.
//
// CFF OUTLINES in two of them: Squealer and Gridnik are `OTTO`-flavoured where
// the rest are `glyf`. Worth knowing if either renders as blank boxes — the
// cause would be the outline format, not a missing file.
// §4.8's clock. THE ONE NON-ATKINSON FACE OUTSIDE THE BAND THEMES, and the only
// one here that is not a display cut for an Easter egg: a true seven-segment
// face, so the time reads as head-unit hardware. Keshikan, SIL OFL 1.1.
// Family "DSEG7 Classic Mini" — with spaces, not the filename.
import "fonts/DSEG7ClassicMini-Regular.ttf";
import "fonts/Squealer.otf";
import "fonts/BeatlesYellowSub.ttf";
import "fonts/MadieRoger.ttf";
import "fonts/Kashmir.ttf";
import "fonts/PermanentMarker.ttf";
import "fonts/Onyx.ttf";
import "fonts/Gridnik.otf";
import "fonts/Singothic.ttf";
// THE FIRST FACE A BASIC THEME BRINGS, and the first for a SONG rather than a
// band — "Carry On Wayward Son". Its family is "Supernatural Knight" WITH THE
// SPACE, read out of the file's own `name` table; the file arrived as
// `Supernatural_Knight.ttf` and the underscore is not in the family at all,
// which is the exact mistake the paragraph above records CarFM making five
// times over.
//
// SINGLE WEIGHT. `usWeightClass` is 400 and the subfamily is "Regular", so the
// 700 a basic theme's genre line asks for resolves to this one cut — see
// `GenreText`. It is a heavy display face to begin with, which is why that is
// tolerable rather than a failed build.
//
// NO ACCENTED LATIN. 171 cmap entries: ASCII, typographic punctuation and a
// scattering of symbols, but no á ç è é í ñ ó ú ü and no €. This face reaches
// the RadioText as well as the genre line, and RadioText is whatever the
// broadcaster sends — so a Spanish title renders its accents in the fallback
// face. Mixed type on one line, not tofu, and not worth refusing the font over.
import "fonts/SupernaturalKnight.ttf";

// THE ORDINARY FACE AND THE TWO WEIGHTS IT IS ASKED FOR — nothing else. A
// display cut never comes from here: it arrives on `EggTheme` from
// `src/eggs.rs`, which is the one table of family names (see the note above the
// imports). 400 is the default weight and is never named, so there is no
// `regular` here to go stale beside `bold`.
export global Font {
    out property <string> face: "Atkinson Hyperlegible";
    out property <int> bold: 700;
    /// A band theme's genre line asks for ExtraBold. No 800 cut is bundled, so
    /// the engine resolves it to the 700 above; see `GenreText`.
    out property <int> heavy: 800;
}

// The palette. `dark` selects the theme; `off` is §4.7 — audio priority released,
// where the whole face desaturates. React Native gets that from a `grayscale(1)`
// filter, which Slint has no equivalent for, so it is done here instead: every
// token passes through `flat()`, which collapses a colour to the same Rec.709
// luma the CSS/RN filter uses.
export global Pal {
    in property <bool> dark: false;
    in property <bool> off: false;

    // Rec.709, and the 0.5 is not decoration. These are the exact coefficients
    // React Native puts in its Android ColorMatrix for `filter: grayscale(1)`
    // (ReactAndroid FilterHelper.createGrayscaleColorMatrix), which is the CSS
    // Filter Effects matrix. Rec.601 (0.299/0.587/0.114) is the wrong one and is
    // off by up to 14/255 on a saturated station colour. Colors.rgb TRUNCATES its
    // arguments rather than rounding, hence the half.
    pure public function flat(c: color) -> color {
        return Pal.off
            ? Colors.rgb(c.red * 0.2126 + c.green * 0.7152 + c.blue * 0.0722 + 0.5,
                         c.red * 0.2126 + c.green * 0.7152 + c.blue * 0.0722 + 0.5,
                         c.red * 0.2126 + c.green * 0.7152 + c.blue * 0.0722 + 0.5)
            : c;
    }
    // Alpha-carrying tokens: `flat` would drop the alpha (Colors.rgb is opaque),
    // so they desaturate through the same luma then take their alpha back.
    pure public function flat-a(c: color, a: float) -> color {
        return Pal.flat(c).with-alpha(a);
    }

    // ── WHAT A BAND THEME RESTATES ON THE PALETTE ITSELF ──
    //
    // TWO TOKENS, AND ONLY TWO. The reference folds a theme's accent pair into
    // the palette — `pal = { ...basePal, blue, blueFill }` (CarFmFace.tsx:572) —
    // and threads the page background down as its own prop; every other themed
    // colour it has reaches exactly one element. So the ground and the accent
    // live here, because they are the two that a dozen components read: the
    // pill, the preset selection, the nav chevrons, the tells and the scroll
    // thumb all take `Pal.blue`, and overriding it once is what turns them
    // together rather than one by one. The hero card's and the RadioText plate's
    // own colours travel in `EggTheme` and are applied where they are drawn — so
    // the settings panel, the numpad and the nearby list keep the ordinary dark
    // palette, exactly as they do in the reference.
    //
    // SET BY RUST, from `eggs.rs`, PER COLOUR SCHEME — "Back in Black" is AC/DC's
    // dark cut, and its light cut restates neither of these. ALPHA ZERO MEANS
    // UNTHEMED, so nothing here can move a face with no theme showing.
    in-out property <color> egg-page-bg: transparent;
    in-out property <color> egg-accent: transparent;

    // ── THE DARK RAMP (ANDROID §3, v1.16.0) ──
    //
    // LIFTED AND DE-TINTED. The blue-navy ramp — #161E29 / #212B38 / #2A3644 —
    // is replaced by a neutral charcoal one, one step lighter overall and with a
    // WIDER page-to-panel step (15 points, against 11) so a card still reads as
    // raised at the higher base value.
    //
    // WHAT DID NOT MOVE IS THE POINT OF THE CHANGE: text, amber, blue and every
    // border / fill / meter alpha are untouched, and the alphas simply ride the
    // new base values. So the contrast decisions the design already made hold,
    // and only the ground under them changed.
    out property <color> bg:          Pal.flat(Pal.dark ? #24272C : #EEF1F5);
    // THE PAGE'S OWN GROUND, which is `bg` UNLESS a theme repaints it — and the
    // two are separate because the reference keeps them separate. `pageBg` is
    // threaded to the stage and the face (CarFmFace.tsx:1284, :1289) and to the
    // signal digits' ring (`egg?.pageBg || pal.bg`, :1186); the three overlay
    // cards ask for plain `pal.bg` (SettingsPanel:319, NearbyPicker:180,
    // LogoSearchOverlay:150) and so keep the ordinary ground on a black page.
    // One token for both would have quietly repainted those three as well.
    out property <color> page:        Pal.egg-page-bg.alpha > 0 ? Pal.egg-page-bg : Pal.bg;
    out property <color> panel:       Pal.flat(Pal.dark ? #33373D : #FFFFFF);
    out property <color> raised:      Pal.flat(Pal.dark ? #43474E : #F5F7FA);
    out property <color> text:        Pal.flat(Pal.dark ? #E9EEF4 : #1B222C);
    out property <color> dim:         Pal.flat(Pal.dark ? #A3A9B2 : #67717F);
    // Frequency amber is a FIXED safety colour (ANDROID §3) — never themed, never
    // part of the accent system. It differs by theme only for contrast.
    out property <color> amber:       Pal.flat(Pal.dark ? #FFB833 : #C9760A);
    // THE SILVER. `uiAccent: '#C9C9C9'` — every blue graphic on the face reads
    // this one token, so this line is what turns all of them at once.
    out property <color> blue:        Pal.egg-accent.alpha > 0 ? Pal.egg-accent : Pal.flat(Pal.dark ? #4A9EFF : #2E86FF);
    out property <color> border:      Pal.flat-a(Pal.dark ? #FFFFFF : #141E2D, 0.13);
    // `uiAccentFill: 'rgba(201,201,201,0.15)'` — the theme states its own alpha,
    // which is why the themed arm does not reuse the 0.18/0.12 beside it.
    out property <color> blue-fill:   Pal.egg-accent.alpha > 0
        ? Pal.egg-accent.with-alpha(0.15)
        : Pal.flat-a(Pal.dark ? #4A9EFF : #2E86FF, Pal.dark ? 0.18 : 0.12);
    out property <color> amber-fill:  Pal.flat-a(Pal.dark ? #FFB833 : #C9760A, Pal.dark ? 0.10 : 0.08);
    out property <color> backdrop:    Pal.flat(Pal.dark ? #0C1218 : #DCE0E6);
    out property <color> meter-empty: Pal.flat-a(Pal.dark ? #FFFFFF : #141E2D, 0.10);
    out property <color> scroll-thumb: Pal.flat-a(#808690, 0.6);
    // ── The nearby magnifier: strokes, disc, lens, rim ──
    //
    // THE SHIPPED VALUES, WHICH ARE NOT THE ONES THE PROSE GIVES. ANDROID §11
    // says "light strokes on a raised disc, lens <the same>" and has said so
    // since v1.10; the live source it tells you to render from has always
    // disagreed, giving the disc `panel` and the LENS `raised` so the glass sits
    // a step off the metal it is set in. `CarFmLive` passes empty strings for all
    // four dark values, so what ships is `RadioFace`'s own defaults, and those
    // are the values below.
    //
    // The disc was taking the prose's word for it and was one step too light.
    // Corrected here rather than left, because the handoff that moved the ramp is
    // the same document that made the two readings distinguishable.
    out property <color> nearby-line:  Pal.flat(Pal.dark ? #E9EEF4 : #111111);
    out property <color> nearby-disc:  Pal.flat(Pal.dark ? #33373D : #FFFFFF);
    out property <color> nearby-glass: Pal.flat(Pal.dark ? #43474E : #DCE7F5);
    // The rim is its OWN colour, not the general border alpha. `Pal.border` was
    // standing in for it and lands within a couple of points on the new dark
    // ramp — but it is a stated value, and a stand-in that happens to agree is
    // still a stand-in.
    out property <color> nearby-rim:   Pal.flat(Pal.dark ? #565B63 : #D5DAE1);

    // §4.7 veils: a light grey one over the hero card, a darker one over the rest.
    out property <color> hero-veil:   Pal.dark ? #0000006B : #48526042;
    out property <color> screen-veil: Pal.dark ? #00000080 : #18202E57;
    // ── The two plates a logo can be set on ──
    //
    // NEITHER IS THEMED and neither passes through `flat()`, because both exist
    // to be a KNOWN ground rather than a surface: `logo-fallback` is the white
    // paper an un-adapted logo was drawn for, and `logo-plate` is the slab the
    // `plate` treatment keys its mark out onto — `stages::plate_params().fill`,
    // `[0.90, 0.90, 0.90]`, at 8 bits. Both are already neutral, so `flat()`
    // would return them unchanged on a dead face anyway. A BAND THEME MUST NOT
    // REACH THEM EITHER: "Back in Black" turns the accent silver and the card
    // near-black, and a logo's paper is not part of that — it is the ground the
    // artwork was drawn against.
    out property <color> logo-fallback: #FFFFFF;
    out property <color> logo-plate: #E6E6E6;
    // The power button is the ONE element that keeps its colour when the face is
    // dead, so it is deliberately outside `flat()`.
    out property <color> power-on: #FFAE1A;
}

// Layout tracks and the token ramp (ANDROID §0/§2, CarFmFace's `L` memo).
//
// The face measures its own container and re-derives the spec's dp for the space
// actually available. This is NOT scale-to-fit: the layout below reflows per
// track, and only the token VALUES ramp.
export global Metrics {
    in property <length> avail-w: 1024px;
    in property <length> avail-h: 614px;

    // THE HERO CARD'S TOP EDGE, in the face's coordinates — written back by
    // `HeroRow`, the same way the face writes `avail-w` above, and for the same
    // structural reason: the reader cannot reach the source directly. §4.8
    // anchors the clock "midway between the bottom edge of the right cluster
    // and the top line of the hero card", and §4.9 clamps the countdown to the
    // same line — the CARD's top, not the slot's. The card hangs centred inside
    // a slot that starts higher (~7px on the wide track, ~70 on the tall one),
    // and the rows that hold it live inside the face's per-track `if` arms,
    // where their ids are unreachable from outside. So the row that owns the
    // card reports the edge here. Zero until the first layout pass, which the
    // face's `> top` guards already treat as "not measured yet".
    in-out property <length> hero-card-top: 0px;

    out property <float> w: Metrics.avail-w / 1px;
    out property <float> h: Metrics.avail-h / 1px;

    // Width-class breakpoint 600dp, per WindowSizeClass Compact.
    out property <bool> tall: Metrics.w < 600;
    // 500, not 480: the landscape reference surface is 1080x486, so h<480 could
    // never fire on the very surface the branch is sized for.
    out property <bool> landscape: !Metrics.tall && Metrics.h < 500;
    out property <bool> two-rows: !Metrics.tall && !Metrics.landscape && (Metrics.w / Metrics.h) < 1.4;

    out property <float> k: Metrics.tall
        ? Math.min(1, Math.max(0.68, Metrics.w / 486))
        : Math.min(1, Math.max(0.68, Metrics.landscape
            ? Math.min(Metrics.w / 1080, Metrics.h / 486)
            : Metrics.two-rows
                ? Math.min(Metrics.w / 900, Metrics.h / 810)
                : Math.min(Metrics.w / 1024, Metrics.h / 614)));

    pure public function s(v: float) -> length { return Math.round(v * Metrics.k) * 1px; }
    pure public function sf(v: float) -> float { return Math.round(v * Metrics.k); }

    out property <length> pad-h: Metrics.s(Metrics.tall ? 16 : 24);
    out property <length> pad-v: Metrics.s(Metrics.tall ? 14 : 18);
    out property <length> gap: Metrics.s(Metrics.tall ? 10 : 12);

    out property <length> freq-size: Metrics.s(Metrics.tall ? 64 : Metrics.landscape ? 56 : 78);
    out property <length> call-size: Metrics.s(Metrics.tall ? 62 : Metrics.landscape ? 60 : 94);
    out property <length> star: Metrics.s(Metrics.tall ? 58 : Metrics.landscape ? 48 : 56);

    // The strip is 64 tall on every track; the ZONE around it is what varies.
    //
    // THE ZONE IS FLOORED AT THE STRIP. The zone's whole job is to RESERVE the
    // strip's space in the column, and three of the four per-track figures below
    // are SMALLER than the strip itself — 60 tall, 50 landscape and 56 two-rows
    // against a 64 strip. With the strip centred in it (face.slint:674 and :768)
    // that put the strip at y = -2, -7 and -4, hanging out of both ends of its
    // own zone and eating the gaps above and below; landscape lost 7dp each way.
    // Only the wide track's 76 ever had room to spare. The Math.max keeps the
    // per-track figures meaningful wherever they are the larger of the two and
    // stops the reservation from being smaller than what it reserves for.
    out property <length> rt-height: Metrics.s(64);
    out property <length> rt-zone-h: Math.max(Metrics.rt-height,
        Metrics.s(Metrics.tall ? 60 : Metrics.landscape ? 50 : Metrics.two-rows ? 56 : 76));
    out property <length> rt-font: Metrics.s(Metrics.landscape ? 26 : 30);

    // SIGNAL-METER.md's rendered sizes. The glyph swallowed the level number that
    // used to sit beside it, so the wide cluster is narrower than it was.
    out property <length> signal-icon: Metrics.s(Metrics.tall ? 74.75 : 54.6);
    out property <length> signal-num: Math.max(12px, Metrics.s(Metrics.tall ? 19 : 15));
    out property <length> signal-num-top: Metrics.s(Metrics.tall ? 32.1 : 23);

    out property <length> stereo-font: Math.max(12px, Metrics.s(Metrics.tall ? 18 : 15));
    out property <length> stereo-wave-w: Metrics.s(Metrics.tall ? 28 : 20);
    out property <length> stereo-wave-h: Metrics.s(Metrics.tall ? 40 : 28);
    // Heights are minimums so a large system font scale grows the pill, not clips it.
    out property <length> stereo-h: Metrics.s(Metrics.tall ? 46 : 36);
    out property <length> stereo-pad-h: Metrics.s(Metrics.tall ? 18 : 14);
    out property <length> stereo-radius: Metrics.tall ? 12px : 10px;
    out property <length> stereo-min-w: Metrics.s(Metrics.tall ? 196 : 158);

    // Small status type floors at legibility, not proportion (ANDROID §10).
    //
    // ── THE GENRE LINE, ~175% OF WHAT IT WAS (ANDROID §4.1, v1.16.0) ──
    //
    // 15 → 26 wide and 19 → 33 tall. §4.1 states the PTY size for the first time
    // in this revision; before it, the number lived only in the prototype.
    //
    // A BAND THEME'S GENRE IS BIGGER AGAIN, and by a different step per track:
    // 33 inline, 47 centred (`RadioFace`'s `ptyStyle` / `ptyCenteredStyle`,
    // `fontSize: eggGenre ? … : (tall ? 33 : 26)`). Which of the two applies is
    // decided by the TRACK and not by the theme, so it belongs here beside the
    // plain sizes rather than in `EggTheme`.
    //
    // A THIRD SIZE EXISTS AND IS UNREACHABLE: a theme that names its own
    // `genreFont` takes 38 inline / 53 centred at weight 400 instead of 800.
    // `eggGenreFont` reads `egg.genreFont` ALONE — it does not fall back to the
    // theme's general `font`, which is why AC/DC's gold line is Atkinson and not
    // Squealer in `screenshots/egg-acdc-dark.png`. AC/DC is the only theme this
    // app carries and it names no `genreFont`, so the branch would be dead code;
    // the numbers are written down here instead, and it becomes a table row the
    // day a theme states one.
    out property <length> pty-font: Math.max(12px, Metrics.s(Metrics.tall ? 33 : 26));
    out property <length> pty-egg-font: Math.max(12px, Metrics.s(Metrics.tall ? 47 : 33));
    /// HOW FAR THE GENRE LINE MAY SHRINK, and it is exactly the size this line
    /// was BEFORE v1.16.0 grew it — this token's own previous body. A size that
    /// has been legible in this car for the whole project is a floor that needs
    /// no separate justification, and it keeps ANDROID §10's 12dp legibility
    /// floor underneath it. See `GenreText`.
    out property <length> pty-font-min: Math.max(12px, Metrics.s(Metrics.tall ? 19 : 15));

    /// The genre line's width budget on the wide track.
    ///
    /// 240, NOT THE DESIGN'S 200. §4.1 grew the type 175% and left this number
    /// alone, and at 26sp the widest label the RBDS table can emit stopped
    /// fitting. Measured through Slint's own layout at k = 1, widest first:
    /// `Foreign Language` 227, `Religious Music` 203, `Emergency Test` 202, and
    /// then 26 others at 185 or less. 200 clipped the top three of twenty-nine.
    ///
    /// 240 clears the widest by 13dp, which is the margin a system font scale or
    /// a metrics change has to eat before anything elides again. RAISED RATHER
    /// THAN REMOVED: the cap is what stops a genre line growing into the right
    /// cluster, and that job has not changed.
    out property <length> genre-cap: 240px;
    out property <length> tell-font: Math.max(10px, Metrics.s(Metrics.tall ? 14 : 11));

    out property <length> band-height: Metrics.s(Metrics.two-rows ? 250 : Metrics.landscape ? 104 : 140);

    // Wide/two-row/landscape hero is a card of clamped width: clamp(470, 62%, 720).
    out property <length> hero-card-w: Math.max(Metrics.s(470), Math.min(Metrics.s(720), Math.round(Metrics.w * 0.62) * 1px));
    // Tall/portrait: a narrower card (82%) flanked by smaller peek cards.
    out property <length> tall-hero-w: Math.min(Metrics.s(560), Math.round(Metrics.w * 0.82) * 1px);
    // LOGO-SIZING §4: peek card = 20% of surface width, capped at 206, every track.
    out property <length> peek-w: Math.min(Metrics.s(206), Math.round(Metrics.w * 0.2) * 1px);
    // The peek tucks UNDER the hero card by this much.
    out property <length> peek-overlap: Metrics.s(Metrics.tall ? 46 : 72);
}
