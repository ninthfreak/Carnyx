import { Pal, Metrics } from "tokens.slint";
import { Preset, HeroSnapshot, Overlay, EggTheme, LogoPlate, NavStage } from "types.slint";
import { Face } from "face.slint";
import { NearbyOverlay, NearbyState, NearbyStation, GenreColumn, NearbyTab } from "nearby.slint";
import {
    SettingsOverlay, TunerSource, TunerDetail, TunerGlyph, TunerAction, BatteryState,
    DiagAction
} from "settings.slint";
import { LogoSearchOverlay, LogoSearchState, LogoCandidate, DarkChoice } from "logo-search.slint";

export { Pal, Metrics, Preset, Overlay }
export { NearbyState, NearbyStation, GenreColumn }
export { TunerSource, TunerDetail, TunerGlyph, TunerAction, BatteryState, DiagAction }
export { LogoSearchState, LogoCandidate, DarkChoice }

export component AppWindow inherits Window {
    in property <string> ident;
    in property <string> freq-label: "—";
    /// The tuned station's stored logo, and whether there is one.
    ///
    /// A logo REPLACES the big call sign on the hero, so `has-logo` is not a
    /// decoration flag — it changes what the card is. It is false whenever the
    /// station has no master, whenever the driver has logos switched off, and
    /// whenever that station's own hero flags say to show the call sign anyway.
    in property <image> logo;
    in property <bool> has-logo: false;
    /// What goes behind that logo — the light face's paper, the dark face's
    /// white fallback while an adaptation is pending, nothing at all for an
    /// adapted variant that reads on its own, or the grey slab the `plate`
    /// treatment is keyed for. Decided in Rust; see `LogoPlate`.
    in property <LogoPlate> logo-plate: LogoPlate.light;
    /// The station's hero flags (`logos::prefs::HeroFlags`). Meaningful only
    /// with a logo up: a no-logo hero always shows both rows.
    in property <bool> show-call: true;
    in property <bool> show-freq: true;
    in property <bool> saved: false;
    in property <bool> in-band: true;
    in property <string> radio-text;
    in property <int> full-pairs: 0;
    in property <bool> half: false;
    in property <float> dot-opacity: 1.0;
    in property <int> dotted-arcs: 0;
    in property <string> level-text: "—";
    in property <bool> stereo-known: false;
    in property <bool> stereo: false;
    in property <bool> rds: false;
    in property <bool> tp: false;
    in property <bool> ta: false;
    in property <bool> af: false;
    in property <string> pty;
    /// The band theme, and the call sign pre-split for its bolt.
    in property <EggTheme> egg;
    in property <string> ident-a;
    in property <string> ident-b;
    in property <bool> tuner-error: false;
    // ── §? TURN-BY-TURN, from OsmAnd. See src/nav.rs. ───────────────────────
    //
    // FINISHED VALUES AND NO LAYOUT. The design handoff for the strip is still
    // in progress, so what crosses is the DATA — is there a route, which way,
    // how far, and the spoken words — already formatted by Rust. Whatever the
    // handoff turns out to look like binds to these; guessing at the drawing now
    // would be building something to throw away.
    //
    // `nav-active` true with both strings empty is OsmAnd's own "navigating,
    // nothing to say", which is a real state and not a blank.
    in property <bool> nav-active: false;
    /// "right", "slight left", "roundabout", "off route", or empty when there
    /// is no turn to name. Named in Rust; see `nav::Turn::name`.
    in property <string> nav-turn;
    /// "240 m" / "1.4 km", already formatted.
    in property <string> nav-distance;
    /// What the voice router last said — the only place a STREET NAME comes
    /// from, since the structured half carries no text at all.
    in property <string> nav-instruction;
    /// The next turn's street, already formatted by OsmAnd with its ref and
    /// destination. EMPTY MEANS COLLAPSE THE ELEMENT — the handoff's rule for
    /// every poll field — never a placeholder.
    in property <string> nav-street;
    /// The turn after the next one, for the handoff's `THEN` block.
    in property <string> nav-after-street;
    /// The next turn as OsmAnd's TurnType XML STRING — "TR", "TSLL", "C",
    /// "RNDB". The arrow generator reads this, NOT `nav-turn`: the push callback
    /// and the poll encode the same turn two different ways and crossing them is
    /// the obvious mistake.
    in property <string> nav-turn-xml;
    in property <string> nav-after-turn-xml;
    /// OsmAnd's own map is in front. The handoff hides the whole layer here,
    /// driver-overridable — so this is published and not obeyed in Rust.
    in property <bool> nav-map-visible: false;
    /// WHICH OF §4.9'S THREE STAGES the maneuver layer is in. `idle` covers both
    /// "no route" and "suppressed", which is all a layer that draws nothing
    /// needs to know. Decided in `App::push_nav` from OsmAnd's own
    /// `next_turn_imminent`.
    in property <NavStage> nav-stage: NavStage.idle;
    /// How far along this leg the driver is, 0 to 1 — the stage-1 hairline's
    /// width. The denominator is this build's own; see `crate::nav::Nav::progress`.
    in property <float> nav-progress: 0.0;
    /// The maneuver arrow as SVG path data on a 24-unit box, straight from
    /// `crate::arrow`. EMPTY DRAWS NOTHING, which is what an unrecognised turn
    /// type gets — an arrow is an instruction and a wrong one is worse than none.
    in property <string> nav-arrow;
    in property <string> nav-after-arrow;
    /// A roundabout's exit number, set inside the ring. Empty when OsmAnd did
    /// not name one.
    in property <string> nav-exit;
    in property <string> nav-after-exit;
    /// The arrival time, already local and already formatted — `4:35 PM`,
    /// `16:35`. In the UI face, not DSEG7 (§4.9), so it carries no segment-font
    /// blank. Empty when there is no route or no clock to read.
    in property <string> nav-eta;
    /// Distance to the DESTINATION, not to the turn. Joins the ETA on the tall
    /// track, where §4.9 says there is room.
    in property <string> nav-left-distance;
    /// MAY THE MANEUVER LAYER DRAW? (§4.9) — `nav-active` and not suppressed by
    /// OsmAnd's own map being in front. This is the ONE gate the layer binds to;
    /// `nav-active` stays raw so the settings sub-line can still say WHY nothing
    /// is showing. Decided in `App::push_nav`.
    in property <bool> nav-showing: false;
    /// The AIDL service is bound AND answering — the OsmAnd tell's lit state
    /// (§4.9). Derived from the poll's freshness rather than from `bindService`
    /// having returned true; see `App::push_nav`.
    in property <bool> nav-linked: false;

    /// §4.8's clock, already formatted by Rust. EMPTY DRAWS NOTHING.
    in property <string> clock-time;
    in property <string> clock-meridiem;

    in property <bool> gps-fix: false;
    in property <bool> in-motion: false;
    in property <[Preset]> presets;
    in property <int> active-index: -1;
    in property <Preset> prev-preset;
    in property <Preset> next-preset;
    /// The station the discarded peek held before a step — the ghost that
    /// fades out during the hero morph. See `step_morph` in src/app.rs.
    in property <Preset> ghost-preset;
    /// The hero as it stood before the step — the card that flies OUT during the
    /// morph. Captured alongside `ghost-preset`; see `step_morph` in src/app.rs.
    in property <HeroSnapshot> outgoing;
    in property <bool> hand-off: true;
    in property <bool> has-prev: false;
    in property <bool> has-next: false;
    in property <bool> audio-active: true;
    in property <bool> scanning: false;
    in property <bool> reordering: false;
    /// The preset-step morph (§8). Rust bumps the nonce on every step and sets
    /// the direction; a nonce rather than a flag, so two steps in a row both
    /// animate. See `HeroRow` for what it drives and what it does not.
    in property <int> step-nonce: 0;
    in property <int> step-dir: 0;

    callback toggle-save();
    callback open-settings();
    callback open-nearby();
    /// A tap on the OsmAnd status-bar mark — bring OsmAnd to the front. No
    /// overlay to set: this leaves Carnyx and does not open anything of ours.
    callback open-osmand();
    /// The per-tile logo badge, reorder mode only (§6.4 block 0). Carries the
    /// preset index so Rust can resolve the call sign before the window opens.
    callback open-logo-search(int);
    callback claim-audio();
    callback release-audio();
    callback select-preset(int);
    callback step-preset(int);
    callback done-reordering();
    /// Long-press on a preset tile — the only door to reorder mode, and so the
    /// only door to the logo badge that opens §6.4.
    callback enter-reordering();
    /// A drag in reorder mode let go: move the preset at the first index to the
    /// second. Rust owns the list; the band only reports where it landed.
    callback reorder-preset(int, int);
    /// One diagnostics line about the reorder gesture, which cannot be watched
    /// any other way on a head unit. See `PresetsBand::drag-note`.
    callback drag-note(string);
    /// One diagnostics line about the hero's step morph. See `HeroRow`.
    callback morph-note(string);
    /// One tick per morph frame — see HeroRow's `morph-frame`.
    callback morph-frame();

    /// One second, forever, for anything that has to notice the passage of time
    /// rather than an event.
    ///
    /// THE APP HAD NO CLOCK AT ALL, and losing a station is not an event: drive
    /// out of range without touching the dial and the groups simply stop. Every
    /// merge is "keep what we had", so the plate went on scrolling the last song
    /// over hiss for the rest of the drive.
    ///
    /// One second is far finer than the 25s expiry it drives, and a tick that
    /// finds nothing to do costs a comparison — which is the right trade for the
    /// only heartbeat in the process.
    callback tick();
    Timer {
        interval: 1s;
        triggered => { root.tick(); }
    }

    // ── Overlays (ANDROID §6) ───────────────────────────────────────────────
    //
    // ONE property, not four booleans — the four modals are mutually exclusive
    // and four flags can contradict each other. It is `in-out` because both
    // sides write it: a tap on the face opens the overlay here, and Rust closes
    // it (or opens one itself) after it has prepared the data.
    //
    // Everything an overlay draws is still a finished value from Rust; the
    // property below is navigation state, the same class of thing as the
    // picker's own `hold-index`, not a formatted string or a hashed colour.
    in-out property <Overlay> overlay: Overlay.none;
    /// The dismissal of the overlays WITHOUT a split to make — settings, logo
    /// search, and the nearby row-tap's close. Rust resets whatever that overlay
    /// was holding; the `overlay` property is already back to `none` by the time
    /// this fires. The tune overlay's ✕ and scrim do NOT come through here: §5
    /// gives them two meanings, so they go to `nearby-dismiss` and Rust decides.
    callback close-overlay();
    /// The tune overlay's ✕ or scrim, either tab. Rust branches: "just closes"
    /// on the station list, abandon-entry-and-restore on the keypad (§5).
    callback nearby-dismiss();

    // §6.2's frequency tab — the old §6.1 numpad, folded in by the mini-handoff.
    // `can-tune` is gone with the card: §5 makes TUNE always live and always a
    // dismissal, tuning only when the buffer is good.
    in property <NearbyTab> nearby-tab: NearbyTab.nearby;
    in property <string> freq-display;
    in property <bool> freq-display-dim: true;
    in property <bool> freq-error: false;
    in property <string> freq-error-text;
    callback set-nearby-tab(NearbyTab);
    callback freq-key(string);
    callback freq-back();
    callback freq-seek(int);
    callback freq-commit();
    callback freq-cancel();

    // §6.2 nearby picker.
    in property <[NearbyStation]> nearby-stations;
    in property <NearbyState> nearby-state: NearbyState.list;
    in property <string> nearby-snapshot;
    in property <[string]> nearby-bucket-chips;
    in property <string> nearby-bucket;
    in property <[GenreColumn]> nearby-genre-columns;
    in property <string> nearby-genre;
    in property <bool> nearby-show-bucket-bar: false;
    in property <bool> nearby-show-genre-bar: false;
    callback nearby-tune(int);
    callback nearby-save-preset(int);
    callback nearby-pick-bucket(string);
    callback nearby-pick-genre(string);
    callback nearby-reset-bucket();

    // §6.3 settings.
    in property <string> settings-status-title;
    in property <string> settings-status-sub;
    in property <TunerGlyph> settings-status-glyph: TunerGlyph.waves;
    in property <TunerAction> settings-status-action: TunerAction.none;
    in property <string> settings-details-label;
    in property <bool> settings-details-open: false;
    in property <[TunerDetail]> settings-tuner-details;
    in property <[TunerSource]> settings-sources;
    in property <bool> settings-release-on-sleep: true;
    in property <bool> settings-clock-on: true;
    /// What the Clock row says underneath — it REPORTS the 12/24 format that
    /// Android is in, it does not offer it. See `crate::clock::sub_line`.
    in property <string> settings-clock-sub;
    in property <bool> settings-nav-on: true;
    /// Settings ▸ NAVIGATION ▸ Hide when the map is showing (§4.9). Default on.
    in property <bool> settings-nav-hide-on-map: true;
    /// That row's own sub-line. See `crate::nav::hide_sub_line`.
    in property <string> settings-nav-hide-sub;
    /// Which OsmAnd the switch found, or empty. Drawn in the row's sub-line so a
    /// driver can see whether it has anything to talk to WITHOUT turning it on.
    in property <string> settings-nav-sub;
    in property <[string]> settings-theme-chips;
    in property <string> settings-theme;
    in property <BatteryState> settings-battery: BatteryState.checking;
    in property <string> settings-battery-sub;
    in property <bool> settings-logos-on: false;
    in property <string> settings-logos-sub;
    in property <string> settings-clear-logos-label;
    in property <bool> settings-clearing-logos: false;
    // DIAGNOSTICS. The section the design bundle does not document and the
    // shipping SettingsPanel.tsx does; four switches, a log ring and a list of
    // action rows whose membership and dividers Rust decides.
    in property <bool> settings-diag-on: false;
    in property <[string]> settings-diag-lines;
    in property <[DiagAction]> settings-diag-actions;
    in property <string> settings-about;
    /// The last probe's outcome, in a line the driver can actually read. Empty
    /// until one is tapped.
    in property <string> settings-diag-status;
    /// The hidden band-theme picker's rows and its lit one. See `settings.slint`.
    in property <[string]> settings-egg-menu;
    in property <int> settings-egg-choice;
    callback settings-force-egg(int);
    /// How many times the about line has been tapped; six reveals BAND THEMES.
    ///
    /// Surfaced here so `examples/shot.rs` can render the section — it is the
    /// only way that group's layout is ever checked. Nothing in the app writes
    /// it; the taps do, inside the panel.
    in-out property <int> settings-egg-taps;
    callback settings-retry-tuner();
    callback settings-toggle-details();
    callback settings-pick-source(int);
    callback settings-set-release-on-sleep(bool);
    callback settings-set-clock-on(bool);
    callback settings-set-nav-on(bool);
    callback settings-set-nav-hide-on-map(bool);
    callback settings-set-theme(string);
    callback settings-fix-battery();
    callback settings-set-logos(bool);
    callback settings-clear-logos();
    callback settings-set-diag(bool);
    callback settings-pick-diag-action(int);

    // §6.4 logo search.
    in property <string> logo-search-name;
    in property <string> logo-search-subtitle;
    in property <image> logo-search-logo;
    in property <bool> logo-search-has-logo: false;
    in property <string> logo-search-mono;
    in property <color> logo-search-brand;
    in property <LogoSearchState> logo-search-state: LogoSearchState.landing;
    in property <string> logo-search-query;
    in property <[LogoCandidate]> logo-search-candidates;
    in property <int> logo-search-selected-index: -1;
    in property <bool> logo-search-saving: false;
    in property <string> logo-search-error-title;
    in property <string> logo-search-error-body;
    in property <bool> logo-search-show-call: false;
    in property <bool> logo-search-show-freq: false;
    in property <string> logo-search-search-label;
    in property <bool> logo-search-can-confirm: false;
    in property <string> logo-search-confirm-label;
    /// The dark picker's rows, its ground, and the left button's label. See
    /// `logo-search.slint`.
    in property <[DarkChoice]> logo-search-dark-choices;
    in property <color> logo-search-dark-bg;
    in property <string> logo-search-cancel-label: "Cancel";
    in property <string> logo-search-hint;
    callback logo-search-toggle-call();
    callback logo-search-toggle-freq();
    callback logo-search-search();
    callback logo-search-retry();
    callback logo-search-pick(int);
    callback logo-search-confirm();

    /// Every overlay's dismissal lands here: drop the modal, then tell Rust.
    function dismiss() {
        root.overlay = Overlay.none;
        root.close-overlay();
    }

    title: "Carnyx";
    background: Pal.page;
    default-font-family: "Atkinson Hyperlegible";
    preferred-width: 1024px;
    preferred-height: 614px;

    Face {
        width: root.width;
        height: root.height;
        ident: root.ident;
        freq-label: root.freq-label;
        logo: root.logo;
        has-logo: root.has-logo;
        logo-plate: root.logo-plate;
        show-call: root.show-call;
        show-freq: root.show-freq;
        saved: root.saved;
        in-band: root.in-band;
        radio-text: root.radio-text;
        full-pairs: root.full-pairs;
        half: root.half;
        dot-opacity: root.dot-opacity;
        dotted-arcs: root.dotted-arcs;
        level-text: root.level-text;
        stereo-known: root.stereo-known;
        stereo: root.stereo;
        rds: root.rds;
        tp: root.tp;
        ta: root.ta;
        af: root.af;
        pty: root.pty;
        egg: root.egg;
        ident-a: root.ident-a;
        ident-b: root.ident-b;
        tuner-error: root.tuner-error;
        clock-time: root.clock-time;
        clock-meridiem: root.clock-meridiem;
        gps-fix: root.gps-fix;
        in-motion: root.in-motion;
        osmand-on: root.settings-nav-on;
        osmand-linked: root.nav-linked;
        nav-stage: root.nav-stage;
        nav-progress: root.nav-progress;
        nav-eta: root.nav-eta;
        nav-left-distance: root.nav-left-distance;
        nav-arrow: root.nav-arrow;
        nav-exit: root.nav-exit;
        nav-distance: root.nav-distance;
        nav-street: root.nav-street;
        nav-after-arrow: root.nav-after-arrow;
        nav-after-exit: root.nav-after-exit;
        nav-after-street: root.nav-after-street;
        presets: root.presets;
        active-index: root.active-index;
        prev-preset: root.prev-preset;
        next-preset: root.next-preset;
        ghost-preset: root.ghost-preset;
        outgoing: root.outgoing;
        hand-off: root.hand-off;
        has-prev: root.has-prev;
        has-next: root.has-next;
        audio-active: root.audio-active;
        scanning: root.scanning;
        reordering: root.reordering;
        step-nonce: root.step-nonce;
        step-dir: root.step-dir;
        toggle-save => { root.toggle-save(); }
        open-settings => { root.overlay = Overlay.settings; root.open-settings(); }
        open-nearby => { root.overlay = Overlay.nearby; root.open-nearby(); }
        open-osmand => { root.open-osmand(); }
        open-logo-search(i) => { root.overlay = Overlay.logo-search; root.open-logo-search(i); }
        claim-audio => { root.claim-audio(); }
        release-audio => { root.release-audio(); }
        select-preset(i) => { root.select-preset(i); }
        step-preset(d) => { root.step-preset(d); }
        done-reordering => { root.done-reordering(); }
        // `reordering` is set by RUST, not here, exactly as `done-reordering`
        // already is: the mode is refused outright while the car is moving, and
        // that judgement is not the view's to make.
        enter-reordering => { root.enter-reordering(); }
        reorder-preset(from, to) => { root.reorder-preset(from, to); }
        drag-note(m) => { root.drag-note(m); }
        morph-note(m) => { root.morph-note(m); }
        morph-frame() => { root.morph-frame(); }
    }

    // ── The modal layer ─────────────────────────────────────────────────────
    //
    // Declared AFTER the Face, so it draws over it, and each overlay is given
    // the whole surface: its scrim covers the face and its own TouchArea
    // swallows every tap, so nothing behind it can be reached while it is up.
    // None of the four gates its own visibility — the `if` here is the gate,
    // exactly as OverlayCard's own docs ask for.

    if root.overlay == Overlay.nearby: NearbyOverlay {
        width: root.width;
        height: root.height;
        stations: root.nearby-stations;
        state: root.nearby-state;
        snapshot: root.nearby-snapshot;
        bucket-chips: root.nearby-bucket-chips;
        bucket: root.nearby-bucket;
        genre-columns: root.nearby-genre-columns;
        genre: root.nearby-genre;
        show-bucket-bar: root.nearby-show-bucket-bar;
        show-genre-bar: root.nearby-show-genre-bar;
        tab: root.nearby-tab;
        freq-display: root.freq-display;
        freq-display-dim: root.freq-display-dim;
        freq-error: root.freq-error;
        freq-error-text: root.freq-error-text;
        set-tab(t) => { root.set-nearby-tab(t); }
        freq-key(c) => { root.freq-key(c); }
        freq-back => { root.freq-back(); }
        freq-seek(d) => { root.freq-seek(d); }
        // Both of these CLOSE the overlay, and Rust does it — the same way
        // `nearby-tune` already does, and for a reason beyond consistency: a
        // dismissal written here only runs when the tap goes through this
        // instance, so it would be missing from every path that invokes the
        // callback directly, `examples/numpadprobe.rs` included.
        freq-commit => { root.freq-commit(); }
        freq-cancel => { root.freq-cancel(); }
        tune(i) => { root.nearby-tune(i); }
        save-preset(i) => { root.nearby-save-preset(i); }
        pick-bucket(b) => { root.nearby-pick-bucket(b); }
        pick-genre(g) => { root.nearby-pick-genre(g); }
        reset-bucket => { root.nearby-reset-bucket(); }
        // The row-tap's close: a tune already commanded in Rust, nothing to
        // branch on. The ✕ and the scrim take the other road below.
        close => { root.dismiss(); }
        dismissed => { root.nearby-dismiss(); }
    }

    if root.overlay == Overlay.settings: SettingsOverlay {
        width: root.width;
        height: root.height;
        status-title: root.settings-status-title;
        status-sub: root.settings-status-sub;
        status-glyph: root.settings-status-glyph;
        status-action: root.settings-status-action;
        details-label: root.settings-details-label;
        details-open: root.settings-details-open;
        tuner-details: root.settings-tuner-details;
        sources: root.settings-sources;
        release-on-sleep: root.settings-release-on-sleep;
        clock-on: root.settings-clock-on;
        clock-sub: root.settings-clock-sub;
        nav-on: root.settings-nav-on;
        nav-sub: root.settings-nav-sub;
        nav-hide-on-map: root.settings-nav-hide-on-map;
        nav-hide-sub: root.settings-nav-hide-sub;
        theme-chips: root.settings-theme-chips;
        theme: root.settings-theme;
        battery: root.settings-battery;
        battery-sub: root.settings-battery-sub;
        logos-on: root.settings-logos-on;
        logos-sub: root.settings-logos-sub;
        clear-logos-label: root.settings-clear-logos-label;
        clearing-logos: root.settings-clearing-logos;
        diag-on: root.settings-diag-on;
        diag-lines: root.settings-diag-lines;
        diag-actions: root.settings-diag-actions;
        about: root.settings-about;
        diag-status: root.settings-diag-status;
        retry-tuner => { root.settings-retry-tuner(); }
        toggle-details => { root.settings-toggle-details(); }
        pick-source(i) => { root.settings-pick-source(i); }
        set-release-on-sleep(v) => { root.settings-set-release-on-sleep(v); }
        set-clock-on(v) => { root.settings-set-clock-on(v); }
        set-nav-on(v) => { root.settings-set-nav-on(v); }
        set-nav-hide-on-map(v) => { root.settings-set-nav-hide-on-map(v); }
        set-theme(t) => { root.settings-set-theme(t); }
        fix-battery => { root.settings-fix-battery(); }
        set-logos(v) => { root.settings-set-logos(v); }
        clear-logos => { root.settings-clear-logos(); }
        set-diag(v) => { root.settings-set-diag(v); }
        pick-diag-action(i) => { root.settings-pick-diag-action(i); }
        egg-menu: root.settings-egg-menu;
        egg-choice: root.settings-egg-choice;
        egg-taps <=> root.settings-egg-taps;
        force-egg(i) => { root.settings-force-egg(i); }
        close => { root.dismiss(); }
    }

    if root.overlay == Overlay.logo-search: LogoSearchOverlay {
        width: root.width;
        height: root.height;
        name: root.logo-search-name;
        subtitle: root.logo-search-subtitle;
        logo: root.logo-search-logo;
        has-logo: root.logo-search-has-logo;
        mono: root.logo-search-mono;
        brand: root.logo-search-brand;
        state: root.logo-search-state;
        query: root.logo-search-query;
        candidates: root.logo-search-candidates;
        selected-index: root.logo-search-selected-index;
        saving: root.logo-search-saving;
        error-title: root.logo-search-error-title;
        error-body: root.logo-search-error-body;
        show-call: root.logo-search-show-call;
        show-freq: root.logo-search-show-freq;
        search-label: root.logo-search-search-label;
        can-confirm: root.logo-search-can-confirm;
        confirm-label: root.logo-search-confirm-label;
        cancel-label: root.logo-search-cancel-label;
        dark-choices: root.logo-search-dark-choices;
        dark-bg: root.logo-search-dark-bg;
        hint: root.logo-search-hint;
        toggle-call => { root.logo-search-toggle-call(); }
        toggle-freq => { root.logo-search-toggle-freq(); }
        search => { root.logo-search-search(); }
        retry => { root.logo-search-retry(); }
        pick(i) => { root.logo-search-pick(i); }
        confirm => { root.logo-search-confirm(); }
        close => { root.dismiss(); }
    }
}
