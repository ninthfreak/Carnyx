<?xml version="1.0" encoding="utf-8"?>
<!--
  The Gradle manifest. Parity with what cargo-apk generates, PLUS the foreground
  service — which is the one thing cargo-apk cannot express and the reason for
  moving packagers at all.

  It began as a spike whose only question was whether a Gradle-packaged APK boots
  Slint's `android_main` on the head unit exactly as the cargo-apk one does. It
  does; it installed over the cargo-apk build and ran. So the service (#67) is
  now declared here for real, and THIS FILE IS NO LONGER A COPY OF THE OTHER ONE:
  an APK built by cargo-apk has no service and no `CarnyxService` class, and the
  app detects that at run time rather than assuming either build.

  The wake receiver is the second component only this packager can declare, and
  it is declared at the bottom.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET is for the logo search; without it every request fails with a
      SecurityException rather than a timeout, which reads as a transport bug.

      Both location permissions match CarFM. COARSE would do for a picker sorted
      in kilometres; FINE is what makes the in-motion glyph meaningful.

      DECLARING IS NOT GRANTING. From API 23 these are runtime permissions and a
      request needs someone to tap Allow, which on a dashboard at night is
      nobody — so the location code treats "denied" and "never answered" as
      ordinary states.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      SAVING THE DIAGNOSTICS LOG TO Downloads, and CAPPED because the cap is the
      whole reason it is safe to ask for.

      `NwdBridge.writeLog` goes through MediaStore on API 29 and up, which needs
      no permission at all. Only the pre-29 branch writes the public Downloads
      directory directly, and minSdk here is 26 — so the permission exists for
      exactly the API range that uses it and is dropped above it.
      `maxSdkVersion="32"` rather than 28 is CarFM's own value, carried across
      with the code (its AndroidManifest.xml:19).

      This is the only way anything leaves this unit: it has no adb, the log ring
      holds 200 lines, and a screenshot catches the handful on screen.
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      THE FOREGROUND SERVICE'S THREE PERMISSIONS, and they are not alike.

      FOREGROUND_SERVICE is normal and granted at install. From API 34 it is not
      enough on its own: a service that declares a `foregroundServiceType` must
      also hold the matching FOREGROUND_SERVICE_* permission, or `startForeground`
      throws — hence the second line, paired with `mediaPlayback` below.

      POST_NOTIFICATIONS is the odd one. It is a RUNTIME permission from API 33,
      and this app never asks for it: the note on location above applies word for
      word — a request "needs someone to tap Allow, which on a dashboard at night
      is nobody". Declaring it without requesting it is deliberate and is not the
      dead-permission smell the note at the bottom of this file warns about. When
      it is absent the platform suppresses the service's notification but STILL
      RUNS THE SERVICE IN THE FOREGROUND, and the foreground is the entire point;
      declaring it is what lets a driver who wants the line turn it on in
      Settings. Nothing in the app depends on their doing so.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      RECEIVE_BOOT_COMPLETED, for the receiver at the bottom of this file.

      NORMAL, granted at install, no runtime request. It gates exactly one
      action: without it `android.intent.action.BOOT_COMPLETED` is never
      delivered, silently.

      It does NOT gate `com.nwd.ACTION_OS_WAKE_UP`, which is the broadcast that
      actually fires on this unit — a vendor action guarded by no permission at
      all. So the permission covers the fallback rather than the real path, and
      is declared because the fallback is real on a unit that is ever genuinely
      power-cycled.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      PACKAGE VISIBILITY, load-bearing rather than defensive. From targetSdk 30
      a package cannot see another it has not declared, and the filtering is
      SILENT: `resolveService` returns null and `bindService` returns false on a
      unit that plainly has the vendor radio installed, so the tuner would report
      itself absent on the one device this app is for.
    -->
    <queries>
        <package android:name="com.nwd.radio.service" />
    </queries>

    <application
        android:label="Carnyx"
        android:hasCode="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <!--
          `android.app.NativeActivity` is a FRAMEWORK class, present on every
          device — there is no dependency to add for it. Slint resolves to plain
          NativeActivity, not GameActivity: slint's `backend-android-activity-06`
          feature expands to `i-slint-backend-android-activity/native-activity`
          (slint-1.17.1/Cargo.toml:64-68). cargo-apk hardcodes the same class
          (cargo-apk-0.10.0/src/apk.rs:340).

          android:exported is REQUIRED. Android 12 refuses to install a package
          whose targetSdk is 31+ if a component with an intent-filter omits it,
          and the on-device installer reports that only as "App not installed".
        -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|density|screenSize|smallestScreenSize|layoutDirection">

            <!--
              THE ONE VALUE THAT SILENTLY BREAKS EVERYTHING. NativeActivity loads
              `lib<value>.so`, so this must be the crate's lib name — `carnyx`,
              from [lib] in ../../Cargo.toml, giving `libcarnyx.so`.

              Get it wrong and the activity starts, finds no library, and you get
              a black screen. There is no adb on this unit to ask why, which is
              why tools/check-apk.sh now cross-checks this value against the .so
              files actually packaged.

              cargo-apk emits this same meta-data automatically
              (cargo-apk-0.10.0/src/apk.rs:178); under Gradle it is written by
              hand, and that is the one thing this file does that a generator did
              for us before.
            -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="carnyx" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          THE FOREGROUND SERVICE (#67), so the process is not a candidate for the
          launcher's cleaner or the low-memory killer and the face is still in RAM
          when the driver comes back.

          `exported="false"`: nothing outside this app has any business starting
          it. It is started by `CarnyxProcess` from the runtime dex, by
          ComponentName, at app start-up.

          `mediaPlayback` is the honest type. The audio bytes never pass through
          this process — they are analog and MCU-routed — but the unit is playing
          FM BECAUSE this app claimed the source, and CarFM types its own
          equivalent service the same way while carrying no audio either
          (VibeStreamService.kt:726-739). The type is also load-bearing from API
          34, which pairs it with FOREGROUND_SERVICE_MEDIA_PLAYBACK above.

          THE CLASS IS COMPILED BY AGP, from android/app/src/main/java/. It cannot
          be one of the classes in `java/`: those are dexed by build.rs and loaded
          at run time by an InMemoryDexClassLoader, and Android constructs a
          manifest-declared component through the APPLICATION's class loader,
          which has never heard of it.
        -->
        <service
            android:name=".CarnyxService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <!--
          THE WAKE RECEIVER (#67's other half), so the face comes back when the
          unit does.

          `com.nwd.ACTION_OS_WAKE_UP` is the one that matters and BOOT_COMPLETED
          is the fallback, not the other way round: CarFM's manifest records that
          THIS UNIT SLEEPS on ACC-off rather than shutting down, so BOOT_COMPLETED
          never fires on an ignition cycle
          (CarFM android/app/src/main/AndroidManifest.xml:91-94).

          `exported="true"` is REQUIRED here and is not the loose choice it looks
          like. Every action below is broadcast by something outside this app —
          the system for two of them, the MCU's service for the third — and an
          unexported receiver receives from its own package only, so the filter
          would match nothing at all. From API 31 the attribute must also be
          stated explicitly for any component with an intent-filter, and the
          installer reports its absence only as "App not installed".

          It HAS to be a manifest receiver: the process is killed while the unit
          sleeps, and only a manifest-declared receiver gets a process started to
          deliver the broadcast.

          LOCKED_BOOT_COMPLETED is deliberately absent — it reaches
          `directBootAware` components only, and nothing here is one. See
          WakeReceiver.java.
        -->
        <receiver
            android:name=".WakeReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.nwd.ACTION_OS_WAKE_UP" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
