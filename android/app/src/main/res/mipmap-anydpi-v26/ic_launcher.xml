<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon. `anydpi-v26` shadows the PNG ladder on API 26 and up, which
  since `minSdk = 26` means EVERY device this app runs on — the bitmaps stay for
  anything that reads an icon without adaptive support, and for the store.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
